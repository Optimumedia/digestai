# Copy to .env (never committed). Everything is optional; without keys the pipeline
# runs against a local SQLite file with heuristic summaries.

# Supabase > Project Settings > Database > Connection string (URI, session mode)
DATABASE_URL=

# https://aistudio.google.com/apikey  (free tier: only 20 requests/day per model for current
# Flash models; used for the most important sources, ~60 articles a day across three models)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# https://console.groq.com/keys  (free tier: 1,000 requests/day per model, three models chained,
# 8,000 tokens/minute; no card. This key gives every article a proper summary.)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

SITE_URL=https://digestai.news
MAX_ENRICH_PER_RUN=20

# Kit (formerly ConvertKit): Settings > Developer > API keys (v4). Free plan to 10,000 subscribers.
KIT_API_KEY=
NEWSLETTER_HOUR_UTC=5

# ---- Site build (PUBLIC_ values are embedded in the HTML, never put secrets here) ----
# Supabase > Project Settings > API: project URL and the anon (public) key.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Kit > Grow > Landing pages & forms > your form > Publish > the form action URL
PUBLIC_KIT_FORM_URL=
# https://giscus.app: enable Discussions on the public repo, install the giscus app, copy the IDs
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=

# Browser push alerts: run  python scripts/gen_vapid.py  once; it fills these two in.
VAPID_PRIVATE_KEY=
PUBLIC_VAPID_KEY=

# Nightly encrypted database backup (SETUP.md, "Database backup"). A long random passphrase used nowhere
# else; keep a copy in your password manager, because a backup cannot be opened without it.
BACKUP_KEY=
# Optional: healthchecks.io ping URL (SETUP.md, "Alerts when the pipeline stops"). Emails you if runs stop.
HEALTHCHECK_URL=
# Optional: "1" uses share images from the media store for stories older than a week (see SETUP.md).
PUBLIC_OG_FROM_STORE=

# Review key for stories held for approval (single-source stories about crimes, weapons, surveillance
# or wrongdoing by named people or companies). The pipeline encrypts the held list with it; you paste
# the same passphrase once on the admin page to read the list. Use a long random passphrase that is
# not used anywhere else, then run scripts\push-config.ps1. Without it stories are still held, but the
# admin page can only show how many.
# ADMIN_REVIEW_KEY=
