---
import SocialLinks from "../components/SocialLinks.astro";
import Analytics from "../components/Analytics.astro";
import "../styles/global.css";
import { categories, meta, byScore, byRecency, shortDate, dateTime } from "../lib/data";

interface Props {
  title: string;
  description?: string;
  image?: string | null;
  canonical?: string;
  type?: "website" | "article";
  publishedAt?: string | null;
  modifiedAt?: string | null;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  currentCategory?: string | null;
  storyId?: number;
  articleId?: number;
  /** Utility page (search, saved, admin): no index, no canonical, no analytics. */
  noindex?: boolean;
  /** Content page too thin to index yet (a one-story hub, a single-source brief): "noindex, follow",
      no canonical, out of the sitemaps; everything else, analytics included, as on any page. */
  thin?: boolean;
}

const {
  title,
  description = "The AI news desk: every important story in artificial intelligence, digested and linked to its sources, updated every 30 minutes.",
  image,
  canonical,
  type = "website",
  publishedAt,
  modifiedAt,
  jsonLd,
  currentCategory,
  storyId,
  articleId,
  noindex = false,
  thin = false,
} = Astro.props;
const indexable = !noindex && !thin;

const site = (Astro.site?.toString() || meta.siteUrl).replace(/\/$/, "");
// The static build serves every page as a .html file, so Astro.url carries ".html". The public
// address (sitemaps, internal links) has no extension; the canonical must match it exactly or
// search engines treat the sitemap URL as a duplicate of a different page and skip indexing it.
const cleanPath = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/").replace(/(.)\/$/, "$1");
const url = canonical || new URL(cleanPath, site).toString();
const ogImage = image || `${site}/og-default.png`;
const fullTitle = title === "Digest AI" ? "Digest AI — AI news, digested" : `${title} — Digest AI`;
// Broadcast-style ticker: the hottest stories interleaved with the newest, no repeats. Eight links,
// rendered after the main content (CSS puts it back under the masthead) so the first thing a
// crawler reads on every page is the page itself, not the same eight headlines.
const hot = byScore.slice(0, 4);
const fresh = byRecency.filter((s) => !hot.some((h) => h.id === s.id)).slice(0, 4);
const ticker: { s: (typeof byScore)[number]; tag: string }[] = [];
for (let i = 0; i < Math.max(hot.length, fresh.length); i++) {
  if (hot[i]) ticker.push({ s: hot[i], tag: "hot" });
  if (fresh[i]) ticker.push({ s: fresh[i], tag: "new" });
}
const footerColumns: { title: string; links: [string, string][] }[] = [
  { title: "Read", links: [["Today's briefing", "/today"], ["AI at Work", "/work"], ["Developing stories", "/threads"], ["River", "/river"], ["Weekly recaps", "/week"], ["Archive", "/daily"]] },
  { title: "Trackers & tools", links: [["AI tools for work", "/work/tools"], ["Model tracker", "/models"], ["Funding tracker", "/funding"], ["Sources", "/sources"], ["Search", "/search"]] },
  { title: "Listen & follow", links: [["Listen", "/listen"], ["Podcast feed", "/podcast.xml"], ["RSS feed", "/rss.xml"], ["Browser alerts", "/subscribe"]] },
  { title: "About", links: [["About Digest AI", "/about"], ["Editorial standards", "/about#standards"], ["Corrections", "/about#corrections"], ["Contact", "/contact"], ["Privacy", "/privacy"], ["Terms", "/terms"]] },
];
const footerYear = new Date(meta.generatedAt || Date.now()).getUTCFullYear();
const clientConfig = {
  supabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL || "",
  supabaseKey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY || "",
  vapidKey: import.meta.env.PUBLIC_VAPID_KEY || "",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="1HVcSBsyJYBfZLnj_r85TRK8n70zv2rexCrkXu6Bbyw" />
    {indexable && <link rel="canonical" href={url} />}
    <meta name="robots" content={noindex ? "noindex, nofollow" : thin ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <meta name="googlebot-news" content={indexable ? "index" : "noindex"} />
    <meta name="theme-color" content="#0e1116" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Digest AI" href={`${site}/rss.xml`} />
    <link rel="alternate" type="application/rss+xml" title="Digest AI: AI at Work" href={`${site}/work/rss.xml`} />
    <link rel="alternate" type="application/rss+xml" title="Digest AI briefing (podcast)" href={`${site}/podcast.xml`} />
    <link rel="alternate" type="application/rss+xml" title="Digest AI: AI at Work (podcast)" href={`${site}/work/podcast.xml`} />
    <meta property="og:site_name" content="Digest AI" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {modifiedAt && <meta property="article:modified_time" content={modifiedAt} />}
    {currentCategory && <meta property="article:section" content={categories[currentCategory] || currentCategory} />}
    {type === "article" && <meta property="article:publisher" content={site} />}
    <link rel="preload" href="/fonts/newsreader-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-sans-3-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      try {
        const t = JSON.parse(localStorage.getItem("theme"));
        if (t === "dark" || t === "light") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <script is:inline set:html={`window.DIGEST=${JSON.stringify(clientConfig)};`} />
    <script src={`/app.js?v=${meta.generatedAt.replace(/\D/g, "").slice(0, 12)}`} defer is:inline></script>
    <slot name="head" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "NewsMediaOrganization",
      "@id": `${site}/#organization`,
      name: "Digest AI",
      alternateName: "Digest AI News",
      url: site,
      logo: { "@type": "ImageObject", url: `${site}/logo-512.png`, width: 512, height: 512 },
      description: "The AI news desk: every important story in artificial intelligence, digested and linked to its sources, updated every 30 minutes.",
      foundingDate: "2026",
      publishingPrinciples: `${site}/about#standards`,
      correctionsPolicy: `${site}/about#corrections`,
      contactPoint: { "@type": "ContactPoint", contactType: "editorial", email: "hello@digestai.news", url: `${site}/contact` },
      sameAs: [
        "https://www.linkedin.com/company/digestai-news/",
        "https://bsky.app/profile/digestai.bsky.social",
        "https://x.com/DigestAINews",
      ],
    })} />
  </head>
  <body data-story-id={storyId} data-article-id={articleId}>
    <header class="masthead">
      <div class="wrap">
        <a class="brand" href="/" aria-label="Digest AI home">Digest<b>AI</b> <small>news desk</small></a>
        <nav class="nav" aria-label="Sections and categories">
          <a class="nav-work" href="/work" aria-current={Astro.url.pathname.startsWith("/work") ? "page" : undefined}>AI at Work</a>
          {Object.entries(categories).map(([key, name]) => (
            <a href={`/category/${key}`} aria-current={currentCategory === key ? "page" : undefined}>{name.split(" & ")[0]}</a>
          ))}
        </nav>
        <div class="tools">
          <a class="icon-btn listen-btn" href="/listen" aria-label="Listen to the audio briefing" title="Listen to the briefing">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15v-3a8 8 0 0 1 16 0v3" /><rect x="3" y="14" width="4.5" height="7" rx="1.5" /><rect x="16.5" y="14" width="4.5" height="7" rx="1.5" /></svg>
          </a>
          <a class="icon-btn" href="/saved" aria-label="Saved stories" title="Saved stories">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"><path d="M6 3h12v18l-6-4-6 4z" /></svg>
            <span class="count" id="saved-count" hidden></span>
          </a>
          <a class="icon-btn" href="/search" aria-label="Search" title="Search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          </a>
          <button class="icon-btn" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle theme">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z" /></svg>
          </button>
        </div>
      </div>
    </header>

    <main class="wrap" data-pagefind-body>
      <slot />
    </main>

    {ticker.length > 0 && (
      <div class="ticker" aria-label="Latest and hottest stories" data-nosnippet>
        <div class="wrap">
          <span class="live" aria-hidden="true">Live</span>
          <div class="ticker-viewport">
            <div class="ticker-track">
              {[0, 1].map((copy) => (
                <div class="ticker-run" aria-hidden={copy === 1 ? "true" : undefined}>
                  {ticker.map(({ s, tag }) => (
                    <a href={`/story/${s.slug}`} tabindex={copy === 1 ? -1 : undefined}><span class:list={["tag", tag]}>{tag}</span> {s.headline} <span class="muted"><time datetime={s.firstPublishedAt || s.updatedAt || undefined}>{shortDate(s.firstPublishedAt || s.updatedAt)}</time></span></a>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    )}

    <footer class="footer">
      <div class="wrap footer-main">
        <div class="footer-brand">
          <a class="footer-logo" href="/" aria-label="Digest AI home">
            <span class="footer-mark" aria-hidden="true">D</span>
            <span class="footer-word">Digest<b>AI</b></span>
          </a>
          <p class="footer-tagline">AI news, digested. Every story with its sources, every 30 minutes.</p>
          <p class="footer-follow" id="footer-follow">Follow &amp; subscribe</p>
          <nav aria-labelledby="footer-follow"><SocialLinks variant="footer" /></nav>
        </div>
        <nav class="footer-cols" aria-label="Site">
          {footerColumns.map((col) => (
            <div class="footer-col">
              <h2>{col.title}</h2>
              <ul role="list">
                {col.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
              </ul>
            </div>
          ))}
        </nav>
      </div>
      <div class="footer-bar">
        <div class="wrap">
          <p class="gen"><span class="gen-dot" aria-hidden="true"></span>Updated <time datetime={meta.generatedAt}>{dateTime(meta.generatedAt)}</time> · {meta.storyCount} stories from {meta.articleCount} articles</p>
          <p class="footer-copy">© {footerYear} Digest AI · Built from public sources, linked in every story{!noindex && <> · <button type="button" class="footer-link-btn" data-consent-open>Cookie settings</button></>}</p>
        </div>
      </div>
    </footer>
    {!noindex && <Analytics />}
  </body>
</html>
