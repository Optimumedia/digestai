---
import Base from "../layouts/Base.astro";
import Rail from "../components/Rail.astro";
import ThreadRow from "../components/ThreadRow.astro";
import Pager from "../components/Pager.astro";
import { threads } from "../lib/data";
import { pageSlice } from "../lib/paging";

// Most recently updated first. With a few hundred threads the page passed 500 KB, so it shows the 60
// most recent and the rest are on numbered pages (threads/[page].astro), noindex and out of the sitemap.
const shown = pageSlice(threads, 1);
---

<Base title="Developing stories" description="The AI sagas still unfolding: every thread with its episodes in order.">
  <div class="grid">
    <div>
      <header class="page-head">
        <div class="eyebrow">Threads</div>
        <h1>Developing stories</h1>
        <p>
          Stories that keep producing news. Each thread is the episodes in order, so you can catch up from the start.
          {shown.pages > 1 && ` ${threads.length} threads, most recently updated first; this page shows ${shown.items.length}.`}
        </p>
      </header>
      {threads.length === 0 && <p class="muted" style="padding: 24px 0">No multi-episode stories yet. Threads form as coverage accumulates over days.</p>}
      <ol class="river">{shown.items.map((t) => <ThreadRow thread={t} />)}</ol>
      <Pager base="/threads" page={1} pages={shown.pages} label="More threads" back="← More recent" on="Earlier threads →" />
    </div>
    <Rail />
  </div>
</Base>
