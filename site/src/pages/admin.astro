          pace.innerHTML = `<strong>${num(remaining)} to go in ${left} day${left > 1 ? "s" : ""}</strong> (until ${fmtDay(end)}): about <strong>${num(need)} a day</strong> from now on. So far about ${perDay(avg)} a day.`;
          mark.hidden = false;
          mark.style.left = `${Math.min(100, ((elapsed - 1) / d.goalDays) * 100)}%`;
          mark.title = `Where the count should be at the start of today: ${num(Math.round((d.goal * (elapsed - 1)) / d.goalDays))}`;
        }
        renderSince(now, history.reduce((n, r) => n + (Number(r.visitors) || 0), 0));
      }

      // Since your last visit. A visit ends after 30 minutes away, so reloading keeps the comparison.
      let since = null;
      function renderSince(now, visitors) {
        const el = root.querySelector("[data-since]");
        if (!since) {
          const KEY = "admin_last_visit";
          let store = {};
          try { store = JSON.parse(localStorage.getItem(KEY) || "{}") || {}; } catch {}
          const snap = { seen: new Date(now).toISOString(), visitors, cards: d.cards.map((c) => c.id) };
          const cur = store.cur && Date.parse(store.cur.seen) ? store.cur : null;
          const prev = cur && now - Date.parse(cur.seen) > 30 * MIN ? cur : store.prev || null;
          since = { prev };
          try { localStorage.setItem(KEY, JSON.stringify({ prev, cur: snap })); } catch {}
