---
import Base from "../layouts/Base.astro";
import { columns, lines, bars, stackedBars, sinceFirst, dayLabel } from "../lib/charts";
import { meta, categories, formatDate } from "../lib/data";
import fs from "node:fs";
import path from "node:path";

let admin: any = null;
try { admin = JSON.parse(fs.readFileSync(path.resolve(process.cwd(), "src/data/admin.json"), "utf-8")); } catch {}
let gsc: any = null;
try { gsc = JSON.parse(fs.readFileSync(path.resolve(process.cwd(), "src/data/gsc.json"), "utf-8")); } catch {}

const repo = import.meta.env.PUBLIC_GISCUS_REPO || "Optimumedia/digestai";
const C = { s1: "var(--series-1)", s2: "var(--series-2)", s3: "var(--series-3)", s4: "var(--series-4)", neutral: "var(--series-neutral)", good: "var(--status-good)", crit: "var(--status-critical)" };

// ---- runs: group step rows into pipeline runs
type Step = { step: string; startedAt: string; finishedAt: string | null; stats: any };
const steps: Step[] = (admin?.runs || []).slice().sort((a: Step, b: Step) => Date.parse(a.startedAt) - Date.parse(b.startedAt));
const runs: { startedAt: string; finishedAt: string | null; steps: Step[]; ok: boolean; seconds: number }[] = [];
for (const s of steps) {
  const last = runs[runs.length - 1];
  if (last && Date.parse(s.startedAt) - Date.parse(last.startedAt) < 29 * 60 * 1000 && s.step !== "fetch") { last.steps.push(s); last.finishedAt = s.finishedAt || last.finishedAt; }
  else runs.push({ startedAt: s.startedAt, finishedAt: s.finishedAt, steps: [s], ok: true, seconds: 0 });
}
for (const r of runs) { r.ok = r.steps.every((s) => !s.stats?.crashed); r.seconds = r.steps.reduce((n, s) => n + (Number(s.stats?.seconds) || 0), 0); }
runs.reverse();
const lastRun = runs[0];
const stat = (r: typeof lastRun | undefined, step: string) => r?.steps.find((s) => s.step === step)?.stats || {};
const nextRunMin = lastRun ? Math.max(0, 30 - Math.round((Date.now() - Date.parse(lastRun.startedAt)) / 60000)) : null;

// ---- derived numbers with deltas
const days: string[] = admin?.days || [];
const today = days[days.length - 1], yesterday = days[days.length - 2];
const funnel: any[] = admin?.funnel || [];
const byDay = (arr: any[], key: string) => Object.fromEntries(arr.map((r: any) => [r.day, r[key]]));
const storiesPerDay = byDay(admin?.content?.storiesPerDay || [], "stories");
const publishedPerDay = byDay(funnel, "published");
const sum = (arr: any[], key: string, from: number, to: number) => arr.slice(from, to).reduce((n, r) => n + (Number(r[key]) || 0), 0);
const week = (arr: any[], key: string) => sum(arr, key, -7, undefined as any);
const prevWeek = (arr: any[], key: string) => sum(arr, key, -14, -7);
const pct = (now: number, before: number) => (before > 0 ? Math.round(((now - before) / before) * 100) : null);
const delta = (now: number, before: number) => { const p = pct(now, before); return p == null ? "" : `${p >= 0 ? "+" : ""}${p}% vs prev. 7d`; };

const eng = admin?.engagement || { available: false, perDay: [], topStories: [] };
const views7 = week(eng.perDay, "views"), viewsPrev = prevWeek(eng.perDay, "views");
const sessions7 = week(eng.perDay, "sessions");
const clicks7 = week(eng.perDay, "clicks"), saves7 = week(eng.perDay, "saves"), follows7 = week(eng.perDay, "follows"), shares7 = week(eng.perDay, "shares");
const dwell7 = week(eng.perDay, "dwellSeconds");
const reads7 = week(eng.perDay, "dwellReads");
// Average over reading sessions that reported time, so a lost signal does not drag it to zero.
const avgDwell = reads7 ? Math.round(dwell7 / reads7) : null;
const engagedActions7 = clicks7 + saves7 + follows7 + shares7;

const usageToday = (admin?.llm?.usage || []).filter((u: any) => u.day === today);
const budgets = admin?.llm?.budgets || {};
const llmDays = days.map((d) => { const row: any = { day: d, gemini: 0, groq: 0 }; for (const u of (admin?.llm?.usage || []).filter((u: any) => u.day === d)) row[u.provider] = u.requests; return row; });

const sources = (admin?.sources || []).slice().sort((a: any, b: any) => b.published - a.published || b.articles - a.articles);
const twoHours = Date.now() - 2 * 3600 * 1000;
const curatedSources = sources.filter((s: any) => s.enabled && !s.discovered);
const healthy = curatedSources.filter((s: any) => s.errorCount === 0 && Date.parse(s.lastFetchedAt || "0") > twoHours).length;
const failing = sources.filter((s: any) => s.enabled && s.errorCount > 0);
const alerts: { level: string; text: string }[] = admin?.alerts || [];
const critical = alerts.filter((a) => a.level === "critical");
const perf: any[] = admin?.performance || [];
const fresh = admin?.freshness || { perDay: [], perSource: {} };
const freshRows = fresh.perDay.map((d: any) => ({ day: d.day, minutes: d.medianMinutes ?? 0 }));
const freshToday = fresh.perDay[fresh.perDay.length - 1]?.medianMinutes ?? null;
const extraction: any[] = admin?.extraction || [];
const exSeries = [{ key: "full", label: "Full text", color: C.s1 }, { key: "short", label: "Short text", color: C.s4 }, { key: "description", label: "Summary only", color: C.neutral }, { key: "failed", label: "Failed", color: C.s2 }];
const modelSeries = [{ key: "gemini", label: "Gemini", color: C.s1 }, { key: "groq", label: "Groq", color: C.s2 }, { key: "ollama", label: "Local model", color: C.s3 }, { key: "heuristic", label: "Heuristic", color: C.neutral }];
const funnelSeries = [{ key: "published", label: "Published", color: C.s1 }, { key: "rejectedGate", label: "Rejected at gate", color: C.neutral }, { key: "rejectedExtract", label: "Extraction failed", color: C.s2 }, { key: "rejectedLlm", label: "Rejected by model", color: C.s3 }, { key: "pending", label: "Waiting for a summary", color: C.s4 }];
const runRows = runs.slice(0, 48).reverse().map((r) => ({ t: r.startedAt, ok: r.ok ? Math.round(r.seconds) : 0, bad: r.ok ? 0 : Math.round(r.seconds) }));
const catRows = (admin?.content?.categories || []).map((c: any) => ({ label: c.name, value: c.stories }));
const srcRows = sources.filter((s: any) => s.published > 0).slice(0, 12).map((s: any) => ({ label: s.name, value: s.published, title: `${s.name}: ${s.published} published of ${s.articles} fetched, ${s.discussed} discussed on the web` }));
const mins = (m: number | null | undefined) => m == null ? "—" : m >= 120 ? `${(m / 60).toFixed(1)} h` : `${m} min`;
const rel = (iso: string | null | undefined) => iso ? `${Math.round((Date.now() - Date.parse(iso)) / 60000)} min ago` : "never";
const topNow = perf.slice().sort((a, b) => b.score - a.score).slice(0, 6);
const topReaders = perf.slice().sort((a, b) => (b.views || 0) - (a.views || 0)).slice(0, 6);
const statusText = critical.length ? `${critical.length} critical alert${critical.length > 1 ? "s" : ""}` : lastRun && !lastRun.ok ? "last run failed" : "all systems normal";
const statusKind = critical.length || (lastRun && !lastRun.ok) ? "bad" : alerts.length ? "warn" : "good";
// ---- Compare: the full daily history goes to the page; periods are computed in the browser.
const history: any[] = admin?.history || [];
const compareData = JSON.stringify({ generatedAt: admin?.generatedAt || null, history }).replace(/</g, "\\u003c");
const periods = [["day", "Day"], ["week", "Week"], ["month", "Month"], ["year", "Year"], ["custom", "Custom"]];

// ---- Home header and action list. Times and counts that age are computed in the browser.
let held: any = null;
try { held = JSON.parse(fs.readFileSync(path.resolve(process.cwd(), "src/data/held.json"), "utf-8")); } catch {}
type CardAction = { kind: string; label: string; url?: string; slug?: string; source?: string; name?: string };
type Card = { id: string; level: string; what: string; why?: string; todo?: string; at?: string; detail?: string; action?: CardAction; items?: any[]; more?: number };
const actionCards: Card[] = (admin?.actions || alerts.map((a, i) => ({ id: `alert:${i}`, level: a.level, what: a.text }))).slice();
const heldCount = Number(held?.count) || 0;
if (heldCount > 0) {
  actionCards.unshift({
    id: "held", level: "warning",
    what: heldCount === 1 ? "1 story is waiting for your review." : `${heldCount} stories are waiting for your review.`,
    why: "The pipeline held them back because they make claims that could be risky to publish unchecked. Readers do not see them until you decide.",
    todo: "Open the list, read each story and choose to publish it or keep it hidden.",
    action: { kind: "link", url: "#held", label: "Review held stories" },
  });
}
const LEVEL: Record<string, string> = { critical: "Needs you now", warning: "Worth a look", info: "For your information" };
const whatParts = (c: Card) => c.what.split("{at}");
const actionsUrl = `https://github.com/${repo}/actions/workflows/pipeline.yml`;
const qualityRun = admin?.quality;
const genMs = Date.parse(admin?.generatedAt || "") || 0;
const homeData = JSON.stringify({
  generatedAt: admin?.generatedAt || null,
  launch: "2026-09-11", goal: 1000, goalDays: 30,
  runs: runs.filter((r) => genMs - Date.parse(r.startedAt) <= 48 * 3600 * 1000).map((r) => ({ startedAt: r.startedAt, ok: r.ok })),
  storyTimes: admin?.storyTimes || [],
  cards: actionCards.map((c) => ({ id: c.id, level: c.level })),
}).replace(/</g, "\\u003c");
---

<Base title="Digest AI Admin" description="Pipeline health, readers, content, sources and model usage." noindex={true}>
  <div class="admin" data-pagefind-ignore>
    <header class="admin-head">
      <div>
        <div class="eyebrow">Admin · data from <time datetime={admin?.generatedAt} data-static data-ago>{admin?.generatedAt ? `${admin.generatedAt.slice(0, 16).replace("T", " ")} UTC` : "never"}</time></div>
        <h1>Newsroom</h1>
      </div>
      <div class="statusline" id="head-status"><span class:list={["st", statusKind]}>●</span> <span data-head-text>{statusText}</span></div>
      <div class="admin-actions">
        <button class="tb primary" id="run-now">Run pipeline now</button>
        <a class="tb" href={`https://github.com/${repo}/actions`} target="_blank" rel="noopener">Actions log ↗</a>
      </div>
    </header>

    <nav class="tabs" aria-label="Dashboard sections">
      <a href="#today" data-tab="today">Today</a>
      <a href="#readers" data-tab="readers">Readers</a>
      <a href="#content" data-tab="content">Content</a>
      <a href="#sources" data-tab="sources">Sources</a>
      <a href="#pipeline" data-tab="pipeline">Pipeline</a>
      <a href="#seo" data-tab="seo">Search</a>
      <a href="#settings" data-tab="settings">Settings</a>
    </nav>

    {!admin && <p class="muted">No admin data yet. The pipeline writes it on its next run.</p>}

    {admin && (
      <>
        <!-- ============ TODAY: the 30-second read ============ -->
        <section class="tab" data-tab="today">
          <section class="home" id="home" data-kind={statusKind} aria-labelledby="home-sentence">
            <div class="home-status">
              <span class="home-dot" aria-hidden="true"></span>
              <p class="home-sentence" id="home-sentence" data-home-sentence aria-live="polite">{critical.length ? `${critical.length} thing${critical.length > 1 ? "s need" : " needs"} your attention now (below).` : actionCards.some((c) => c.level === "warning") ? "The site is running. A few things below are worth a look." : "Everything is fine."}</p>
            </div>
            <p class="home-clock" data-home-clock>Data from {admin.generatedAt?.slice(0, 16).replace("T", " ")} UTC</p>
            <div class="home-stale" data-home-stale hidden>
              <button type="button" class="tb primary" data-run>Run pipeline now</button>
              <a class="tb" href={`${actionsUrl}`} target="_blank" rel="noopener">Actions log ↗</a>
            </div>
            <div class="home-grid">
              <div class="home-goal">
                <div class="eyebrow">Visitors in the first 30 days</div>
                <div class="home-goal-num"><span class="value" data-goal-count>–</span><span class="muted">of 1,000</span></div>
                <div class="goal-bar" aria-hidden="true"><i data-goal-bar></i><b data-goal-mark hidden></b></div>
                <p class="home-p" data-goal-pace></p>
                <p class="home-note">A visitor is one visit on one day: someone who comes back tomorrow counts again.</p>
              </div>
              <div class="home-since">
                <div class="eyebrow">Since your last visit</div>
                <p class="home-p" data-since>Shown once the page has loaded.</p>
              </div>
            </div>
            <script is:inline type="application/json" id="home-data" set:html={homeData}></script>
          </section>

          <section class="action-list" aria-labelledby="actions-title">
            <h2 id="actions-title" class="ac-title">What needs you <span class="muted">{actionCards.length ? `${actionCards.length} item${actionCards.length > 1 ? "s" : ""}, most urgent first` : ""}</span></h2>
            {actionCards.length === 0 ? (
              <p class="ac-empty"><span class="st good">●</span> Nothing needs your attention.</p>
            ) : (
              <ul class="ac-list">
                {actionCards.map((c) => (
                  <li class:list={["ac", c.level]} data-card={c.id}>
                    <span class="ac-badge"><i aria-hidden="true"></i>{LEVEL[c.level] || c.level}</span>
                    <p class="ac-what">{whatParts(c).map((part, i) => (i && c.at ? <><time datetime={c.at} data-static data-clock>{c.at.slice(11, 16)} UTC</time>{part}</> : i ? <>an earlier time{part}</> : part))}</p>
                    {c.why && <p class="ac-why"><b>Why it matters:</b> {c.why}</p>}
                    {c.todo && <p class="ac-todo"><b>What to do:</b> {c.todo}</p>}
                    {c.detail && <p class="ac-detail">{c.detail}</p>}
                    {c.items && c.items.length > 0 && (
                      <ul class="ac-items">
                        {c.items.map((it: any) => (
                          <li>
                            <span class="ac-item-text">{it.slug ? <a href={`/story/${it.slug}`}>{it.headline}</a> : <b>{it.headline}</b>}<span class="muted">{it.detail}</span></span>
                            {it.action?.kind === "unpublish" && <button type="button" class="tb danger" data-mod="unpublish" data-slug={it.action.slug}>Unpublish</button>}
                          </li>
                        ))}
                        {(c.more || 0) > 0 && <li class="muted">and {c.more} more</li>}
                      </ul>
                    )}
                    {c.action && (
                      <div class="ac-actions">
                        {c.action.kind === "link" && <a class="tb primary" href={c.action.url} target={c.action.url?.startsWith("http") ? "_blank" : undefined} rel="noopener">{c.action.label}{c.action.url?.startsWith("http") ? " ↗" : ""}</a>}
                        {c.action.kind === "run" && <button type="button" class="tb primary" data-run>{c.action.label}</button>}
                        {c.action.kind === "pause" && <button type="button" class="tb danger" data-pause={c.action.source} data-name={c.action.name}>{c.action.label}</button>}
                        {c.action.kind === "unpublish" && <button type="button" class="tb danger" data-mod="unpublish" data-slug={c.action.slug}>{c.action.label}</button>}
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            )}
            {qualityRun?.checked && <p class="ac-foot">Content checks ran at <time datetime={qualityRun.checkedAt} data-static data-clock>{String(qualityRun.checkedAt).slice(11, 16)} UTC</time>: {qualityRun.checked.stories} stories, {qualityRun.checked.images} pictures and {qualityRun.checked.links} links checked. They run with every pipeline run, every 30 minutes.</p>}
          </section>

          <article class="card live" id="live-now" aria-live="polite">
            <div class="live-head"><span class="live-dot" aria-hidden="true"></span><span class="eyebrow" data-live-status>Connecting…</span></div>
            <div class="live-body">
              <div class="live-count"><span class="value" data-live-count>–</span><span class="muted" data-live-label>people on the site right now</span></div>
              <div class="live-cols">
                <div><div class="eyebrow">Reading now</div><ol class="ranked" data-live-pages><li class="muted">Waiting for the first reader…</li></ol></div>
                <div><div class="eyebrow">Came from</div><p data-live-sources>—</p><div class="eyebrow">Devices</div><p data-live-devices>—</p></div>
              </div>
            </div>
          </article>
          <section class="card compare" id="compare" aria-labelledby="compare-title">
            <div class="compare-head">
              <h2 id="compare-title">Compare <span class="muted">period vs period · complete UTC days</span></h2>
              <div class="seg" role="radiogroup" aria-label="Comparison period">
                {periods.map(([v, l]) => <label class="seg-opt"><input type="radio" name="compare-period" value={v} checked={v === "week"} /><span>{l}</span></label>)}
              </div>
            </div>
            <div class="compare-custom" data-cmp-custom hidden>
              <fieldset>
                <legend>Period A</legend>
                <label>From <input type="date" data-cmp-date="a0" /></label>
                <label>to <input type="date" data-cmp-date="a1" /></label>
              </fieldset>
              <fieldset>
                <legend>Compared with period B</legend>
                <label>From <input type="date" data-cmp-date="b0" /></label>
                <label>to <input type="date" data-cmp-date="b1" /></label>
              </fieldset>
              <button type="button" class="tb" data-cmp-before>Set B to the days just before A</button>
            </div>
            <p class="compare-range" data-cmp-range aria-live="polite"></p>
            <div data-cmp-body><p class="muted">{history.length ? "Loading the comparison…" : "History starts with the next pipeline run."}</p></div>
            <script is:inline type="application/json" id="compare-data" set:html={compareData}></script>
          </section>
          <div class="tiles">
            <div class="tile"><span class="label">Stories published today</span><span class="value">{storiesPerDay[today] ?? 0}</span><span class="sub">yesterday {storiesPerDay[yesterday] ?? 0}</span></div>
            <div class:list={["tile", { off: !eng.available }]}><span class="label">Views, 7 days</span><span class="value">{eng.available ? views7 : "—"}</span><span class="sub">{eng.available ? (viewsPrev ? delta(views7, viewsPrev) : `${sessions7} sessions`) : "no reader data yet"}</span></div>
            <div class:list={["tile", { off: !eng.available }]}><span class="label">Time on story</span><span class="value">{avgDwell != null ? `${avgDwell}s` : "—"}</span><span class="sub">average per reading session, 7 days</span></div>
            <div class:list={["tile", { warn: failing.length > 0 }]}><span class="label">Sources fetching</span><span class="value">{healthy}/{curatedSources.length}</span><span class="sub">{failing.length ? `${failing.length} failing` : "all fetching"}</span></div>
            <div class:list={["tile", { bad: lastRun && !lastRun.ok }]}><span class="label">Last run</span><span class="value">{lastRun ? (lastRun.ok ? "OK" : "Failed") : "—"}</span><span class="sub">{lastRun ? <><time datetime={lastRun.startedAt} data-static data-ago>{rel(lastRun.startedAt)}</time> · {Math.round(lastRun.seconds / 60)} min</> : ""}</span></div>
          </div>
          <div class="cards">
            <article class="card">
              <h2>On the front page now <span class="muted">feed score</span></h2>
              <ol class="ranked">{topNow.map((s: any) => <li><a href={`/story/${s.slug}`}>{s.headline}</a><span class="mono muted">{(categories[s.category] || "").split(" & ")[0]} · {s.sources} src{s.hnPoints ? ` · HN ${s.hnPoints}` : ""}</span></li>)}</ol>
            </article>
            <article class="card">
              <h2>What readers opened <span class="muted">7 days</span></h2>
              {eng.available ? (
                <ol class="ranked">{topReaders.map((s: any) => <li><a href={`/story/${s.slug}`}>{s.headline}</a><span class="mono muted">{s.views} views{s.dwellAvg != null ? ` · ${s.dwellAvg}s` : ""}{s.clicks ? ` · ${s.clicks} clicks` : ""}</span></li>)}</ol>
              ) : <p class="muted">Appears once reader events arrive.</p>}
            </article>
            <article class="card wide">
              <h2>Published per day <span class="muted">14 days</span></h2>
              <Fragment set:html={columns(funnel, "day", [{ key: "published", label: "Published", color: C.s1 }])} />
            </article>
          </div>
        </section>

        <!-- ============ READERS ============ -->
        <section class="tab" data-tab="readers" hidden>
          {!eng.available && <div class="alerts"><div class="alert warning"><span class="st warn">●</span> No reader events yet. They appear as soon as people open story pages.</div></div>}
          <div class="tiles">
            <div class="tile"><span class="label">Views, 7 days</span><span class="value">{views7}</span><span class="sub">{delta(views7, viewsPrev) || "first week"}</span></div>
            <div class="tile"><span class="label">Sessions, 7 days</span><span class="value">{sessions7}</span><span class="sub">{sessions7 ? `${(views7 / sessions7).toFixed(1)} views per session` : ""}</span></div>
            <div class="tile"><span class="label">Time on story</span><span class="value">{avgDwell != null ? `${avgDwell}s` : "—"}</span><span class="sub">average per reading session</span></div>
            <div class="tile"><span class="label">Actions, 7 days</span><span class="value">{engagedActions7}</span><span class="sub">{clicks7} to source · {saves7} saved · {follows7} follows · {shares7} shares</span></div>
          </div>
          <div class="cards">
            <article class="card wide">
              <h2>Views, sessions and clicks to source <span class="muted">per day, since the first reader · hover a day for exact numbers</span></h2>
              <div class="legend"><span><i style={`background:${C.s1}`}></i>Views</span><span><i style={`background:${C.s2}`}></i>Sessions</span><span><i style={`background:${C.s3}`}></i>Clicks to source</span></div>
              <Fragment set:html={columns(sinceFirst(eng.perDay, ["views", "sessions", "clicks"]), "day", [{ key: "views", label: "Views", color: C.s1 }, { key: "sessions", label: "Sessions", color: C.s2 }, { key: "clicks", label: "Clicks to source", color: C.s3 }], { grouped: true, w: 1100, h: 240, xFormat: dayLabel() })} />
            </article>
          </div>
          <section class="card">
            <h2>Story performance <span class="muted">7 days · what the model predicted vs what happened · click a header to sort</span></h2>
            <div class="tablewrap">
              <table class="tracker sortable" id="stories-table">
                <thead><tr><th data-sort="headline">Story</th><th data-sort="category">Category</th><th data-sort="predicted" class="num">Predicted</th><th data-sort="views" class="num">Views</th><th data-sort="dwellavg" class="num">Time</th><th data-sort="clicks" class="num">Clicks</th><th data-sort="hnpoints" class="num">HN</th><th data-sort="sources" class="num">Src</th><th data-sort="score" class="num">Score</th><th>Actions</th></tr></thead>
                <tbody>
                  {perf.map((s: any) => (
                    <tr data-slug={s.slug} data-score={s.score} data-headline={s.headline} data-category={s.category} data-predicted={s.predicted} data-views={s.views} data-dwellavg={s.dwellAvg ?? ""} data-clicks={s.clicks} data-hnpoints={s.hnPoints} data-sources={s.sources}>
                      <td><a href={`/story/${s.slug}`}>{s.headline}</a>{s.pinned && <span class="cov-tag"> pinned</span>}</td>
                      <td>{(categories[s.category] || s.category || "").split(" & ")[0]}</td>
                      <td class="num"><span class="mini"><i style={`width:${Math.round(s.predicted * 100)}%`}></i></span>{s.predicted.toFixed(2)}</td>
                      <td class="num">{eng.available ? s.views : "—"}</td>
                      <td class="num">{eng.available && s.dwellAvg != null ? `${s.dwellAvg}s` : "—"}</td>
                      <td class="num">{eng.available ? s.clicks : "—"}</td>
                      <td class="num">{s.hnPoints || ""}</td>
                      <td class="num">{s.sources}</td>
                      <td class="num">{s.score.toFixed(2)}</td>
