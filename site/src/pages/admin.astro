  <script is:inline>
    // Live now: listens to the anonymous presence channel the site's pages join (public/app.js).
    (() => {
      const box = document.getElementById("live-now");
      if (!box) return;
      const cfg = window.DIGEST || {};
      const status = box.querySelector("[data-live-status]");
      if (!cfg.supabaseUrl || !cfg.supabaseKey || !("WebSocket" in window)) { status.textContent = "Live tracking needs the Supabase settings"; return; }
      const topic = "realtime:live";
      const state = new Map();
      const esc = (v) => String(v ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
      const tally = (items, fn) => {
        const m = new Map();
        for (const x of items) { const k = fn(x); m.set(k, (m.get(k) || 0) + 1); }
        return [...m.entries()].sort((a, b) => b[1] - a[1]);
      };
      const render = () => {
        const metas = [...state.values()].flat();
        const n = metas.length;
        box.querySelector("[data-live-count]").textContent = String(n);
        box.querySelector("[data-live-label]").textContent = n === 1 ? "person on the site right now" : "people on the site right now";
        const pages = tally(metas, (x) => JSON.stringify([x.path || "/", x.title || x.path || "/"]));
        box.querySelector("[data-live-pages]").innerHTML = pages.length
          ? pages.slice(0, 8).map(([k, c]) => { const [path, title] = JSON.parse(k); return `<li><a href="${esc(path)}">${esc(title)}</a><span class="mono muted">${c} reading</span></li>`; }).join("")
          : '<li class="muted">Nobody on the site right now.</li>';
        const sources = tally(metas, (x) => x.src || "direct");
        box.querySelector("[data-live-sources]").textContent = sources.length ? sources.map(([name, c]) => `${name} ${c}`).join(" · ") : "—";
        const phones = metas.filter((x) => x.mobile).length;
        box.querySelector("[data-live-devices]").textContent = n ? `${phones} on phones · ${n - phones} on larger screens` : "—";
      };
      let ws = null, hb = null, ref = 0, retry = 0;
      const send = (t, event, payload) => { if (ws && ws.readyState === 1) ws.send(JSON.stringify({ topic: t, event, payload, ref: String(++ref) })); };
      const connect = () => {
        ws = new WebSocket(`${cfg.supabaseUrl.replace(/^http/, "ws")}/realtime/v1/websocket?apikey=${encodeURIComponent(cfg.supabaseKey)}&vsn=1.0.0`);
        ws.onopen = () => {
          retry = 0;
          send(topic, "phx_join", { config: { broadcast: { self: false }, presence: { key: "admin-" + Math.random().toString(36).slice(2, 8) }, postgres_changes: [] }, access_token: cfg.supabaseKey });
          hb = setInterval(() => send("phoenix", "heartbeat", {}), 25000);
          status.textContent = "Live · updates as people arrive and leave";
          box.classList.add("is-live");
          render();
        };
        ws.onmessage = (e) => {
          let m;
          try { m = JSON.parse(e.data); } catch { return; }
          if (m.topic !== topic) return;
          if (m.event === "presence_state") {
            state.clear();
            for (const [k, v] of Object.entries(m.payload || {})) state.set(k, v.metas || []);
            render();
          } else if (m.event === "presence_diff") {
            for (const [k, v] of Object.entries((m.payload || {}).joins || {})) state.set(k, v.metas || []);
            for (const k of Object.keys((m.payload || {}).leaves || {})) state.delete(k);
            render();
          }
        };
        ws.onclose = () => {
          clearInterval(hb);
          box.classList.remove("is-live");
          if (retry++ < 20) { status.textContent = "Reconnecting…"; setTimeout(connect, Math.min(30000, 2000 * retry)); }
          else status.textContent = "Disconnected · reload to retry";
        };
      };
      connect();
    })();
  </script>
  <script is:inline>
    // Compare: period vs period from the daily history in admin.json. Rolling windows of complete
    // UTC days ending the day before the data was generated; Custom takes any two ranges.
    (() => {
      const DAY = 864e5;
      const MON = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
      const ISO = /^\d{4}-\d{2}-\d{2}$/;
      // Minimum previous-period volume for a percentage. Below it a percentage misleads (1 to 2
      // views reads "+100%"), so the tile shows the absolute change in a neutral colour instead.
      // count: the previous period's total; readings: reading sessions behind time on story.
      const MIN_BASE = { count: 20, readings: 5 };
      const add = (d, n) => new Date(Date.parse(d + "T00:00:00Z") + n * DAY).toISOString().slice(0, 10);
      const span = (from, to) => Math.round((Date.parse(to + "T00:00:00Z") - Date.parse(from + "T00:00:00Z")) / DAY) + 1;
      // dir: 1 = up is good, -1 = lower is better, 0 = neither.
      const GROUPS = [
        ["Readers", [
          { key: "visitors", label: "Visitors", note: "one per browser per day" },
          { key: "views", label: "Page views" },
          { key: "dwell", num: "dwellSeconds", den: "dwellReads", label: "Time on story", unit: "time", note: "average per reading session" },
          { key: "clicks", label: "Clicks to source" },
          { key: "saves", label: "Saves" },
          { key: "follows", label: "Follows" },
          { key: "shares", label: "Shares" },
          { key: "listens", label: "Listens" },
          { key: "alertSignups", label: "Alert sign-ups", note: "browser push" },
          { key: "searches", label: "Site searches", dir: 0, note: "on the search and not-found pages" },
        ]],
        ["Google Search", [
          { key: "googleClicks", label: "Google clicks", lag: true },
          { key: "googleImpressions", label: "Google impressions", lag: true },
          // Weighted by impressions: sum(position x impressions) / sum(impressions) over the period.
          { key: "googlePosition", num: "googlePositionSum", den: "googleImpressions", label: "Average position", unit: "position", dir: -1, lag: true, abs: true, minBase: 50,
            few: "too few impressions to judge", note: "on Google; 1 is the top result, lower is better" },
          { key: "googleCtr", num: "googleClicks", den: "googleImpressions", label: "Google click-through", unit: "pct", lag: true, abs: true, minBase: 100,
            few: "too few impressions to judge", note: "share of impressions that became a click" },
        ]],
        ["Output", [
          { key: "storiesPublished", label: "Stories published" },
          { key: "articlesPublished", label: "Articles published" },
          { key: "articlesFetched", label: "Articles fetched", dir: 0, note: "volume, neither good nor bad" },
          { key: "socialPosts", label: "Social posts", note: "Bluesky" },
          { key: "crashedSteps", label: "Crashed pipeline steps", dir: -1, note: "lower is better" },
        ]],
      ];
      const METRICS = GROUPS.flatMap(([group, ms]) => ms.map((m) => ({ ...m, group })));

      const fmtDay = (d, year = true) => { const [y, m, dd] = d.split("-").map(Number); return `${MON[m - 1]} ${dd}${year ? `, ${y}` : ""}`; };
      const fmtRange = ([f, t]) => (f === t ? fmtDay(f) : `${fmtDay(f, f.slice(0, 4) !== t.slice(0, 4))} – ${fmtDay(t)}`);
      const fmtTime = (s) => { s = Math.round(s); return s < 60 ? `${s}s` : `${Math.floor(s / 60)}m ${String(s % 60).padStart(2, "0")}s`; };
      const fmtNum = (v, m, perDay) => (v == null ? "—" : m.unit === "time" ? fmtTime(v)
        : m.unit === "position" ? v.toFixed(1) : m.unit === "pct" ? `${(v * 100).toFixed(1)}%`
        : v.toLocaleString("en-US", { maximumFractionDigits: perDay ? 1 : 0 }));
      /** Size of a change, without sign: positions to one decimal, rates in percentage points. */
      const fmtDiff = (d, m, perDay) => (m.unit === "time" ? fmtTime(d) : m.unit === "position" ? d.toFixed(1)
        : m.unit === "pct" ? `${(d * 100).toFixed(1)} pts` : d.toLocaleString("en-US", { maximumFractionDigits: perDay ? 1 : 0 }));
      const fmtPct = (p) => { const a = Math.abs(p); const t = a < 10 ? a.toFixed(1).replace(/\.0$/, "") : Math.round(a).toLocaleString("en-US"); return `${p > 0 ? "+" : "−"}${t}%`; };

      /** Rolling windows of complete days: the last complete day is the one before generation. */
      function preset(name, genDay) {
        const last = add(genDay, -1), n = { day: 1, week: 7, month: 30, year: 365 }[name];
        return { A: [add(last, -(n - 1)), last], B: [add(last, -(2 * n - 1)), add(last, -n)] };
      }
      /** Custom default: this month so far vs the same days of last month (a whole month when
          the month has just started). */
      function customDefault(genDay) {
        const last = add(genDay, -1);
        const aFrom = last.slice(0, 8) + "01";
        const [y, m] = aFrom.split("-").map(Number);
        const bFrom = new Date(Date.UTC(y, m - 2, 1)).toISOString().slice(0, 10);
        const prevLen = new Date(Date.UTC(y, m - 1, 0)).getUTCDate();
        return { A: [aFrom, last], B: [bFrom, add(bFrom, Math.min(span(aFrom, last), prevLen) - 1)] };
      }

      function total(byDay, m, [from, to]) {
        let x = 0, y = 0, missing = 0;
        for (let d = from; d <= to; d = add(d, 1)) {
          const r = byDay.get(d);
          if (m.num) {
            if (r?.[m.num] == null || r?.[m.den] == null) { missing++; continue; }
            x += r[m.num]; y += r[m.den];
          } else {
            if (r?.[m.key] == null) { missing++; continue; }
            x += r[m.key];
          }
        }
        if (missing) return { missing };
        return { value: m.num ? (y > 0 ? x / y : null) : x, base: m.num ? y : x };
      }

      /** One result per metric: both values, the change and how to read it. */
      function compare(history, A, B) {
        const byDay = new Map(history.map((r) => [r.day, r]));
        const first = {}, lastSeen = {};
        for (const r of history) for (const k in r) if (r[k] != null) { if (first[k] === undefined) first[k] = r.day; lastSeen[k] = r.day; }
        const lenA = span(A[0], A[1]), lenB = span(B[0], B[1]);
        const perDay = lenA !== lenB;
        return METRICS.map((m) => {
          const k = m.num || m.key, start = first[k];
          // Search Console reports a couple of days late: move both windows back to its last
          // reported day instead of showing nothing for every recent period.
          let pa = A, pb = B, shifted = false;
          if (m.lag && lastSeen[k] && A[1] > lastSeen[k] && span(lastSeen[k], A[1]) - 1 <= 7) {
            const n = span(lastSeen[k], A[1]) - 1;
            pa = [add(A[0], -n), add(A[1], -n)]; pb = [add(B[0], -n), add(B[1], -n)]; shifted = true;
          }
          const why = ([from]) => !start ? "no data yet"
            : from < start ? `not enough history yet (data starts ${fmtDay(start)})`
            : m.lag ? "Search Console has not reported these days yet"
            : "some days in this period were not recorded";
          const ra = total(byDay, m, pa), rb = total(byDay, m, pb);
          const res = { key: m.key, m, a: null, b: null, state: "", pct: null, tone: "neutral", note: "", perDay, shifted: shifted ? { A: pa, B: pb } : null };
          const scale = (v, len) => (v == null || m.num || !perDay ? v : v / len);
          if (ra.missing) { res.state = "unavailable"; res.note = why(pa); }
          else {
            res.a = scale(ra.value, lenA);
            if (rb.missing) { res.state = "unavailable"; res.note = why(pb); }
            else res.b = scale(rb.value, lenB);
          }
          if (!res.state) {
            const { a, b } = res;
            if (a == null && b == null) { res.state = "none"; res.note = "no readings in either period"; }
            else if (b == null || (b === 0 && a > 0 && !m.abs)) res.state = "new";
            else if (a == null) { res.state = "gone"; res.note = "no readings in this period"; }
            else if (Math.abs(a - b) < 1e-9 || Math.abs(((a - b) / b) * 100) < 0.05) res.state = "same";
            // abs: an average (position, click-through) moves in its own units, not in percent, and
            // needs enough impressions on both sides before its movement means anything.
            else if (m.abs) { res.diff = a - b; res.state = Math.min(ra.base, rb.base) < (m.minBase ?? MIN_BASE.readings) ? "small" : "diff"; }
            else if (rb.base < (m.num ? MIN_BASE.readings : MIN_BASE.count)) { res.state = "small"; res.diff = a - b; }
            else { res.state = "change"; res.pct = ((a - b) / b) * 100; }
            const sign = res.state === "new" ? 1 : res.state === "gone" ? -1 : res.state === "change" ? Math.sign(res.pct) : res.state === "diff" ? Math.sign(res.diff) : 0;
            // An average appearing or vanishing (no impressions on one side) is neither better nor worse.
            const dir = m.abs && (res.state === "new" || res.state === "gone") ? 0 : m.dir ?? 1;
            res.tone = sign * dir > 0 ? "good" : sign * dir < 0 ? "bad" : "neutral";
          }
          return res;
        });
      }

      if (typeof document === "undefined") { globalThis.digestCompare = { compare, preset, customDefault, fmtPct, fmtRange, METRICS }; return; }

      const root = document.getElementById("compare");
      if (!root) return;
      let data = null;
      try { data = JSON.parse(document.getElementById("compare-data").textContent); } catch {}
      const history = (data?.history || []).filter((r) => ISO.test(r.day)).sort((x, y) => (x.day < y.day ? -1 : 1));
      const body = root.querySelector("[data-cmp-body]");
      const rangeEl = root.querySelector("[data-cmp-range]");
      const customEl = root.querySelector("[data-cmp-custom]");
      const radios = [...root.querySelectorAll('input[name="compare-period"]')];
      const dates = Object.fromEntries([...root.querySelectorAll("[data-cmp-date]")].map((el) => [el.dataset.cmpDate, el]));
      if (!history.length || !data?.generatedAt) {
        body.innerHTML = '<p class="muted">History starts with the next pipeline run.</p>';
        radios.forEach((r) => (r.disabled = true));
        return;
      }
      const genDay = data.generatedAt.slice(0, 10), lastDay = add(genDay, -1), firstDay = history[0].day;
      for (const el of Object.values(dates)) { el.min = firstDay; el.max = lastDay; }

      const KEY = "admin_compare";
      let saved = {};
      try { saved = JSON.parse(localStorage.getItem(KEY) || "{}") || {}; } catch {}
      const okRange = (r) => Array.isArray(r) && r.length === 2 && r.every((d) => ISO.test(d));
      let period = radios.some((r) => r.value === saved.period) ? saved.period : "week";
      let custom = saved.custom && okRange(saved.custom.A) && okRange(saved.custom.B) ? saved.custom : customDefault(genDay);
      const persist = () => { try { localStorage.setItem(KEY, JSON.stringify({ period, custom })); } catch {} };

      const LABEL = { day: "Yesterday vs the day before", week: "Last 7 days vs the 7 before", month: "Last 30 days vs the 30 before", year: "Last 365 days vs the 365 before", custom: "Period A vs period B" };
      const days = (r) => { const n = span(r[0], r[1]); return `${n} day${n === 1 ? "" : "s"}`; };

      function tile(r) {
        const { m } = r;
        const cls = ["tile", "cmp-tile", r.tone === "neutral" ? "" : r.tone].filter(Boolean).join(" ");
        const unit = r.perDay && !m.num ? " a day" : "";
        let change;
        if (r.state === "change") {
          const verdict = r.tone === "good" ? "improvement" : r.tone === "bad" ? "decline" : "change";
          change = `<span class="cmp-change"><span class="cmp-arrow" aria-hidden="true">${r.pct > 0 ? "▲" : "▼"}</span>${fmtPct(r.pct)}<span class="cmp-sr"> (${verdict})</span></span>`;
        } else if (r.state === "small" || r.state === "diff") {
          const d = r.diff, abs = fmtDiff(Math.abs(d), m, r.perDay);
          const verdict = r.tone === "good" ? " (improvement)" : r.tone === "bad" ? " (decline)" : "";
          change = `<span class="cmp-change"><span class="cmp-arrow" aria-hidden="true">${d > 0 ? "▲" : "▼"}</span>${d > 0 ? "+" : "−"}${abs}${unit} <span class="cmp-from">(from ${fmtNum(r.b, m, r.perDay)} to ${fmtNum(r.a, m, r.perDay)})</span><span class="cmp-sr">${verdict}</span></span>`;
        } else if (r.state === "new") {
          change = `<span class="cmp-change"><span class="cmp-arrow" aria-hidden="true">▲</span>new<span class="cmp-sr"> (nothing in the previous period)</span></span>`;
        } else if (r.state === "same") {
          change = `<span class="cmp-change"><span class="cmp-arrow" aria-hidden="true">＝</span>no change</span>`;
        } else if (r.state === "gone") {
          change = `<span class="cmp-change"><span class="cmp-arrow" aria-hidden="true">▼</span>none</span>`;
        } else {
          change = `<span class="cmp-change cmp-note">${r.note}</span>`;
        }
        const prev = r.state === "small" ? m.few || "too few to show as a percentage"
          : r.state === "diff" ? ""
          : r.b != null ? `vs ${fmtNum(r.b, m, r.perDay)}${unit}` : r.state === "unavailable" && r.a != null ? "previous period not available" : "";
        const moved = r.shifted ? `${fmtRange(r.shifted.A)} vs ${fmtRange(r.shifted.B)}, the latest Search Console days` : "";
        const sub = [prev, r.state === "gone" || r.state === "none" ? r.note : "", moved, m.note].filter(Boolean).join(" · ");
        return `<div class="${cls}"><span class="label">${m.label}</span><span class="value">${fmtNum(r.a, m, r.perDay)}${r.a != null && unit ? `<small>${unit}</small>` : ""}</span>${change}<span class="sub">${sub}</span></div>`;
      }

      function render() {
        radios.forEach((r) => (r.checked = r.value === period));
        customEl.hidden = period !== "custom";
        const { A, B } = period === "custom" ? custom : preset(period, genDay);
        if (period === "custom") { dates.a0.value = A[0]; dates.a1.value = A[1]; dates.b0.value = B[0]; dates.b1.value = B[1]; }
        const res = compare(history, A, B);
        const perDay = res[0]?.perDay;
        const lines = [`<span class="cmp-what">${LABEL[period]}:</span> <b>${fmtRange(A)}</b> (${days(A)}) vs <b>${fmtRange(B)}</b> (${days(B)})`];
        if (perDay) lines.push("The periods differ in length, so counts are shown as daily averages.");
        if (B[0] < firstDay) lines.push(`Not enough history yet for the full previous period: data starts ${fmtDay(firstDay)}.`);
        rangeEl.innerHTML = lines.join("<br>");
        body.innerHTML = GROUPS.map(([g]) => `<h3 class="cmp-group">${g}</h3><div class="tiles cmp-tiles">${res.filter((r) => r.m.group === g).map(tile).join("")}</div>`).join("");
      }

      radios.forEach((r) => r.addEventListener("change", () => { if (r.checked) { period = r.value; persist(); render(); } }));
      const readCustom = () => {
        const pair = (x, y) => {
          let f = ISO.test(dates[x].value) ? dates[x].value : null, t = ISO.test(dates[y].value) ? dates[y].value : null;
          if (!f || !t) return null;
          if (f > t) [f, t] = [t, f];
          if (t > lastDay) t = lastDay;
          if (f > t) f = t;
          return [f, t];
        };
        const A = pair("a0", "a1"), B = pair("b0", "b1");
        if (A && B) { custom = { A, B }; persist(); }
        render();
      };
      Object.values(dates).forEach((el) => el.addEventListener("change", readCustom));
      root.querySelector("[data-cmp-before]").addEventListener("click", () => {
        const n = span(custom.A[0], custom.A[1]);
        custom = { A: custom.A, B: [add(custom.A[0], -n), add(custom.A[0], -1)] };
        persist(); render();
      });
      render();
    })();
  </script>
  <script is:inline>
    // Home header: whether everything is fine over the last 24 hours, run times, the visitor goal
    // and what changed since the last visit. Everything that ages is computed here, from
    // timestamps, and refreshed every 30 seconds while the tab stays open.
    (() => {
      const root = document.getElementById("home");
      let d = null, history = [];
      try { d = JSON.parse(document.getElementById("home-data").textContent); } catch {}
      try { history = JSON.parse(document.getElementById("compare-data").textContent).history || []; } catch {}
      const MIN = 6e4, HOUR = 36e5, DAY = 864e5;
      const num = (x) => Number(x).toLocaleString("en-US");
      const clock = (iso) => new Date(iso).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
      const dur = (ms) => {
        const m = Math.max(0, Math.round(ms / MIN));
        if (m < 60) return `${m} min`;
        const h = Math.floor(m / 60);
        if (h < 48) return m % 60 ? `${h} h ${m % 60} min` : `${h} h`;
        return `${Math.round(h / 24)} days`;
      };
      const ago = (iso) => { const ms = Date.now() - Date.parse(iso); return ms < MIN ? "just now" : `${dur(ms)} ago`; };
      const when = (iso) => {
        const t = new Date(iso), now = new Date();
        if (t.toDateString() === now.toDateString()) return `today at ${clock(iso)}`;
        if (t.toDateString() === new Date(now - DAY).toDateString()) return `yesterday at ${clock(iso)}`;
        return `${t.toLocaleDateString([], { weekday: "short", day: "numeric", month: "short" })} at ${clock(iso)}`;
      };
      const addDay = (day, n) => new Date(Date.parse(day + "T00:00:00Z") + n * DAY).toISOString().slice(0, 10);
      const spanDays = (a, b) => Math.round((Date.parse(b + "T00:00:00Z") - Date.parse(a + "T00:00:00Z")) / DAY) + 1;
      const fmtDay = (day) => new Date(day + "T12:00:00Z").toLocaleDateString([], { day: "numeric", month: "long" });

      function tick() {
        // A time on an earlier day carries its date, so "since 15:59" never hides that it was yesterday.
        document.querySelectorAll("time[data-clock]").forEach((t) => {
          const iso = t.getAttribute("datetime"), dt = new Date(iso);
          t.textContent = dt.toDateString() === new Date().toDateString() ? clock(iso) : `${dt.toLocaleDateString([], { weekday: "short", day: "numeric", month: "short" })}, ${clock(iso)}`;
        });
        document.querySelectorAll("time[data-ago]").forEach((t) => { const v = t.getAttribute("datetime"); if (v) t.textContent = ago(v); });
      }

      function status(now) {
        const gen = Date.parse(d.generatedAt || "");
        const every = (d.schedule && d.schedule.intervalMinutes) || 30;
        // Stale after two missed runs (never sooner than 90 minutes).
        const stale = !gen || now - gen > Math.max(90, 2 * every + 30) * MIN;
        const day = d.runs.filter((r) => now - Date.parse(r.startedAt) <= 24 * HOUR);
        const failed = day.filter((r) => !r.ok);
        const crit = d.cards.filter((c) => c.level === "critical").length;
        const warn = d.cards.filter((c) => c.level === "warning").length;
        const latest = d.runs[0];
        let kind = "good", first;
        if (stale) { kind = "bad"; first = gen ? `Something is wrong: the site has not been updated for ${dur(now - gen)}, so the pipeline may have stopped.` : "There is no pipeline data yet."; }
        else if (crit) { kind = "bad"; first = crit === 1 ? "One thing needs your attention now (below)." : `${crit} things need your attention now (below).`; }
        else if (warn) { kind = "warn"; first = warn === 1 ? "The site is running. One thing below is worth a look." : `The site is running. ${warn} things below are worth a look.`; }
        else first = "Everything is fine.";
        let second = "";
        if (day.length && !failed.length) second = day.length === 1 ? "The one run in the last 24 hours finished." : `All ${num(day.length)} runs in the last 24 hours finished.`;
        else if (failed.length === 1) second = `One of ${num(day.length)} runs in the last 24 hours failed, at ${clock(failed[0].startedAt)}; the site kept the previous version${latest && latest.ok ? " and later runs worked" : ""}.`;
        else if (failed.length > 1) second = `${failed.length} of ${num(day.length)} runs in the last 24 hours failed, the latest at ${clock(failed[0].startedAt)}; each time the site kept the previous version.`;
        else if (!stale) second = "No runs recorded in the last 24 hours.";
        if (kind === "good" && failed.length === 0 && day.length) { first = "Everything is fine:"; second = second.charAt(0).toLowerCase() + second.slice(1).replace(/\.$/, "") + " and nothing needs your attention."; }
        return { kind, text: `${first} ${second}`.trim(), stale, latest, gen };
      }

      function render() {
        tick();
        if (!root || !d) return;
        const now = Date.now();
        const s = status(now);
        root.dataset.kind = s.kind;
        root.querySelector("[data-home-sentence]").textContent = s.text;
        root.querySelector("[data-home-stale]").hidden = !s.stale;
        const head = document.getElementById("head-status");
        if (head) {
          head.querySelector(".st").className = `st ${s.kind}`;
          head.querySelector("[data-head-text]").textContent = s.kind === "good" ? "everything is fine" : s.stale ? "site not updating" : s.kind === "bad" ? "needs attention" : "running, a few things to check";
        }
        // Clock line. The schedule starts runs at fixed minutes past the hour (UTC), as the pipeline
        // reports them; GitHub often starts them a few minutes late.
        const parts = [];
        if (s.latest) {
          parts.push(`Last run started <b>${ago(s.latest.startedAt)}</b> (${clock(s.latest.startedAt)})`);
          const sched = d.schedule || { intervalMinutes: 30, runMinutes: [0, 30] };
          const minutes = (sched.runMinutes && sched.runMinutes.length ? sched.runMinutes : [0, 30]).slice().sort((a, b) => a - b);
          const hour = Math.floor((now + MIN) / (60 * MIN)) * 60 * MIN;
          const past = (now + MIN - hour) / MIN;
          const m = minutes.find((x) => x >= past);
          const next = m === undefined ? hour + 60 * MIN + minutes[0] * MIN : hour + m * MIN;
          parts.push(now - Date.parse(s.latest.startedAt) > 1.5 * (sched.intervalMinutes || 30) * MIN ? "<b>next run is overdue</b>" : `next run due about <b>${clock(new Date(next).toISOString())}</b>`);
        }
        if (s.gen) parts.push(`page data from <b>${ago(d.generatedAt)}</b>`);
        root.querySelector("[data-home-clock]").innerHTML = parts.join(" · ") || "No pipeline data yet.";

        // Visitors toward the goal: daily visits added up from launch day.
        const end = addDay(d.launch, d.goalDays - 1);
        const today = new Date(now).toISOString().slice(0, 10);
        const rows = history.filter((r) => r.day >= d.launch && r.day <= end);
        const measured = rows.some((r) => r.visitors != null);
        const total = rows.reduce((n, r) => n + (Number(r.visitors) || 0), 0);
        const countEl = root.querySelector("[data-goal-count]"), pace = root.querySelector("[data-goal-pace]");
        const bar = root.querySelector("[data-goal-bar]"), mark = root.querySelector("[data-goal-mark]");
        countEl.textContent = measured ? num(total) : "–";
        bar.style.width = `${Math.min(100, (total / d.goal) * 100)}%`;
        if (!measured) pace.textContent = "Visitor counts appear after the first tracked visit.";
        else if (today < d.launch) pace.textContent = `The count starts on ${fmtDay(d.launch)}.`;
        else if (total >= d.goal) pace.innerHTML = `<strong>Goal reached:</strong> ${num(total)} visitors${today > end ? ` in the 30 days to ${fmtDay(end)}` : " so far"}.`;
        else if (today > end) pace.innerHTML = `The 30 days ended on ${fmtDay(end)} with <strong>${num(total)} visitors</strong>, ${num(d.goal - total)} short of the goal.`;
        else {
