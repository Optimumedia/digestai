                  <div class:list={["tile", "cmp-tile", sv.change.impressions.tone]}><span class="label">Impressions, 7 days</span><span class="value">{sv.week.impressions.toLocaleString("en-US")}</span><Fragment set:html={sv.change.impressions.html} /><span class="sub">times the site appeared in someone's Google results</span></div>
                  <div class:list={["tile", "cmp-tile", sv.change.clicks.tone]}><span class="label">Clicks, 7 days</span><span class="value">{sv.week.clicks.toLocaleString("en-US")}</span><Fragment set:html={sv.change.clicks.html} /><span class="sub">visits from Google Search</span></div>
                  <div class:list={["tile", "cmp-tile", sv.change.ctr.tone]}><span class="label">Click-through, 7 days</span><span class="value">{sv.ctr == null ? "—" : `${(sv.ctr * 100).toFixed(1)}%`}</span><Fragment set:html={sv.change.ctr.html} /><span class="sub">share of impressions that became a click</span></div>
                  <div class:list={["tile", "cmp-tile", sv.change.queries.tone]}><span class="label">Searches we appear in, 28 days</span><span class="value">{sv.queryCount.toLocaleString("en-US")}</span><Fragment set:html={sv.change.queries.html} /><span class="sub">different search terms; Google hides rare ones, so the real number is higher</span></div>
                  <div class:list={["tile", "cmp-tile", sv.change.pages.tone]}><span class="label">Pages that appear, 28 days</span><span class="value">{sv.pageCount.toLocaleString("en-US")}</span><Fragment set:html={sv.change.pages.html} /><span class="sub">{sv.inspected ? `pages of this site shown at least once · ${sv.indexed} of ${sv.inspected} key pages indexed` : "pages of this site shown at least once"}</span></div>
                </div>
                <div class="cards">
                  <article class="card wide">
                    <h2>Average position on Google <span class="muted">per day · 1 is the top result, so higher on the chart is better · the shaded band is page 1 of results · gaps are days Google did not show the site · hover a day for exact numbers</span></h2>
                    <Fragment set:html={rankLine(sv.chart, "day", "position", { w: 1100, h: 230, color: C.s1, xFormat: svDay, tip: dayTip(svDay), label: "Average Google position per day, 1 at the top" })} />
                    <h3 class="search-sub">Impressions and clicks <span class="muted">per day, same days</span></h3>
                    <div class="legend"><span><i style={`background:${C.s2}`}></i>Impressions</span><span><i style={`background:${C.s3}`}></i>Clicks</span></div>
                    <Fragment set:html={columns(sv.chart, "day", [{ key: "impressions", label: "Impressions", color: C.s2 }, { key: "clicks", label: "Clicks", color: C.s3 }], { grouped: true, w: 1100, h: 130, xFormat: svDay })} />
                  </article>
                  <article class="card wide">
                    <h2>Searches that show the site <span class="muted">last 28 days ({svDay(gsc.start)} to {svDay(gsc.end)}) · change in average position vs the 28 days before · the line shows each day's position, higher is better</span></h2>
                    {sv.queries.length ? (
                      <div class="tablewrap"><table class="tracker search-table"><thead><tr><th>Search term</th><th class="num">Impr.</th><th class="num">Clicks</th><th class="num">Avg. position</th><th class="num">Change</th><th>Daily position</th></tr></thead><tbody>
                        {sv.queries.slice(0, 25).map((q: any) => (
                          <tr>
                            <td>{q.query}</td><td class="num">{q.impressions}</td><td class="num">{q.clicks}</td><td class="num">{q.position.toFixed(1)}</td>
                            <td class="num"><Fragment set:html={rowChange(q)} /></td>
                            <td><Fragment set:html={q.spark ? rankSpark(q.spark, { color: C.s1, title: sparkTitle(q) }) : ""} /></td>
                          </tr>
