        const today = counts[days[days.length - 1]];
        document.querySelector("[data-share-totals]").textContent =
          `Today: ${today.linkedin} LinkedIn · ${today.x} X · ${today.bluesky} Bluesky — 14 days: ${tot.linkedin} · ${tot.x} · ${tot.bluesky}`;
        const w = 700, h = 200, padL = 28, padR = 6, padT = 16, padB = 22, pw = w - padL - padR, ph = h - padT - padB;
        const max = Math.max(4, ...days.flatMap((d) => [counts[d].linkedin, counts[d].x, counts[d].bluesky]));
        const step = max <= 5 ? 1 : max <= 10 ? 2 : 5, top = Math.ceil(max / step) * step;
        const y = (v) => padT + ph - (v / top) * ph, band = pw / days.length, bw = Math.min(14, band * 0.26);
        const label = (d) => { const t = new Date(d + "T12:00:00Z"); return t.toLocaleDateString("en-GB", { day: "numeric", month: "short", timeZone: "UTC" }); };
        let s = `<svg class="chart" viewBox="0 0 ${w} ${h}" role="img" aria-label="Posts per day on LinkedIn, X and Bluesky, last 14 days">`;
        for (let t = 0; t <= top; t += step) s += `<line class="grid" x1="${padL}" x2="${w - padR}" y1="${y(t)}" y2="${y(t)}"/><text class="tick" x="${padL - 6}" y="${y(t) + 3}" text-anchor="end">${t}</text>`;
        days.forEach((d, i) => {
          const cx = padL + band * i + band / 2, c = counts[d];
          const tip = `${label(d)}: LinkedIn ${c.linkedin}, X ${c.x}, Bluesky ${c.bluesky}`;
          [["linkedin", "var(--series-1)", -1], ["x", "var(--series-2)", 0], ["bluesky", "var(--series-3)", 1]].forEach(([n, color, side]) => {
            const v = c[n], x = cx - bw / 2 + side * (bw + 2);
            if (v > 0) s += `<rect class="mark" x="${x}" y="${y(v)}" width="${bw}" height="${y(0) - y(v)}" rx="2" fill="${color}"><title>${tip}</title></rect><text class="value" x="${x + bw / 2}" y="${y(v) - 4}" text-anchor="middle">${v}</text>`;
          });
          if (i % 2 === (days.length - 1) % 2) s += `<text class="tick" x="${cx}" y="${h - 6}" text-anchor="middle">${i === days.length - 1 ? "today" : label(d)}</text>`;
          s += `<rect class="hit" x="${cx - band / 2}" y="${padT}" width="${band}" height="${ph}"><title>${tip}</title></rect>`;
        });
        box.innerHTML = s + "</svg>";
      }
      const say = (li, text, bad) => { const el = li.querySelector("[data-share-msg]"); el.textContent = text; el.classList.toggle("bad", !!bad); };

      // ---- saving a tick
      async function save(li, net, rec) {
        const id = li.dataset.shareId, slug = items[id]?.slug || id;
        apply(stories, id, net, rec);
