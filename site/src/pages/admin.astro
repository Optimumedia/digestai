  .share-cat { display: inline-block; margin-right: 4px; padding: 1px 7px; border-radius: 3px; background: var(--surface-2); color: var(--ink-2); font-size: 12px; font-weight: 600; }
  .share-tabs { display: flex; gap: 6px; margin: 12px 0 8px; }
