        const w = weekCounts();
        root.querySelector("[data-share-week]").textContent = `Shared this week: ${w.linkedin} on LinkedIn, ${w.x} on X`;
        root.querySelector("[data-share-store]").innerHTML = storeNote;
        renderChart();
      }

      // ---- posted per day, per network: grouped columns for the last 14 days
      function renderChart() {
