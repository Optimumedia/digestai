---
import Base from "../layouts/Base.astro";
import HeldReview from "../components/HeldReview.astro";
import { columns, lines, bars, stackedBars, sinceFirst, dayLabel } from "../lib/charts";
import { rankLine, rankSpark } from "../lib/charts";
import { searchView, rowChange, explainPosition, plural, dayTip, sparkTitle, MIN_IMPRESSIONS, MEANINGFUL_IMPRESSIONS } from "../lib/search";
import { meta, categories, formatDate, shareImage } from "../lib/data";
import fs from "node:fs";
import path from "node:path";

let admin: any = null;
try { admin = JSON.parse(fs.readFileSync(path.resolve(process.cwd(), "src/data/admin.json"), "utf-8")); } catch {}
const holdOn = fs.existsSync(path.resolve(process.cwd(), "src/data/held.json"));
// The morning note (pipeline/digest/morning.py): six sentences a day, the newest first, 14 kept.
type NoteLine = { key: string; label: string; text: string };
type MorningNote = { day: string; title: string; writtenAt: string; sentences: NoteLine[]; polish?: { polished?: boolean } };
let morningNotes: MorningNote[] = [];
try { morningNotes = JSON.parse(fs.readFileSync(path.resolve(process.cwd(), "src/data/morning.json"), "utf-8")).notes || []; } catch {}
const morningNote = morningNotes[0] || null;
const earlierNotes = morningNotes.slice(1);
const noteHow = (n: MorningNote) => (n.polish?.polished ? "reworded by a model, every figure checked against the data" : "written from the data by rules");
let gsc: any = null;
try { gsc = JSON.parse(fs.readFileSync(path.resolve(process.cwd(), "src/data/gsc.json"), "utf-8")); } catch {}
const sv = gsc?.end && gsc?.start ? searchView(gsc) : null;
const svDay = dayLabel();

const repo = import.meta.env.PUBLIC_GISCUS_REPO || "Optimumedia/digestai";
const C = { s1: "var(--series-1)", s2: "var(--series-2)", s3: "var(--series-3)", s4: "var(--series-4)", neutral: "var(--series-neutral)", good: "var(--status-good)", crit: "var(--status-critical)" };

// ---- runs: group step rows into pipeline runs
type Step = { step: string; startedAt: string; finishedAt: string | null; stats: any };
const steps: Step[] = (admin?.runs || []).slice().sort((a: Step, b: Step) => Date.parse(a.startedAt) - Date.parse(b.startedAt));
const runs: { startedAt: string; finishedAt: string | null; steps: Step[]; ok: boolean; seconds: number }[] = [];
for (const s of steps) {
  const last = runs[runs.length - 1];
  if (last && Date.parse(s.startedAt) - Date.parse(last.startedAt) < 29 * 60 * 1000 && s.step !== "fetch") { last.steps.push(s); last.finishedAt = s.finishedAt || last.finishedAt; }
  else runs.push({ startedAt: s.startedAt, finishedAt: s.finishedAt, steps: [s], ok: true, seconds: 0 });
}
for (const r of runs) { r.ok = r.steps.every((s) => !s.stats?.crashed); r.seconds = r.steps.reduce((n, s) => n + (Number(s.stats?.seconds) || 0), 0); }
runs.reverse();
const lastRun = runs[0];
const stat = (r: typeof lastRun | undefined, step: string) => r?.steps.find((s) => s.step === step)?.stats || {};
// The workflow's schedule as the pipeline reported it (hourly or every 30 minutes).
const schedule = { runsPerDay: 48, intervalMinutes: 30, runMinutes: [0, 30], ...(admin?.schedule || {}) };
const everyText = schedule.intervalMinutes >= 60 ? (schedule.intervalMinutes === 60 ? "every hour" : `every ${schedule.intervalMinutes / 60} hours`) : `every ${schedule.intervalMinutes} minutes`;
const nextRunMin = lastRun ? Math.max(0, schedule.intervalMinutes - Math.round((Date.now() - Date.parse(lastRun.startedAt)) / 60000)) : null;

// ---- the database against Supabase's free plan: size, and what the pipeline reads.
const dbInfo = admin?.database || null;
const dbReads = dbInfo?.reads || {};
const dbCycle = dbInfo?.cycle || {};
const mb = (v: number | null | undefined) => v == null ? "—" : v >= 1024 ? `${(v / 1024).toFixed(1)} GB` : v >= 10 ? `${Math.round(v)} MB` : `${v.toFixed(1)} MB`;
const kb = (v: number | null | undefined) => v == null ? "—" : v >= 1024 ? `${(v / 1024).toFixed(1)} MB` : `${Math.round(v)} KB`;
const dbSizePct = dbInfo?.sizeMB != null && dbInfo?.limitMB ? Math.round((dbInfo.sizeMB / dbInfo.limitMB) * 100) : null;
const readRows = (dbReads.steps || []).slice(0, 10).map((s: any) => ({ label: s.step, value: s.readKB, title: `${s.step}: ${kb(s.readKB)} read in the latest run` }));
// ---- storage: the media store (release assets) and the nightly database backup.
const storage = admin?.storage || null;
const fmtAgo = (iso: string | null | undefined) => {
  if (!iso) return "never";
  const h = (Date.now() - Date.parse(iso)) / 36e5;
  return h < 1 ? "under an hour ago" : h < 48 ? `${Math.round(h)} hours ago` : `${Math.round(h / 24)} days ago`;
};
const fmtDayShort = (d: string | null | undefined) => d ? formatDate(`${d}T12:00:00Z`, { day: "numeric", month: "short" }) : "—";

// ---- derived numbers with deltas
const days: string[] = admin?.days || [];
const today = days[days.length - 1], yesterday = days[days.length - 2];
const funnel: any[] = admin?.funnel || [];
const byDay = (arr: any[], key: string) => Object.fromEntries(arr.map((r: any) => [r.day, r[key]]));
const storiesPerDay = byDay(admin?.content?.storiesPerDay || [], "stories");
const publishedPerDay = byDay(funnel, "published");
const sum = (arr: any[], key: string, from: number, to: number) => arr.slice(from, to).reduce((n, r) => n + (Number(r[key]) || 0), 0);
const week = (arr: any[], key: string) => sum(arr, key, -7, undefined as any);
const prevWeek = (arr: any[], key: string) => sum(arr, key, -14, -7);
const pct = (now: number, before: number) => (before > 0 ? Math.round(((now - before) / before) * 100) : null);
const delta = (now: number, before: number) => { const p = pct(now, before); return p == null ? "" : `${p >= 0 ? "+" : ""}${p}% vs prev. 7d`; };

const eng = admin?.engagement || { available: false, perDay: [], topStories: [] };
const views7 = week(eng.perDay, "views"), viewsPrev = prevWeek(eng.perDay, "views");
const visitors7 = week(eng.perDay, "visitors");
const clicks7 = week(eng.perDay, "clicks"), saves7 = week(eng.perDay, "saves"), follows7 = week(eng.perDay, "follows"), shares7 = week(eng.perDay, "shares");
const dwell7 = week(eng.perDay, "dwellSeconds");
const reads7 = week(eng.perDay, "dwellReads");
// Average over reading sessions that reported time, so a lost signal does not drag it to zero.
const avgDwell = reads7 ? Math.round(dwell7 / reads7) : null;
const engagedActions7 = clicks7 + saves7 + follows7 + shares7;
const searches7 = eng.searches7 || { total: 0, queries: 0, noResults: 0, top: [], missing: [] };
const depth7 = eng.depth7 || { reads: 0, stages: {}, avgPercent: null };
const depthRows = [["top", "Left at the top"], ["summary", "Read the summary"], ["full_text", "Read into the full text"], ["end", "Reached the end"]]
  .map(([k, label]) => { const n = Number(depth7.stages?.[k]) || 0; return { label, value: n, title: `${label}: ${n} of ${depth7.reads} reads (${depth7.reads ? Math.round((n / depth7.reads) * 100) : 0}%)` }; });

const budgets = admin?.llm?.budgets || {};
// Only the model providers: the table also counts things the pipeline does with its allowance
// (the "upgrade" row counts stories re-summarised), which are not extra model calls.
const usageToday = (admin?.llm?.usage || []).filter((u: any) => u.day === today && u.provider in budgets);
// Mistral is paid by the token (free $10 a month): its card shows spend against the monthly cap.
const mistral = admin?.llm?.mistral || null;
// Cloudflare Workers AI is held by its free daily neurons (upgrade.py first, then a fallback).
const cloudflare = admin?.llm?.cloudflare || null;
// OpenRouter's free models: a daily request count (failures included), first for the top rewrites.
const openrouter = admin?.llm?.openrouter || null;
const llmDays = days.map((d) => { const row: any = { day: d, gemini: 0, groq: 0 }; for (const u of (admin?.llm?.usage || []).filter((u: any) => u.day === d)) row[u.provider] = u.requests; return row; });

const sources = (admin?.sources || []).slice().sort((a: any, b: any) => b.published - a.published || b.articles - a.articles);
const twoHours = Date.now() - 2 * 3600 * 1000;
const curatedSources = sources.filter((s: any) => s.enabled && !s.discovered);
const healthy = curatedSources.filter((s: any) => s.errorCount === 0 && Date.parse(s.lastFetchedAt || "0") > twoHours).length;
const failing = sources.filter((s: any) => s.enabled && s.errorCount > 0);
const alerts: { level: string; text: string }[] = admin?.alerts || [];
const critical = alerts.filter((a) => a.level === "critical");
const perf: any[] = admin?.performance || [];
const fresh = admin?.freshness || { perDay: [], perSource: {} };
const freshRows = fresh.perDay.map((d: any) => ({ day: d.day, minutes: d.medianMinutes ?? 0 }));
const freshToday = fresh.perDay[fresh.perDay.length - 1]?.medianMinutes ?? null;
const extraction: any[] = admin?.extraction || [];
const exSeries = [{ key: "full", label: "Full text", color: C.s1 }, { key: "short", label: "Short text", color: C.s4 }, { key: "description", label: "Summary only", color: C.neutral }, { key: "failed", label: "Failed", color: C.s2 }];
const modelSeries = [{ key: "gemini", label: "Gemini", color: C.s1 }, { key: "groq", label: "Groq", color: C.s2 }, { key: "ollama", label: "Local model", color: C.s3 }, { key: "heuristic", label: "Heuristic", color: C.neutral }];
const funnelSeries = [{ key: "published", label: "Published", color: C.s1 }, { key: "rejectedGate", label: "Rejected at gate", color: C.neutral }, { key: "rejectedExtract", label: "Extraction failed", color: C.s2 }, { key: "rejectedLlm", label: "Rejected by model", color: C.s3 }, { key: "pending", label: "Waiting for a summary", color: C.s4 }];
const runRows = runs.slice(0, 48).reverse().map((r) => ({ t: r.startedAt, ok: r.ok ? Math.round(r.seconds) : 0, bad: r.ok ? 0 : Math.round(r.seconds) }));
const catRows = (admin?.content?.categories || []).map((c: any) => ({ label: c.name, value: c.stories }));
const srcRows = sources.filter((s: any) => s.published > 0).slice(0, 12).map((s: any) => ({ label: s.name, value: s.published, title: `${s.name}: ${s.published} published of ${s.articles} fetched, ${s.discussed} discussed on the web` }));
const mins = (m: number | null | undefined) => m == null ? "—" : m >= 120 ? `${(m / 60).toFixed(1)} h` : `${m} min`;
const rel = (iso: string | null | undefined) => iso ? `${Math.round((Date.now() - Date.parse(iso)) / 60000)} min ago` : "never";
const topNow = perf.slice().sort((a, b) => b.score - a.score).slice(0, 6);
const topReaders = perf.slice().sort((a, b) => (b.views || 0) - (a.views || 0)).slice(0, 6);
const statusText = critical.length ? `${critical.length} critical alert${critical.length > 1 ? "s" : ""}` : lastRun && !lastRun.ok ? "last run failed" : "all systems normal";
const statusKind = critical.length || (lastRun && !lastRun.ok) ? "bad" : alerts.length ? "warn" : "good";
// ---- Compare: the full daily history goes to the page; periods are computed in the browser.
// Days before visitor numbers existed have no "visitors"; their sessions are the closest measure.
const history: any[] = (admin?.history || []).map((r: any) => (r.visitors == null && r.sessions != null ? { ...r, visitors: r.sessions } : r));
const compareData = JSON.stringify({ generatedAt: admin?.generatedAt || null, history }).replace(/</g, "\\u003c");
const periods = [["day", "Day"], ["week", "Week"], ["month", "Month"], ["year", "Year"], ["custom", "Custom"]];

// ---- AI at Work (pipeline/digest/admin.py, work_summary): one line on the Today tab.
const workHealth: any = admin?.work || null;
const workDropped = Object.entries(workHealth?.dropped || {}) as [string, number][];
const workDroppedText = workDropped.length
  ? `${workDropped.map(([why, n]) => `${n} ${n === 1 ? "card" : "cards"} dropped as ${why === "developer" ? "developer-only" : why === "course" ? (n === 1 ? "a course or reseller listing" : "courses or reseller listings") : why}`).join(", ")}${workHealth?.droppedTools?.length ? ` (${workHealth.droppedTools.slice(0, 4).join(", ")})` : ""}`
  : "0 cards dropped as developer-only";

// ---- Home header and action list. Times and counts that age are computed in the browser.
let held: any = null;
try { held = JSON.parse(fs.readFileSync(path.resolve(process.cwd(), "src/data/held.json"), "utf-8")); } catch {}
type CardAction = { kind: string; label: string; url?: string; slug?: string; source?: string; name?: string };
type Card = { id: string; level: string; what: string; why?: string; todo?: string; at?: string; detail?: string; action?: CardAction; items?: any[]; more?: number };
const actionCards: Card[] = (admin?.actions || alerts.map((a, i) => ({ id: `alert:${i}`, level: a.level, what: a.text }))).slice();
const heldCount = Number(held?.count) || 0;
if (heldCount > 0) {
  actionCards.unshift({
    id: "held", level: "warning",
    what: heldCount === 1 ? "1 story is waiting for your review." : `${heldCount} stories are waiting for your review.`,
    why: "The pipeline held them back because they make claims that could be risky to publish unchecked. Readers do not see them until you decide.",
    todo: "Open the list, read each story and choose to publish it or keep it hidden.",
    action: { kind: "link", url: "#held", label: "Review held stories" },
  });
}
// ---- Share today (pipeline/digest/share.py): the day's stories for LinkedIn and X, posted by hand.
type ShareItem = { id: number; slug: string; headline: string; category: string; categoryName: string; kind: string; reason: string;
  publishers: number; url: string; links: { linkedin: string; x: string }; linkedin: string; x: string; xLength: number;
  done: Record<string, { at: string; url: string }>;
  /** Pictures the story's sources declare (share.source_images): shown for downloading by hand. */
  sourceImages?: { url: string; outlet: string; domain: string; articleUrl: string; primary: boolean }[] };
const shareToday: { day: string; items: ShareItem[]; week: Record<string, number>; file: string; bluesky?: Record<string, number> } | null = admin?.share?.items?.length ? admin.share : null;
const shareData = JSON.stringify(shareToday ? { day: shareToday.day, file: shareToday.file, week: shareToday.week, bluesky: shareToday.bluesky || {},
  items: shareToday.items.map((i) => ({ id: i.id, slug: i.slug, links: i.links, done: i.done })) } : null).replace(/</g, "\\u003c");
const LEVEL: Record<string, string> ={ critical: "Needs you now", warning: "Worth a look", info: "For your information" };
const whatParts = (c: Card) => c.what.split("{at}");
const actionsUrl = `https://github.com/${repo}/actions/workflows/pipeline.yml`;
const qualityRun = admin?.quality;
const genMs = Date.parse(admin?.generatedAt || "") || 0;
const homeData = JSON.stringify({
  generatedAt: admin?.generatedAt || null,
  launch: "2026-09-11", goal: 1000, goalDays: 30,
  runs: runs.filter((r) => genMs - Date.parse(r.startedAt) <= 48 * 3600 * 1000).map((r) => ({ startedAt: r.startedAt, ok: r.ok })),
  storyTimes: admin?.storyTimes || [],
  schedule,
  cards: actionCards.map((c) => ({ id: c.id, level: c.level })),
}).replace(/</g, "\\u003c");
---

<Base title="Digest AI Admin" description="Pipeline health, readers, content, sources and model usage." noindex={true}>
  <div class="admin" data-pagefind-ignore>
    <header class="admin-head">
      <div>
        <div class="eyebrow">Admin · data from <time datetime={admin?.generatedAt} data-static data-ago>{admin?.generatedAt ? `${admin.generatedAt.slice(0, 16).replace("T", " ")} UTC` : "never"}</time></div>
        <h1>Newsroom</h1>
      </div>
      <div class="statusline" id="head-status"><span class:list={["st", statusKind]}>●</span> <span data-head-text>{statusText}</span></div>
      <div class="admin-actions">
        <button class="tb primary" id="run-now">Run pipeline now</button>
        <a class="tb" href={`https://github.com/${repo}/actions`} target="_blank" rel="noopener">Actions log ↗</a>
      </div>
    </header>

    <nav class="tabs" aria-label="Dashboard sections">
      <a href="#today" data-tab="today">Today</a>
      <a href="#share" data-tab="share">Share</a>
      <a href="#readers" data-tab="readers">Readers</a>
      <a href="#content" data-tab="content">Content</a>
      <a href="#sources" data-tab="sources">Sources</a>
      <a href="#pipeline" data-tab="pipeline">Pipeline</a>
      <a href="#seo" data-tab="seo">Search</a>
      <a href="#settings" data-tab="settings">Settings</a>
    </nav>

    {!admin && <p class="muted">No admin data yet. The pipeline writes it on its next run.</p>}

    {admin && (
      <>
        <!-- ============ TODAY: the 30-second read ============ -->
        <section class="tab" data-tab="today">
          {morningNote && (
            <section class="mnote" id="morning-note" aria-labelledby="mnote-title">
              <div class="mnote-head">
                <h2 id="mnote-title">{morningNote.title}</h2>
                <p class="mnote-meta">Written at <time datetime={morningNote.writtenAt} data-static data-clock>{morningNote.writtenAt.slice(11, 16)} UTC</time> about the last 24 hours, {noteHow(morningNote)}.</p>
              </div>
              <ol class="mnote-list">
                {morningNote.sentences.map((s) => <li class:list={["mnote-line", { decide: s.key === "decide" }]}><span class="mnote-label">{s.label}</span><p>{s.text}</p></li>)}
              </ol>
              {earlierNotes.length > 0 && (
                <details class="mnote-earlier">
                  <summary>Earlier notes <span class="muted">({earlierNotes.length})</span></summary>
                  {earlierNotes.map((n) => (
                    <details class="mnote-old">
                      <summary>{n.title}</summary>
                      <ol class="mnote-list">
                        {n.sentences.map((s) => <li class="mnote-line"><span class="mnote-label">{s.label}</span><p>{s.text}</p></li>)}
                      </ol>
                    </details>
                  ))}
                </details>
              )}
            </section>
          )}
          <section class="home" id="home" data-kind={statusKind} aria-labelledby="home-sentence">
            <div class="home-status">
              <span class="home-dot" aria-hidden="true"></span>
              <p class="home-sentence" id="home-sentence" data-home-sentence aria-live="polite">{critical.length ? `${critical.length} thing${critical.length > 1 ? "s need" : " needs"} your attention now (below).` : actionCards.some((c) => c.level === "warning") ? "The site is running. A few things below are worth a look." : "Everything is fine."}</p>
            </div>
            <p class="home-clock" data-home-clock>Data from {admin.generatedAt?.slice(0, 16).replace("T", " ")} UTC</p>
            <div class="home-stale" data-home-stale hidden>
              <button type="button" class="tb primary" data-run>Run pipeline now</button>
              <a class="tb" href={`${actionsUrl}`} target="_blank" rel="noopener">Actions log ↗</a>
            </div>
            <div class="home-grid">
              <div class="home-goal">
                <div class="eyebrow">Visitors in the first 30 days</div>
                <div class="home-goal-num"><span class="value" data-goal-count>–</span><span class="muted">of 1,000</span></div>
                <div class="goal-bar" aria-hidden="true"><i data-goal-bar></i><b data-goal-mark hidden></b></div>
                <p class="home-p" data-goal-pace></p>
                <p class="home-note">A visitor is one visit on one day: someone who comes back tomorrow counts again.</p>
              </div>
              <div class="home-since">
                <div class="eyebrow">Since your last visit</div>
                <p class="home-p" data-since>Shown once the page has loaded.</p>
              </div>
            </div>
            <script is:inline type="application/json" id="home-data" set:html={homeData}></script>
          </section>

          <section class="action-list" aria-labelledby="actions-title">
            <h2 id="actions-title" class="ac-title">What needs you <span class="muted">{actionCards.length ? `${actionCards.length} item${actionCards.length > 1 ? "s" : ""}, most urgent first` : ""}</span></h2>
            {actionCards.length === 0 ? (
              <p class="ac-empty"><span class="st good">●</span> Nothing needs your attention.</p>
            ) : (
              <ul class="ac-list">
                {actionCards.map((c) => (
                  <li class:list={["ac", c.level]} data-card={c.id}>
                    <span class="ac-badge"><i aria-hidden="true"></i>{LEVEL[c.level] || c.level}</span>
                    <p class="ac-what">{whatParts(c).map((part, i) => (i && c.at ? <><time datetime={c.at} data-static data-clock>{c.at.slice(11, 16)} UTC</time>{part}</> : i ? <>an earlier time{part}</> : part))}</p>
                    {c.why && <p class="ac-why"><b>Why it matters:</b> {c.why}</p>}
                    {c.todo && <p class="ac-todo"><b>What to do:</b> {c.todo}</p>}
                    {c.detail && <p class="ac-detail">{c.detail}</p>}
                    {c.items && c.items.length > 0 && (
                      <ul class="ac-items">
                        {c.items.map((it: any) => (
                          <li>
                            <span class="ac-item-text">{it.slug ? <a href={`/story/${it.slug}`}>{it.headline}</a> : <b>{it.headline}</b>}<span class="muted">{it.detail}</span></span>
                            {it.action?.kind === "link" && <a class="tb" href={it.action.url} target="_blank" rel="noopener" data-copy-url={it.action.copy} title={it.action.copy ? `Copies ${it.action.copy}` : undefined}>{it.action.label} ↗</a>}
                            {it.action?.kind === "unpublish" && <button type="button" class="tb danger" data-mod="unpublish" data-slug={it.action.slug}>Unpublish</button>}
                          </li>
                        ))}
                        {(c.more || 0) > 0 && <li class="muted">and {c.more} more</li>}
                      </ul>
                    )}
                    {c.action && (
                      <div class="ac-actions">
                        {c.action.kind === "link" && <a class="tb primary" href={c.action.url} target={c.action.url?.startsWith("http") ? "_blank" : undefined} rel="noopener">{c.action.label}{c.action.url?.startsWith("http") ? " ↗" : ""}</a>}
                        {c.action.kind === "run" && <button type="button" class="tb primary" data-run>{c.action.label}</button>}
                        {c.action.kind === "pause" && <button type="button" class="tb danger" data-pause={c.action.source} data-name={c.action.name}>{c.action.label}</button>}
                        {c.action.kind === "unpublish" && <button type="button" class="tb danger" data-mod="unpublish" data-slug={c.action.slug}>{c.action.label}</button>}
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            )}
            {qualityRun?.checked && <p class="ac-foot">Content checks ran at <time datetime={qualityRun.checkedAt} data-static data-clock>{String(qualityRun.checkedAt).slice(11, 16)} UTC</time>: {qualityRun.checked.stories} stories, {qualityRun.checked.images} pictures and {qualityRun.checked.links} links checked. They run with every pipeline run, {everyText}.</p>}
          </section>

          {shareToday && <p class="share-pointer"><a href="#share" data-tab-link="share">Share today: {shareToday.items.length} stories ready for LinkedIn and X →</a></p>}

          <article class="card live" id="live-now" aria-live="polite">
            <div class="live-head"><span class="live-dot" aria-hidden="true"></span><span class="eyebrow" data-live-status>Connecting…</span></div>
            <div class="live-body">
              <div class="live-count"><span class="value" data-live-count>–</span><span class="muted" data-live-label>people on the site right now</span></div>
              <div class="live-cols">
                <div><div class="eyebrow">Reading now</div><ol class="ranked" data-live-pages><li class="muted">Waiting for the first reader…</li></ol></div>
                <div><div class="eyebrow">Came from</div><p data-live-sources>—</p><div class="eyebrow">Devices</div><p data-live-devices>—</p></div>
              </div>
            </div>
          </article>
          {holdOn && <HeldReview />}
          <section class="card compare" id="compare" aria-labelledby="compare-title">
            <div class="compare-head">
              <h2 id="compare-title">Compare <span class="muted">period vs period · complete UTC days</span></h2>
              <div class="seg" role="radiogroup" aria-label="Comparison period">
                {periods.map(([v, l]) => <label class="seg-opt"><input type="radio" name="compare-period" value={v} checked={v === "week"} /><span>{l}</span></label>)}
              </div>
            </div>
            <div class="compare-custom" data-cmp-custom hidden>
              <fieldset>
                <legend>Period A</legend>
                <label>From <input type="date" data-cmp-date="a0" /></label>
                <label>to <input type="date" data-cmp-date="a1" /></label>
              </fieldset>
              <fieldset>
                <legend>Compared with period B</legend>
                <label>From <input type="date" data-cmp-date="b0" /></label>
                <label>to <input type="date" data-cmp-date="b1" /></label>
              </fieldset>
              <button type="button" class="tb" data-cmp-before>Set B to the days just before A</button>
            </div>
            <p class="compare-range" data-cmp-range aria-live="polite"></p>
            <div data-cmp-body><p class="muted">{history.length ? "Loading the comparison…" : "History starts with the next pipeline run."}</p></div>
            <script is:inline type="application/json" id="compare-data" set:html={compareData}></script>
          </section>
          <div class="tiles">
            <div class="tile"><span class="label">Stories published today</span><span class="value">{storiesPerDay[today] ?? 0}</span><span class="sub">yesterday {storiesPerDay[yesterday] ?? 0}</span></div>
            <div class:list={["tile", { off: !eng.available }]}><span class="label">Views, 7 days</span><span class="value">{eng.available ? views7 : "—"}</span><span class="sub">{eng.available ? (viewsPrev ? delta(views7, viewsPrev) : `${visitors7} visitors`) : "no reader data yet"}</span></div>
            <div class:list={["tile", { off: !eng.available }]}><span class="label">Time on story</span><span class="value">{avgDwell != null ? `${avgDwell}s` : "—"}</span><span class="sub">average per reading session, 7 days</span></div>
            <div class:list={["tile", { warn: failing.length > 0 }]}><span class="label">Sources fetching</span><span class="value">{healthy}/{curatedSources.length}</span><span class="sub">{failing.length ? `${failing.length} failing` : "all fetching"}</span></div>
            <div class:list={["tile", { bad: lastRun && !lastRun.ok }]}><span class="label">Last run</span><span class="value">{lastRun ? (lastRun.ok ? "OK" : "Failed") : "—"}</span><span class="sub">{lastRun ? <><time datetime={lastRun.startedAt} data-static data-ago>{rel(lastRun.startedAt)}</time> · {Math.round(lastRun.seconds / 60)} min</> : ""}</span></div>
          </div>
          <div class="cards">
            <article class="card">
              <h2>On the front page now <span class="muted">feed score</span></h2>
              <ol class="ranked">{topNow.map((s: any) => <li><a href={`/story/${s.slug}`}>{s.headline}</a><span class="mono muted">{(categories[s.category] || "").split(" & ")[0]} · {s.sources} src{s.hnPoints ? ` · HN ${s.hnPoints}` : ""}</span></li>)}</ol>
            </article>
            <article class="card">
              <h2>What readers opened <span class="muted">7 days</span></h2>
              {eng.available ? (
                <ol class="ranked">{topReaders.map((s: any) => <li><a href={`/story/${s.slug}`}>{s.headline}</a><span class="mono muted">{s.views} views{s.dwellAvg != null ? ` · ${s.dwellAvg}s` : ""}{s.clicks ? ` · ${s.clicks} clicks` : ""}</span></li>)}</ol>
              ) : <p class="muted">Appears once reader events arrive.</p>}
            </article>
            {workHealth && (
              <article class="card wide work-health" id="work-health">
                <h2>AI at Work <span class="muted">week {workHealth.week}</span></h2>
                <p class="work-health-line">
                  {workHealth.cards === 0 ? "No practical items yet this week" : <>{plural(workHealth.cards, "item")} across {plural(workHealth.tools, "tool")} this week ({workHealth.try} to try, {workHealth.skip} to leave for later)</>}
                  {" · "}{workHealth.recent} in the last {workHealth.windowHours} hours
                  {" · "}{plural(workHealth.toolCount, "tool")} in the directory, {workHealth.noCost} without a stated cost, {workHealth.noLink} without an official link
                  {" · "}{workDroppedText}
                </p>
                {workHealth.engagement7 && (
                  <p class="work-health-line" data-work-engagement>
                    Readers, 7 days: {plural(workHealth.engagement7.views, "view")} of /work pages
                    {" · "}{workHealth.engagement7.depthAvg != null ? `${workHealth.engagement7.depthAvg}% average read depth` : "no read depth yet"}
                    {" · "}{plural(workHealth.engagement7.tries, "try", "tries")}, {plural(workHealth.engagement7.copies, "prompt copy", "prompt copies")}, {plural(workHealth.engagement7.expands, "how-to opened", "how-tos opened")}
                    {workHealth.engagement7.nextClicks ? <>{" · "}{plural(workHealth.engagement7.nextClicks, "next-step click")}</> : ""}
                    {" · "}{workHealth.engagement7.actionsPer100 != null ? `${workHealth.engagement7.actionsPer100} tries and prompt copies per 100 views` : "no tries per 100 views yet"}
                    {" · "}{workHealth.engagement7.featuredTryRate != null
                      ? `featured card tried ${workHealth.engagement7.featuredTryRate}% of the ${workHealth.engagement7.featuredViews} times it was seen`
                      : "no featured-card views yet"}
                  </p>
                )}
                {workHealth.learning && (
                  <div class="work-learning" data-work-learning>
                    <h3>What readers taught the order <span class="muted">{workHealth.learning.windowDays} days</span></h3>
                    {workHealth.learning.active ? (
                      <>
                        <ul>{workHealth.learning.sentences.map((t: string) => <li>{t}</li>)}</ul>
                        <p class="work-health-line">{workHealth.learning.text}</p>
                        {workHealth.learning.movers?.length > 0 && (
                          <p class="work-health-line muted">
                            This week's cards that moved most: {workHealth.learning.movers.map((m: any, i: number) => (
                              <>{i ? "; " : ""}<a href={`/story/${m.slug}`}>{m.headline}</a> {m.to < m.from ? "up" : "down"} from #{m.from} to #{m.to}</>
                            ))}.
                          </p>
                        )}
                      </>
                    ) : <p class="work-health-line muted">{workHealth.learning.text}</p>}
                  </div>
                )}
                <p class="work-health-line muted">
                  {workHealth.thinJobs.length ? <>Job pages below three items (not indexed): {workHealth.thinJobs.join(", ")}{workHealth.emptyJobs.length ? <>; empty: {workHealth.emptyJobs.join(", ")}</> : ""}.</> : "Every job page has three items or more."}
                  {" "}Podcast: {workHealth.episode ? <>latest episode {workHealth.episode.week}, out {fmtDayShort(workHealth.episode.date)}{workHealth.episode.seconds ? `, ${Math.round(workHealth.episode.seconds / 60)} min` : ""}</> : "no episode yet"}{workHealth.audioReason && workHealth.audioReason !== "episode exists" ? <> (latest run: {workHealth.audioReason})</> : ""}.
                  {" "}<a href="/work">Open /work</a> · <a href="/work/tools">Directory</a>
                </p>
              </article>
            )}
            <article class="card wide">
              <h2>Published per day <span class="muted">14 days</span></h2>
              <Fragment set:html={columns(funnel, "day", [{ key: "published", label: "Published", color: C.s1 }])} />
            </article>
          </div>
        </section>

        <!-- ============ SHARE ============ -->
        <section class="tab" data-tab="share" hidden>
            {shareToday && (
              <section class="share" id="share-today" aria-labelledby="share-title">
                <div class="share-head">
                  <h2 id="share-title">Share today</h2>
                  <p class="share-progress" data-share-progress aria-live="polite">0 of {shareToday.items.length} shared today</p>
                </div>
                <p class="share-sub">Stories worth posting on LinkedIn and X today, with the text ready. You post them from your own accounts; nothing here posts for you.</p>
                <p class="share-sub"><span data-share-week>Shared this week: {shareToday.week.linkedin || 0} on LinkedIn, {shareToday.week.x || 0} on X</span> · <span data-share-store>Checking where your ticks are kept…</span></p>
                <ol class="share-list">
                  {shareToday.items.map((it) => (
                    <li class="share-item" data-share-id={it.id}>
                      <div class="share-top">
                        <img class="share-img" src={shareImage(it)} alt="" width="120" height="63" loading="lazy" decoding="async" />
                        <div class="share-text">
                          <a class="share-hl" href={`/story/${it.slug}`} target="_blank" rel="noopener">{it.headline}</a>
                          <p class="share-why"><span class="share-cat">{it.categoryName}</span> {it.reason}</p>
                          <p class="share-doneline" data-share-doneline hidden>Live on LinkedIn and X ✓ <button type="button" class="tb share-fold" data-share-fold hidden aria-expanded="false">Show</button></p>
                        </div>
                        {(it.sourceImages?.length ?? 0) > 0 && (
                          <details class="share-src">
                            <summary>Source image{it.sourceImages!.length > 1 ? "s" : ""} <span class="muted">({it.sourceImages!.length})</span></summary>
                            <p class="share-hint">For attaching by hand. Nothing here changes what gets posted automatically.</p>
                            {it.sourceImages!.map((im, n) => (
                              <figure class="share-src-item">
                                <a class="share-src-thumb" href={im.url} target="_blank" rel="noopener noreferrer" aria-label={`Open source image ${n + 1} in a new tab`}>
                                  <img src={im.url} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" data-src-img />
                                </a>
                                <figcaption>
                                  <p class:list={["share-src-who", { own: im.primary }]}>{im.primary
                                    ? `From ${im.outlet}'s own announcement.`
                                    : `Photo by ${im.outlet}: check you may reuse it before attaching it to a post.`}</p>
                                  <p class="share-src-size" data-src-size>Size: loading…</p>
                                  <p class="share-src-links">
                                    <a href={im.url} target="_blank" rel="noopener noreferrer">Open source image ↗</a>
                                    <a href={im.url} download={`${it.slug.slice(0, 60)}-source-${n + 1}`} target="_blank" rel="noopener noreferrer" data-src-dl>Download</a>
                                  </p>
                                  <p class="share-hint" data-src-hint hidden>This site does not allow a direct download: the picture opened in a new tab. Right-click it (long-press on a phone) → Save image.</p>
                                </figcaption>
                              </figure>
                            ))}
                          </details>
                        )}
                      </div>
                      <div class="share-tabs" role="tablist" aria-label="Network">
                        <button type="button" role="tab" class="share-tab" aria-selected="true" data-tab-net="linkedin">LinkedIn<span class="share-tick" data-tick="linkedin" hidden> ✓</span></button>
                        <button type="button" role="tab" class="share-tab" aria-selected="false" data-tab-net="x">X<span class="share-tick" data-tick="x" hidden> ✓</span></button>
                      </div>
                      {(["linkedin", "x"] as const).map((net) => (
                        <div class="share-pane" role="tabpanel" data-pane={net} hidden={net !== "linkedin"}>
                          <label class="sr-only" for={`share-${it.id}-${net}`}>{net === "x" ? "X" : "LinkedIn"} post text</label>
                          <textarea id={`share-${it.id}-${net}`} class="share-box" rows={net === "x" ? 7 : 9} data-text={net} spellcheck="true">{net === "x" ? it.x : it.linkedin}</textarea>
                          {net === "x" && <p class="share-count" data-count>{it.xLength} of 280 characters (a link counts as 23)</p>}
                          <div class="share-btns">
                            <button type="button" class="tb share-btn" data-copy={net}>Copy text</button>
                            <button type="button" class="tb primary share-btn" data-open={net}>{net === "x" ? "Open X" : "Post on the page"} ↗</button>
                            <button type="button" class="tb share-btn share-done" data-done={net}>Mark done</button>
                          </div>
                          {net === "linkedin"
                            ? <p class="share-hint">Post on the page copies the text and opens the Digest AI page's post box. LinkedIn does not let other sites fill in a page post, so press Ctrl+V there (phone: long-press, Paste), wait for the link preview, post. If the post box does not open, use <a href="https://www.linkedin.com/company/111764730/admin/dashboard/" target="_blank" rel="noopener">the page dashboard ↗</a> and press Create, then Start a post. <button type="button" class="linklike" data-open-personal>Share as yourself instead (text filled in) ↗</button></p>
                            : <p class="share-hint">Open X fills in the text and the link. Be signed in to X as @DigestAINews so it posts from the page's account.</p>}
                          <label class="share-url"><span>Link to your post <span class="muted">(optional)</span></span>
                            <input type="url" inputmode="url" data-post-url={net} placeholder={net === "x" ? "https://x.com/DigestAINews/status/…" : "https://www.linkedin.com/feed/update/…"} />
                          </label>
                        </div>
                      ))}
                      <p class="share-msg" data-share-msg aria-live="polite"></p>
                    </li>
                  ))}
                </ol>
                <script is:inline type="application/json" id="share-data" set:html={shareData}></script>
              </section>
              <section class="share share-stats" aria-labelledby="share-stats-title">
                <div class="share-head">
                  <h2 id="share-stats-title">Posted per day <span class="muted">last 14 days</span></h2>
                  <p class="share-progress" data-share-totals></p>
                </div>
                <div class="legend"><span><i style="background:var(--series-1)"></i>LinkedIn</span><span><i style="background:var(--series-2)"></i>X</span><span><i style="background:var(--series-3)"></i>Bluesky (automatic)</span></div>
                <div data-share-chart><p class="muted">Loading your ticks…</p></div>
                <p class="share-sub">LinkedIn and X from your Mark done ticks, by the day you ticked them; Bluesky from the posts the pipeline made itself. Days are UTC; Bluesky updates with each pipeline run.</p>
              </section>
            )}
          {!shareToday && <p class="muted">The day's list appears after the next pipeline run.</p>}
        </section>

        <!-- ============ READERS ============ -->
        <section class="tab" data-tab="readers" hidden>
          {!eng.available && <div class="alerts"><div class="alert warning"><span class="st warn">●</span> No reader events yet. They appear as soon as people open any page.</div></div>}
          <div class="tiles">
            <div class="tile"><span class="label">Views, 7 days</span><span class="value">{views7}</span><span class="sub">{delta(views7, viewsPrev) || "first week"}</span></div>
            <div class="tile"><span class="label">Visitors, 7 days</span><span class="value">{visitors7}</span><span class="sub">{visitors7 ? `${(views7 / visitors7).toFixed(1)} pages per visitor · one per browser per day` : "one per browser per day"}</span></div>
            <div class="tile"><span class="label">Time on story</span><span class="value">{avgDwell != null ? `${avgDwell}s` : "—"}</span><span class="sub">average per reading session</span></div>
            <div class="tile"><span class="label">Actions, 7 days</span><span class="value">{engagedActions7}</span><span class="sub">{clicks7} to source · {saves7} saved · {follows7} follows · {shares7} shares</span></div>
          </div>
          <div class="cards">
            <article class="card wide">
              <h2>Views, visitors and clicks to source <span class="muted">per day, last 30 days · hover a day for exact numbers</span></h2>
              <div class="legend"><span><i style={`background:${C.s1}`}></i>Views</span><span><i style={`background:${C.s2}`}></i>Visitors</span><span><i style={`background:${C.s3}`}></i>Clicks to source</span></div>
              <Fragment set:html={columns(sinceFirst(eng.perDay, ["views", "visitors", "clicks"]).slice(-30), "day", [{ key: "views", label: "Views", color: C.s1 }, { key: "visitors", label: "Visitors", color: C.s2 }, { key: "clicks", label: "Clicks to source", color: C.s3 }], { grouped: true, w: 1100, h: 240, xFormat: dayLabel() })} />
            </article>
          </div>
          <div class="cards">
            <article class="card">
              <h2>Where visitors came from <span class="muted">7 days</span></h2>
              {(eng.sources7 || []).length ? (
                <ol class="ranked">{eng.sources7.map((s: any) => <li><span>{s.name}</span><span class="mono muted">{s.visitors} visitor{s.visitors === 1 ? "" : "s"} · {s.views} view{s.views === 1 ? "" : "s"}</span></li>)}</ol>
              ) : <p class="muted">Appears with the first counted visit.</p>}
              <p class="muted">From the link a visitor followed: a tag on our own posts (Bluesky, the newsletter), else the site they came from. Direct means typed in, bookmarked or an app that hides where it came from.</p>
            </article>
            <article class="card">
              <h2>Where readers are <span class="muted">7 days</span></h2>
              {(eng.countries7 || []).length ? (
                <ol class="ranked">{eng.countries7.slice(0, 12).map((c: any) => <li><span>{c.name}</span><span class="mono muted">{c.visitors} visitor{c.visitors === 1 ? "" : "s"} · {c.views} view{c.views === 1 ? "" : "s"}</span></li>)}</ol>
              ) : <p class="muted">Appears with the first visit counted after 17 September.</p>}
              <p class="muted">From the time zone each device is set to, so a traveller counts where their phone thinks they are. No IP addresses are used. Unknown means an older visit or a device set to UTC.</p>
            </article>
            <article class="card">
              <h2>Most viewed pages <span class="muted">7 days</span></h2>
              {(eng.pages7 || []).length ? (
                <ol class="ranked">{eng.pages7.map((p: any) => <li><a href={p.path}>{p.path}</a><span class="mono muted">{p.views} view{p.views === 1 ? "" : "s"} · {p.visitors} visitor{p.visitors === 1 ? "" : "s"}</span></li>)}</ol>
              ) : <p class="muted">Appears with the first counted visit.</p>}
            </article>
          </div>
          <div class="cards">
            <article class="card" id="site-searches">
              <h2>What readers searched for <span class="muted">7 days · search page and page not found</span></h2>
              {searches7.total ? (
                <>
                  <p class="muted">{searches7.total} search{searches7.total === 1 ? "" : "es"} for {searches7.queries} different {searches7.queries === 1 ? "subject" : "subjects"}; {searches7.noResults ? `${searches7.noResults} found nothing` : "every one found something"}.</p>
                  {searches7.missing.length > 0 && (
                    <>
                      <div class="eyebrow">Found nothing: subjects the site does not cover</div>
                      <ol class="ranked searches-missing">{searches7.missing.map((m: any) => <li><b>{m.query}</b><span class="mono muted">{m.searches} search{m.searches === 1 ? "" : "es"} · {m.visitors} visitor{m.visitors === 1 ? "" : "s"}</span></li>)}</ol>
                    </>
                  )}
                  <div class="eyebrow">Most searched</div>
                  <ol class="ranked">{searches7.top.map((q: any) => <li><span>{q.query}</span><span class="mono muted">{q.searches} search{q.searches === 1 ? "" : "es"} · {q.results ? `${q.results} result${q.results === 1 ? "" : "s"}` : "no results"}</span></li>)}</ol>
                </>
              ) : <p class="muted">Appears with the first search. Each search is counted once the reader stops typing.</p>}
            </article>
            <article class="card" id="read-depth">
              <h2>How far readers got in a story <span class="muted">7 days · each reader once per story, at their deepest point</span></h2>
              {depth7.reads ? (
                <>
                  <Fragment set:html={bars(depthRows, { color: C.s1, w: 560 })} />
                  <p class="muted">{depth7.reads} story reads; on average readers got {depth7.avgPercent}% of the way down. Summary means they reached the source box under the key points; full text means they read into the publisher's article; stories without full text end at the summary. A glance of under 4 seconds counts as the top.</p>
                </>
              ) : <p class="muted">Appears when readers leave their first story page.</p>}
            </article>
          </div>
          <section class="card">
            <h2>Story performance <span class="muted">7 days · what the model predicted vs what happened · click a header to sort</span></h2>
            <div class="tablewrap">
              <table class="tracker sortable" id="stories-table">
                <thead><tr><th data-sort="headline">Story</th><th data-sort="category">Category</th><th data-sort="predicted" class="num">Predicted</th><th data-sort="views" class="num">Views</th><th data-sort="dwellavg" class="num">Time</th><th data-sort="depthavg" class="num" title="How far down the story readers got, on average">Read</th><th data-sort="clicks" class="num">Clicks</th><th data-sort="hnpoints" class="num">HN</th><th data-sort="sources" class="num">Src</th><th data-sort="score" class="num">Score</th><th>Actions</th></tr></thead>
                <tbody>
                  {perf.map((s: any) => (
                    <tr data-slug={s.slug} data-score={s.score} data-headline={s.headline} data-category={s.category} data-predicted={s.predicted} data-views={s.views} data-dwellavg={s.dwellAvg ?? ""} data-depthavg={s.depthAvg ?? ""} data-clicks={s.clicks} data-hnpoints={s.hnPoints} data-sources={s.sources}>
                      <td><a href={`/story/${s.slug}`}>{s.headline}</a>{s.pinned && <span class="cov-tag"> pinned</span>}</td>
                      <td>{(categories[s.category] || s.category || "").split(" & ")[0]}</td>
                      <td class="num"><span class="mini"><i style={`width:${Math.round(s.predicted * 100)}%`}></i></span>{s.predicted.toFixed(2)}</td>
                      <td class="num">{eng.available ? s.views : "—"}</td>
                      <td class="num">{eng.available && s.dwellAvg != null ? `${s.dwellAvg}s` : "—"}</td>
                      <td class="num">{eng.available && s.depthAvg != null ? `${s.depthAvg}%` : "—"}</td>
                      <td class="num">{eng.available ? s.clicks : "—"}</td>
                      <td class="num">{s.hnPoints || ""}</td>
                      <td class="num">{s.sources}</td>
                      <td class="num">{s.score.toFixed(2)}</td>
                      <td class="acts"><button class="tb" data-mod="pin" data-slug={s.slug}>{s.pinned ? "Unpin" : "Pin"}</button><button class="tb danger" data-mod="unpublish" data-slug={s.slug}>Unpublish</button></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        </section>

        <!-- ============ CONTENT ============ -->
        <section class="tab" data-tab="content" hidden>
          <div class="tiles">
            <div class="tile"><span class="label">Published, 7 days</span><span class="value">{week(funnel, "published")}</span><span class="sub">{delta(week(funnel, "published"), prevWeek(funnel, "published")) || `${Math.round(week(funnel, "published") / 7)} a day`}</span></div>
            <div class="tile"><span class="label">Developing threads</span><span class="value">{admin.content.threads}</span><span class="sub">with 2+ episodes</span></div>
            <div class="tile"><span class="label">Stories with community pulse</span><span class="value">{admin.content.storiesWithPulse}</span><span class="sub">from Hacker News threads</span></div>
            <div class="tile"><span class="label">Moderated</span><span class="value">{admin.content.unpublished + admin.content.pinned.length}</span><span class="sub">{admin.content.unpublished} unpublished · {admin.content.pinned.length} pinned</span></div>
          </div>
          <div class="cards">
            <article class="card">
              <h2>Stories by category <span class="muted">published, 14 days</span></h2>
              <Fragment set:html={bars(catRows, { color: C.s1 })} />
            </article>
            <article class="card">
              <h2>Where articles end up <span class="muted">per day</span></h2>
              <div class="legend">{funnelSeries.map((s) => <span><i style={`background:${s.color}`}></i>{s.label}</span>)}</div>
              <Fragment set:html={columns(funnel, "day", funnelSeries)} />
            </article>
            <article class="card">
              <h2>Who wrote the summaries <span class="muted">published articles by model</span></h2>
              <div class="legend">{modelSeries.map((s) => <span><i style={`background:${s.color}`}></i>{s.label}</span>)}</div>
              <Fragment set:html={columns(admin.publishedByModel, "day", modelSeries)} />
            </article>
            <article class="card">
