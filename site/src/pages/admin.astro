        return out;
      };
      function render() {
        let shared = 0;
        root.querySelectorAll(".share-item").forEach((li) => {
          const rec = stories[li.dataset.shareId] || {};
          let nets = 0;
          for (const net of NETS) {
            const done = rec[net];
            if (done) nets++;
            const btn = li.querySelector(`[data-done="${net}"]`);
            btn.textContent = done ? `Live on ${NAME[net]} ✓` : "Mark done";
            btn.classList.toggle("is-on", !!done);
            btn.setAttribute("aria-pressed", done ? "true" : "false");
            btn.title = done ? `Shared ${done.at.slice(0, 16).replace("T", " ")} UTC. Click to undo.` : `Tick when the ${NAME[net]} post is live`;
            li.querySelector(`[data-tick="${net}"]`).hidden = !done;
            const input = li.querySelector(`[data-post-url="${net}"]`);
            if (done?.url && document.activeElement !== input && !input.value) input.value = done.url;
          }
          const both = nets === NETS.length;
          // Posted on both: fold it away (once, when it becomes done), with Show to open it again.
          if (both && !li.classList.contains("is-done")) li.classList.remove("is-open");
          li.classList.toggle("is-done", both);
          const fold = li.querySelector("[data-share-fold]");
          fold.hidden = !both;
          const open = li.classList.contains("is-open");
          fold.textContent = open ? "Hide" : "Show";
          fold.setAttribute("aria-expanded", open ? "true" : "false");
          li.querySelector("[data-share-doneline]").hidden = !both;
