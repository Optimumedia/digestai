---
import Base from "../layouts/Base.astro";
import { columns, lines, bars } from "../lib/charts";
import { meta, categories, formatDate } from "../lib/data";
import fs from "node:fs";
import path from "node:path";

let admin: any = null;
try { admin = JSON.parse(fs.readFileSync(path.resolve(process.cwd(), "src/data/admin.json"), "utf-8")); } catch {}

const repo = import.meta.env.PUBLIC_GISCUS_REPO || "Optimumedia/digestai";
const C = { s1: "var(--series-1)", s2: "var(--series-2)", s3: "var(--series-3)", s4: "var(--series-4)", neutral: "var(--series-neutral)", good: "var(--status-good)", crit: "var(--status-critical)" };

// ---- group step rows into pipeline runs (steps within 30 minutes of a fetch belong together)
type Step = { step: string; startedAt: string; finishedAt: string | null; stats: any };
const steps: Step[] = (admin?.runs || []).slice().sort((a: Step, b: Step) => Date.parse(a.startedAt) - Date.parse(b.startedAt));
const runs: { startedAt: string; finishedAt: string | null; steps: Step[]; ok: boolean; seconds: number }[] = [];
for (const s of steps) {
  const last = runs[runs.length - 1];
  if (last && Date.parse(s.startedAt) - Date.parse(last.startedAt) < 29 * 60 * 1000 && s.step !== "fetch") {
    last.steps.push(s);
    last.finishedAt = s.finishedAt || last.finishedAt;
  } else {
    runs.push({ startedAt: s.startedAt, finishedAt: s.finishedAt, steps: [s], ok: true, seconds: 0 });
  }
}
for (const r of runs) {
  r.ok = r.steps.every((s) => !s.stats?.crashed);
  r.seconds = r.steps.reduce((n, s) => n + (Number(s.stats?.seconds) || 0), 0);
}
runs.reverse();
const lastRun = runs[0];
const stat = (r: typeof lastRun | undefined, step: string) => r?.steps.find((s) => s.step === step)?.stats || {};

const days: string[] = admin?.days || [];
const today = days[days.length - 1];
const funnel = admin?.funnel || [];
const todayFunnel = funnel[funnel.length - 1] || {};
const published7 = funnel.slice(-7).reduce((n: number, f: any) => n + f.published, 0);
const storiesToday = (admin?.content?.storiesPerDay || []).find((d: any) => d.day === today)?.stories ?? 0;

const usageToday = (admin?.llm?.usage || []).filter((u: any) => u.day === today);
const budgets = admin?.llm?.budgets || {};
const llmDays = days.map((d) => {
  const row: any = { day: d, gemini: 0, groq: 0 };
  for (const u of (admin?.llm?.usage || []).filter((u: any) => u.day === d)) row[u.provider] = u.requests;
  return row;
});

const sources = (admin?.sources || []).slice().sort((a: any, b: any) => b.published - a.published || b.articles - a.articles);
const twoHours = Date.now() - 2 * 3600 * 1000;
const healthy = sources.filter((s: any) => s.enabled && !s.discovered && s.errorCount === 0 && Date.parse(s.lastFetchedAt || "0") > twoHours).length;
const curated = sources.filter((s: any) => s.enabled && !s.discovered).length;
const failing = sources.filter((s: any) => s.enabled && s.errorCount > 0);

const eng = admin?.engagement || { available: false, perDay: [], topStories: [] };
const views7 = eng.perDay.slice(-7).reduce((n: number, d: any) => n + d.views, 0);

const modelSeries = [
  { key: "gemini", label: "Gemini", color: C.s1 },
  { key: "groq", label: "Groq", color: C.s2 },
  { key: "ollama", label: "Local model", color: C.s3 },
  { key: "heuristic", label: "Heuristic", color: C.neutral },
];
const funnelSeries = [
  { key: "published", label: "Published", color: C.s1 },
  { key: "rejectedGate", label: "Rejected at gate", color: C.neutral },
  { key: "rejectedExtract", label: "Extraction failed", color: C.s2 },
  { key: "rejectedLlm", label: "Rejected by model", color: C.s3 },
  { key: "pending", label: "Waiting for a summary", color: C.s4 },
];
const runRows = runs.slice(0, 48).reverse().map((r) => ({ t: r.startedAt, seconds: Math.round(r.seconds), ok: r.ok }));
const catRows = (admin?.content?.categories || []).map((c: any) => ({ label: c.name, value: c.stories }));
const srcRows = sources.filter((s: any) => s.published > 0).slice(0, 14).map((s: any) => ({ label: s.name, value: s.published, title: `${s.name}: ${s.published} published of ${s.articles} fetched, ${s.discussed} discussed on the web` }));
const rel = (iso: string | null | undefined) => iso ? `${Math.round((Date.now() - Date.parse(iso)) / 60000)}m ago` : "never";
---

<Base title="Digest AI Admin" description="Pipeline health, sources, model usage and reader engagement." noindex={true}>
  <div class="admin" data-pagefind-ignore>
    <header class="admin-head">
      <div>
        <div class="eyebrow">Admin · generated <time datetime={admin?.generatedAt}></time> · database: {admin?.dbMode === "postgres" ? "Supabase" : "SQLite in the Actions cache"}</div>
        <h1>Newsroom dashboard</h1>
      </div>
      <div class="admin-actions">
        <a class="tb" href={`https://github.com/${repo}/actions`} target="_blank" rel="noopener">Actions log ↗</a>
        <a class="tb" href={`https://github.com/${repo}/edit/main/pipeline/digest/sources.yaml`} target="_blank" rel="noopener">Edit sources ↗</a>
        <a class="tb" href={`https://github.com/${repo}/edit/main/pipeline/digest/moderation.yaml`} target="_blank" rel="noopener">Edit moderation ↗</a>
        <button class="tb primary" id="run-now">Run pipeline now</button>
      </div>
    </header>

    {!admin && <p class="muted">No admin data yet. The pipeline writes it on its next run.</p>}

    {admin && (
      <>
        <section class="tiles">
          <div class:list={["tile", { bad: lastRun && !lastRun.ok }]}>
            <span class="label">Last run</span>
            <span class="value">{lastRun ? (lastRun.ok ? "OK" : "Failed") : "—"}</span>
            <span class="sub">{lastRun ? `${rel(lastRun.startedAt)} · ${Math.round(lastRun.seconds / 60)} min` : ""}</span>
          </div>
          <div class="tile"><span class="label">Stories today</span><span class="value">{storiesToday}</span><span class="sub">{todayFunnel.fetched ?? 0} links fetched</span></div>
          <div class="tile"><span class="label">Published, 7 days</span><span class="value">{published7}</span><span class="sub">{Math.round(published7 / 7)} a day</span></div>
          <div class="tile">
            <span class="label">Model calls today</span>
            <span class="value">{usageToday.reduce((n: number, u: any) => n + u.requests, 0)}</span>
            <span class="sub">{Object.keys(budgets).map((p) => `${p} ${usageToday.find((u: any) => u.provider === p)?.requests ?? 0}/${budgets[p]}`).join(" · ")}</span>
          </div>
          <div class:list={["tile", { warn: failing.length > 0 }]}><span class="label">Sources healthy</span><span class="value">{healthy}/{curated}</span><span class="sub">{failing.length ? `${failing.length} failing` : "all fetching"}</span></div>
          <div class:list={["tile", { off: !eng.available }]}><span class="label">Reader views, 7 days</span><span class="value">{eng.available ? views7 : "—"}</span><span class="sub">{eng.available ? `${eng.perDay.slice(-7).reduce((n: number, d: any) => n + d.sessions, 0)} sessions` : "connect Supabase to record"}</span></div>
        </section>

        <section class="cards">
          <article class="card">
            <h2>Article funnel <span class="muted">per day, last 14 days</span></h2>
            <div class="legend">{funnelSeries.map((s) => <span><i style={`background:${s.color}`}></i>{s.label}</span>)}</div>
            <Fragment set:html={columns(funnel, "day", funnelSeries)} />
          </article>
          <article class="card">
            <h2>Published articles by model <span class="muted">who wrote the summary</span></h2>
            <div class="legend">{modelSeries.map((s) => <span><i style={`background:${s.color}`}></i>{s.label}</span>)}</div>
            <Fragment set:html={columns(admin.publishedByModel, "day", modelSeries)} />
          </article>
          <article class="card">
            <h2>Model calls per day <span class="muted">against daily budgets {Object.entries(budgets).map(([p, b]) => `${p} ${b}`).join(", ")}</span></h2>
            <div class="legend"><span><i style={`background:${C.s1}`}></i>Gemini</span><span><i style={`background:${C.s2}`}></i>Groq</span></div>
            <Fragment set:html={columns(llmDays, "day", [{ key: "gemini", label: "Gemini", color: C.s1 }, { key: "groq", label: "Groq", color: C.s2 }])} />
          </article>
          <article class="card">
            <h2>Run duration <span class="muted">last {runRows.length} runs, seconds; red = a step crashed</span></h2>
            <Fragment set:html={columns(runRows.map((r) => ({ t: r.t, ok: r.ok ? r.seconds : 0, bad: r.ok ? 0 : r.seconds })), "t", [{ key: "ok", label: "OK", color: C.s1 }, { key: "bad", label: "Failed", color: C.crit }], { xFormat: (v) => String(v).slice(11, 16), labelEvery: 8 })} />
          </article>
          <article class="card">
            <h2>Stories by category <span class="muted">published, 14 days</span></h2>
            <Fragment set:html={bars(catRows, { color: C.s1 })} />
          </article>
          <article class="card">
            <h2>Sources that publish <span class="muted">articles published, 7 days</span></h2>
            <Fragment set:html={bars(srcRows, { color: C.s1 })} />
          </article>
          <article class="card wide">
            <h2>Readers <span class="muted">views and sessions per day</span></h2>
            {eng.available ? (
              <>
                <div class="legend"><span><i style={`background:${C.s1}`}></i>Views</span><span><i style={`background:${C.s2}`}></i>Sessions</span><span><i style={`background:${C.s3}`}></i>Clicks to source</span></div>
                <Fragment set:html={lines(eng.perDay, "day", [{ key: "views", label: "Views", color: C.s1 }, { key: "sessions", label: "Sessions", color: C.s2 }, { key: "clicks", label: "Clicks", color: C.s3 }])} />
              </>
            ) : (
              <p class="muted">No reader events yet. The site records views, time on page, clicks to sources, saves, follows and shares as soon as Supabase is connected (SETUP.md, section 1). The ranking model then trains on what readers actually do; until then it learns from web popularity (Hacker News, Reddit, Mastodon).</p>
            )}
          </article>
        </section>

        <section class="card">
          <h2>Top stories right now <span class="muted">by feed score · actions need a GitHub token (below)</span></h2>
          <div class="tablewrap">
            <table class="tracker" id="stories-table">
              <thead><tr><th>Score</th><th>Story</th><th>Category</th><th>Imp.</th><th>Sources</th><th>Published</th><th>Actions</th></tr></thead>
              <tbody>
                {admin.topStories.map((s: any) => (
                  <tr data-slug={s.slug}>
                    <td class="num">{s.score.toFixed(2)}</td>
                    <td><a href={`/story/${s.slug}`}>{s.headline}</a>{s.pinned && <span class="cov-tag"> pinned</span>}</td>
                    <td>{categories[s.category] || s.category}</td>
                    <td class="num">{s.importance}</td>
                    <td class="num">{s.sources}</td>
                    <td class="num">{formatDate(s.publishedAt, { day: "numeric", month: "short" })}</td>
                    <td class="acts"><button class="tb" data-mod="pin" data-slug={s.slug}>{s.pinned ? "Unpin" : "Pin"}</button><button class="tb danger" data-mod="unpublish" data-slug={s.slug}>Unpublish</button></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section class="card">
          <h2>Sources <span class="muted">7-day performance · click a header to sort</span></h2>
          <div class="tablewrap">
            <table class="tracker sortable" id="sources-table">
              <thead><tr><th data-sort="name">Source</th><th data-sort="type">Type</th><th data-sort="weight" class="num">Weight</th><th data-sort="performance" class="num">Performance</th><th data-sort="articles" class="num">Fetched</th><th data-sort="published" class="num">Published</th><th data-sort="discussed" class="num">Discussed</th><th data-sort="lastFetchedAt">Last fetch</th><th>Status</th></tr></thead>
              <tbody>
                {sources.map((s: any) => (
                  <tr data-name={s.name} data-type={s.type} data-weight={s.weight} data-performance={s.performance} data-articles={s.articles} data-published={s.published} data-discussed={s.discussed} data-lastfetchedat={s.lastFetchedAt || ""}>
                    <td>{s.name}{s.discovered && <span class="cov-tag"> discovered</span>}</td>
                    <td>{s.type}</td>
                    <td class="num">{s.weight.toFixed(1)}</td>
                    <td class="num">{s.performance ? s.performance.toFixed(2) : "—"}</td>
                    <td class="num">{s.articles}</td>
                    <td class="num">{s.published}</td>
                    <td class="num">{s.discussed}</td>
                    <td class="num"><time datetime={s.lastFetchedAt || undefined}></time></td>
                    <td>{!s.enabled ? <span class="st off">● off</span> : s.errorCount > 0 ? <span class="st bad" title={s.lastError}>● failing ({s.errorCount})</span> : <span class="st good">● ok</span>}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section class="card">
          <h2>Recent runs <span class="muted">each step's numbers</span></h2>
          <div class="tablewrap">
            <table class="tracker">
              <thead><tr><th>Started</th><th>Status</th><th class="num">Min</th><th>Fetched</th><th>Extracted</th><th>Gate</th><th>Enriched</th><th>Stories</th><th>Model</th></tr></thead>
              <tbody>
                {runs.slice(0, 20).map((r) => (
                  <tr>
                    <td class="num"><time datetime={r.startedAt} data-static>{formatDate(r.startedAt, { day: "numeric", month: "short" })} {r.startedAt.slice(11, 16)}</time></td>
                    <td>{r.ok ? <span class="st good">● ok</span> : <span class="st bad">● failed</span>}</td>
                    <td class="num">{(r.seconds / 60).toFixed(1)}</td>
                    <td class="num">{stat(r, "fetch").inserted ?? "—"} <span class="muted">/ {stat(r, "fetch").items ?? ""}</span></td>
                    <td class="num">{stat(r, "extract").ok ?? "—"} <span class="muted">/ {stat(r, "extract").processed ?? ""}</span></td>
                    <td class="num">{stat(r, "gate").passed ?? "—"} <span class="muted">/ {stat(r, "gate").checked ?? ""}</span></td>
                    <td class="num">{stat(r, "enrich").enriched ?? "—"}</td>
                    <td class="num">{stat(r, "export").stories ?? "—"}</td>
                    <td>{String(stat(r, "enrich").model || "").replace(/:.*/, "")}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section class="card">
          <h2>Actions <span class="muted">run the pipeline, pin or unpublish stories</span></h2>
          <p class="muted">Actions commit to the repository through GitHub's API, so they need a GitHub token with <b>repo</b> and <b>workflow</b> scopes. It is stored only in this browser. Create one at <a href="https://github.com/settings/tokens/new?scopes=repo,workflow&description=digestai-admin" target="_blank" rel="noopener">github.com/settings/tokens</a>.</p>
          <div class="tokenrow"><input type="password" id="gh-token" placeholder="ghp_… (kept in this browser only)" autocomplete="off" /><button class="tb" id="save-token">Save token</button><span id="token-state" class="muted"></span></div>
          <p id="action-status" class="muted" aria-live="polite"></p>
        </section>
      </>
    )}
  </div>

  <script is:inline define:vars={{ repo }}>
    const tokenKey = "admin_gh_token";
    const get = () => { try { return localStorage.getItem(tokenKey) || ""; } catch { return ""; } };
    const status = (msg, bad) => { const el = document.getElementById("action-status"); if (el) { el.textContent = msg; el.style.color = bad ? "var(--status-critical)" : ""; } };
    const state = document.getElementById("token-state");
    if (state) state.textContent = get() ? "token saved" : "no token";
    document.getElementById("save-token")?.addEventListener("click", () => {
      const v = document.getElementById("gh-token").value.trim();
      try { if (v) localStorage.setItem(tokenKey, v); else localStorage.removeItem(tokenKey); } catch {}
      document.getElementById("gh-token").value = "";
      state.textContent = v ? "token saved" : "token removed";
    });
    const api = async (path, method = "GET", body) => {
      const t = get();
      if (!t) throw new Error("Save a GitHub token first");
      const r = await fetch(`https://api.github.com/repos/${repo}/${path}`, { method, headers: { Authorization: `Bearer ${t}`, Accept: "application/vnd.github+json", "Content-Type": "application/json" }, body: body ? JSON.stringify(body) : undefined });
      if (!r.ok) throw new Error(`${method} ${path}: ${r.status} ${(await r.text()).slice(0, 120)}`);
      return r.status === 204 ? null : r.json();
    };
    document.getElementById("run-now")?.addEventListener("click", async () => {
      try { status("Starting…"); await api("actions/workflows/pipeline.yml/dispatches", "POST", { ref: "main" }); status("Run started. It takes 8 to 15 minutes; the site updates when it finishes."); }
      catch (e) { status(e.message, true); }
    });
    // Moderation: edit moderation.yaml's unpublish/pin lists and commit.
    const toB64 = (s) => btoa(unescape(encodeURIComponent(s)));
    const fromB64 = (s) => decodeURIComponent(escape(atob(s.replace(/\n/g, ""))));
    const listRe = (key) => new RegExp(`^${key}:\\s*(\\[[^\\]]*\\]|(?:\\n\\s*-\\s*.*)*)`, "m");
    function readList(yaml, key) {
      const m = yaml.match(listRe(key));
      if (!m) return [];
      const body = m[1].trim();
      if (body.startsWith("[")) return body.slice(1, -1).split(",").map((x) => x.trim().replace(/^["']|["']$/g, "")).filter(Boolean);
      return body.split("\n").map((l) => l.replace(/^\s*-\s*/, "").trim().replace(/^["']|["']$/g, "")).filter(Boolean);
    }
    function writeList(yaml, key, items) {
      const rendered = `${key}: [${items.map((i) => JSON.stringify(i)).join(", ")}]`;
      return yaml.match(listRe(key)) ? yaml.replace(listRe(key), rendered) : yaml + `\n${rendered}\n`;
    }
    document.querySelectorAll("[data-mod]").forEach((btn) => btn.addEventListener("click", async () => {
      const slug = btn.dataset.slug, action = btn.dataset.mod;
      if (action === "unpublish" && !confirm(`Unpublish "${slug}" on the next run?`)) return;
      try {
        status("Updating moderation.yaml…");
        const file = await api("contents/pipeline/digest/moderation.yaml");
        let yaml = fromB64(file.content);
        const key = action === "unpublish" ? "unpublish" : "pin";
        const list = readList(yaml, key);
        const idx = list.indexOf(slug);
        if (idx >= 0) list.splice(idx, 1); else list.push(slug);
        yaml = writeList(yaml, key, list);
        await api("contents/pipeline/digest/moderation.yaml", "PUT", { message: `admin: ${idx >= 0 ? "remove" : "add"} ${slug} in ${key}`, content: toB64(yaml), sha: file.sha });
        status(`${idx >= 0 ? "Removed from" : "Added to"} ${key}: ${slug}. Applied on the next run (or press "Run pipeline now").`);
        if (action === "pin") btn.textContent = idx >= 0 ? "Pin" : "Unpin";
      } catch (e) { status(e.message, true); }
    }));
    // Sortable sources table.
    document.querySelectorAll("table.sortable th[data-sort]").forEach((th) => th.addEventListener("click", () => {
      const key = th.dataset.sort, tbody = th.closest("table").querySelector("tbody");
      const dir = th.dataset.dir === "asc" ? "desc" : "asc"; th.dataset.dir = dir;
      const rows = [...tbody.querySelectorAll("tr")];
      const val = (tr) => tr.dataset[key.toLowerCase()] ?? "";
      const num = rows.every((r) => val(r) === "" || !isNaN(Number(val(r))));
      rows.sort((a, b) => { const x = val(a), y = val(b); const c = num ? Number(x || 0) - Number(y || 0) : String(x).localeCompare(String(y)); return dir === "asc" ? c : -c; });
      rows.forEach((r) => tbody.appendChild(r));
    }));
  </script>
</Base>
