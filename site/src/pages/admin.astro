  .share-btn:disabled { opacity: 0.6; cursor: progress; }
  .share-done.is-on { color: var(--status-good); border-color: var(--status-good); background: color-mix(in srgb, var(--status-good) 10%, var(--surface)); }
  .share-hint { margin: 6px 0 0; font-size: 12.5px; line-height: 1.45; color: var(--ink-3); }
