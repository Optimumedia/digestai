            <article class="card">
              <h2>Extraction quality by publisher <span class="muted">7 days</span></h2>
              <div class="legend">{exSeries.map((s) => <span><i style={`background:${s.color}`}></i>{s.label}</span>)}</div>
              <Fragment set:html={stackedBars(extraction.slice(0, 12), "domain", exSeries)} />
