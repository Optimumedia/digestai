        for (let i = 13; i >= 0; i--) days.push(new Date(Date.now() - i * 864e5).toISOString().slice(0, 10));
        const counts = Object.fromEntries(days.map((d) => [d, { linkedin: 0, x: 0, bluesky: Number(data.bluesky?.[d]) || 0 }]));
        for (const v of Object.values(stories)) for (const n of NETS) { const d = v?.[n]?.at?.slice(0, 10); if (d && counts[d]) counts[d][n]++; }
        const tot = { linkedin: 0, x: 0, bluesky: 0 };
