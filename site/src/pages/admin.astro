        const prev = since.prev;
        if (!prev || !Date.parse(prev.seen)) { el.textContent = "This is your first visit from this browser. Next time, this shows what changed in between."; return; }
        const stories = d.storyTimes.filter((t) => Date.parse(t) > Date.parse(prev.seen)).length;
        const dv = typeof prev.visitors === "number" ? visitors - prev.visitors : null;
        const seenIds = new Set(prev.cards || []);
        const fresh = d.cards.filter((c) => !seenIds.has(c.id) && c.level !== "info").length;
        const cleared = (prev.cards || []).filter((id) => !d.cards.some((c) => c.id === id)).length;
        const bits = [
          `<strong>${stories === 0 ? "no new stories" : stories === 1 ? "1 new story" : `${num(stories)} new stories`}</strong>`,
          dv == null ? "" : dv > 0 ? `<strong>${num(dv)} more visitor${dv > 1 ? "s" : ""}</strong>` : "no new visitors counted yet",
          fresh ? `<strong>${fresh} new alert${fresh > 1 ? "s" : ""}</strong>` : "no new alerts",
          cleared ? `${cleared} item${cleared > 1 ? "s" : ""} cleared` : "",
        ].filter(Boolean);
        el.innerHTML = `Since ${when(prev.seen)} (${ago(prev.seen)}): ${bits.join(" · ")}.`;
      }

      render();
      setInterval(render, 30000);
      document.addEventListener("visibilitychange", () => { if (!document.hidden) render(); });
    })();
  </script>
  <script is:inline define:vars={{ repo }}>
    // Tabs, remembered in the URL hash.
    const tabs = [...document.querySelectorAll(".tabs a[data-tab]")];
    const panels = [...document.querySelectorAll("section.tab[data-tab]")];
    function show(name) {
      if (!panels.some((p) => p.dataset.tab === name)) name = "today";
      panels.forEach((p) => (p.hidden = p.dataset.tab !== name));
      tabs.forEach((t) => t.setAttribute("aria-current", t.dataset.tab === name ? "page" : "false"));
    }
    show((location.hash || "#today").slice(1));
    addEventListener("hashchange", () => show(location.hash.slice(1)));
    document.querySelectorAll('a[href^="#"]').forEach((a) => a.addEventListener("click", (e) => { const n = a.getAttribute("href").slice(1); if (panels.some((p) => p.dataset.tab === n)) { e.preventDefault(); history.replaceState(null, "", "#" + n); show(n); window.scrollTo({ top: 0 }); } }));

    const tokenKey = "admin_gh_token";
    const get = () => { try { return localStorage.getItem(tokenKey) || ""; } catch { return ""; } };
    const status = (msg, bad) => { const el = document.getElementById("action-status"); if (el) { el.textContent = msg; el.style.color = bad ? "var(--status-critical)" : ""; } if (bad || !get()) { history.replaceState(null, "", "#settings"); show("settings"); } };
    const state = document.getElementById("token-state");
    if (state) state.textContent = get() ? "token saved" : "no token";
    document.getElementById("save-token")?.addEventListener("click", () => {
      const v = document.getElementById("gh-token").value.trim();
      try { if (v) localStorage.setItem(tokenKey, v); else localStorage.removeItem(tokenKey); } catch {}
      document.getElementById("gh-token").value = "";
      state.textContent = v ? "token saved" : "token removed";
    });
    const api = async (path, method = "GET", body) => {
      const t = get();
      if (!t) throw new Error("Save a GitHub token first (Settings tab)");
      const r = await fetch(`https://api.github.com/repos/${repo}/${path}`, { method, headers: { Authorization: `Bearer ${t}`, Accept: "application/vnd.github+json", "Content-Type": "application/json" }, body: body ? JSON.stringify(body) : undefined });
      if (!r.ok) throw new Error(`${method} ${path}: ${r.status} ${(await r.text()).slice(0, 120)}`);
      return r.status === 204 ? null : r.json();
    };
    const runNow = async () => {
      try { await api("actions/workflows/pipeline.yml/dispatches", "POST", { ref: "main" }); alert("Run started. It takes 8 to 15 minutes; the site updates when it finishes."); }
      catch (e) { status(e.message, true); }
    };
    document.getElementById("run-now")?.addEventListener("click", runNow);
    document.querySelectorAll("[data-run]").forEach((b) => b.addEventListener("click", runNow));
    // Pause a source: add "enabled: false" to its entry in sources.yaml; the fetcher skips it from the next run.
    function pauseInYaml(yaml, key) {
      const eol = yaml.includes("\r\n") ? "\r\n" : "\n";
      const lines = yaml.split(/\r?\n/);
      const esc = key.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      const start = lines.findIndex((l) => new RegExp(`^\\s*-\\s+key:\\s*["']?${esc}["']?\\s*(#.*)?$`).test(l));
      if (start < 0) return null;
      const indent = lines[start].indexOf("-") + 2;
      let end = start + 1;
      while (end < lines.length && lines[end].trim() && /^\s*/.exec(lines[end])[0].length >= indent) end++;
      const pad = " ".repeat(indent);
      for (let i = start + 1; i < end; i++) if (/^\s*enabled\s*:/.test(lines[i])) { lines[i] = `${pad}enabled: false`; return lines.join(eol); }
      lines.splice(start + 1, 0, `${pad}enabled: false`);
      return lines.join(eol);
    }
    document.querySelectorAll("[data-pause]").forEach((btn) => btn.addEventListener("click", async () => {
      const key = btn.dataset.pause, name = btn.dataset.name || key;
      if (!confirm(`Pause ${name}? It is skipped from the next run. To switch it back on, delete "enabled: false" under its entry in sources.yaml.`)) return;
      try {
        const file = await api("contents/pipeline/digest/sources.yaml");
        const yaml = pauseInYaml(fromB64(file.content), key);
        if (yaml == null) throw new Error(`Could not find the source "${key}" in sources.yaml`);
        await api("contents/pipeline/digest/sources.yaml", "PUT", { message: `admin: pause source ${key}`, content: toB64(yaml), sha: file.sha });
        btn.textContent = "Paused from the next run";
        btn.disabled = true;
      } catch (e) { status(e.message, true); }
    }));
    const toB64 = (s) => btoa(unescape(encodeURIComponent(s)));
    const fromB64 = (s) => decodeURIComponent(escape(atob(s.replace(/\n/g, ""))));
    const listRe = (key) => new RegExp(`^${key}:\\s*(\\[[^\\]]*\\]|(?:\\n\\s*-\\s*.*)*)`, "m");
    function readList(yaml, key) {
      const m = yaml.match(listRe(key)); if (!m) return [];
      const body = m[1].trim();
      if (body.startsWith("[")) return body.slice(1, -1).split(",").map((x) => x.trim().replace(/^["']|["']$/g, "")).filter(Boolean);
      return body.split("\n").map((l) => l.replace(/^\s*-\s*/, "").trim().replace(/^["']|["']$/g, "")).filter(Boolean);
    }
    function writeList(yaml, key, items) { const rendered = `${key}: [${items.map((i) => JSON.stringify(i)).join(", ")}]`; return yaml.match(listRe(key)) ? yaml.replace(listRe(key), rendered) : yaml + `\n${rendered}\n`; }
    document.querySelectorAll("[data-mod]").forEach((btn) => btn.addEventListener("click", async () => {
      const slug = btn.dataset.slug, action = btn.dataset.mod;
      if (action === "unpublish" && !confirm(`Unpublish "${slug}" on the next run?`)) return;
      try {
        const file = await api("contents/pipeline/digest/moderation.yaml");
        let yaml = fromB64(file.content);
        const key = action === "unpublish" ? "unpublish" : "pin";
        const list = readList(yaml, key); const idx = list.indexOf(slug);
        if (idx >= 0) list.splice(idx, 1); else list.push(slug);
        yaml = writeList(yaml, key, list);
        await api("contents/pipeline/digest/moderation.yaml", "PUT", { message: `admin: ${idx >= 0 ? "remove" : "add"} ${slug} in ${key}`, content: toB64(yaml), sha: file.sha });
        btn.textContent = action === "pin" ? (idx >= 0 ? "Pin" : "Unpin") : (idx >= 0 ? "Unpublish" : "Queued");
        btn.title = "Applied on the next run";
      } catch (e) { status(e.message, true); }
    }));
    const ntBtn = document.getElementById("notrack-toggle"), ntState = document.getElementById("notrack-state");
    const ntGet = () => { try { return JSON.parse(localStorage.getItem("notrack")) === true; } catch { return false; } };
    const ntRender = () => { const on = ntGet(); if (ntBtn) ntBtn.textContent = on ? "Count my visits again" : "Exclude this browser from counts"; if (ntState) ntState.textContent = on ? "This browser is excluded from reader counts." : "This browser is currently counted."; };
    ntBtn?.addEventListener("click", () => { try { localStorage.setItem("notrack", JSON.stringify(!ntGet())); } catch {} ntRender(); });
    ntRender();
    document.querySelectorAll("table.sortable th[data-sort]").forEach((th) => th.addEventListener("click", () => {
      const key = th.dataset.sort, tbody = th.closest("table").querySelector("tbody");
      const dir = th.dataset.dir === "asc" ? "desc" : "asc"; th.dataset.dir = dir;
      const rows = [...tbody.querySelectorAll("tr")];
      const val = (tr) => tr.dataset[key.toLowerCase()] ?? "";
      const num = rows.every((r) => val(r) === "" || !isNaN(Number(val(r))));
      rows.sort((a, b) => { const x = val(a), y = val(b); const c = num ? Number(x || 0) - Number(y || 0) : String(x).localeCompare(String(y)); return dir === "asc" ? c : -c; });
      rows.forEach((r) => tbody.appendChild(r));
    }));
  </script>
  <script is:inline define:vars={{ repo }}>
    // Share today: copy, open the network's own share page, and tick what went out. Ticks are written to
    // pipeline/digest/shared.json through GitHub's API with the token saved in Settings (the way Pin and
    // Unpublish edit moderation.yaml), so every device sees them and the pipeline drops shared stories
    // from the next day's list. Without a token they stay in this browser. Nothing here posts anything.
    (() => {
      const root = document.getElementById("share-today");
      const dataEl = document.getElementById("share-data");
      if (!root || !dataEl) return;
      const data = JSON.parse(dataEl.textContent || "null");
      if (!data) return;
      const FILE = data.file || "pipeline/digest/shared.json";
      const LOCAL = "admin_share_local";
      const NETS = ["linkedin", "x"];
      const NAME = { linkedin: "LinkedIn", x: "X" };
      const items = Object.fromEntries(data.items.map((i) => [String(i.id), i]));
      const token = () => { try { return localStorage.getItem("admin_gh_token") || ""; } catch { return ""; } };
      const readLocal = () => { try { return JSON.parse(localStorage.getItem(LOCAL) || "{}").stories || {}; } catch { return {}; } };
      const writeLocal = (s) => { try { localStorage.setItem(LOCAL, JSON.stringify({ stories: s })); } catch {} };
      const toB64 = (s) => btoa(unescape(encodeURIComponent(s)));
      const fromB64 = (s) => decodeURIComponent(escape(atob(s.replace(/\n/g, ""))));
      const nowIso = () => new Date().toISOString().replace(/\.\d+Z$/, "Z");

      // What the pipeline knew at build time, then whatever this browser or the repo says since.
      let stories = {};
      for (const it of data.items) if (it.done && Object.keys(it.done).length) stories[it.id] = { slug: it.slug, ...it.done };
      let mode = "local"; // "repo" once shared.json has been read with the token
      let storeNote = "";

      function apply(obj, id, net, rec) {
        const key = String(id);
        if (rec) obj[key] = { ...(obj[key] && typeof obj[key] === "object" ? obj[key] : {}), slug: items[key]?.slug || obj[key]?.slug, [net]: rec };
        else if (obj[key]) { delete obj[key][net]; if (!NETS.some((n) => obj[key][n])) delete obj[key]; }
      }
      function prune(obj) {
        const cutoff = new Date(Date.now() - 120 * 864e5).toISOString();
        for (const [k, v] of Object.entries(obj)) if (!v || typeof v !== "object" || !NETS.some((n) => v[n]?.at && v[n].at >= cutoff)) delete obj[k];
      }
      async function gh(path, method = "GET", body) {
        const r = await fetch(`https://api.github.com/repos/${repo}/${path}`, { method, cache: "no-store",
          headers: { Authorization: `Bearer ${token()}`, Accept: "application/vnd.github+json", "Content-Type": "application/json" },
          body: body ? JSON.stringify(body) : undefined });
        if (!r.ok) { const e = new Error(`GitHub ${r.status}: ${(await r.text()).slice(0, 100)}`); e.status = r.status; throw e; }
        return r.json();
      }
      async function readFile() {
        try {
          const f = await gh(`contents/${FILE}?ref=main`);
          const json = JSON.parse(fromB64(f.content));
          return { sha: f.sha, json: json && typeof json === "object" ? json : {} };
        } catch (e) {
          if (e.status === 404) return { sha: null, json: {} };
          throw e;
        }
      }

      // ---- rendering
      const weekCounts = () => {
        const cutoff = new Date(Date.now() - 7 * 864e5).toISOString().slice(0, 19);
        const out = { linkedin: 0, x: 0 };
        for (const v of Object.values(stories)) for (const n of NETS) if (v?.[n]?.at && v[n].at.slice(0, 19) >= cutoff) out[n]++;
        // Before the repo is read, the pipeline's own count covers shares older than today's list.
