        for (const ch of part) { const c = ch.codePointAt(0); n += c <= 4351 || (c >= 8192 && c <= 8205) || (c >= 8208 && c <= 8223) || (c >= 8242 && c <= 8247) ? 1 : 2; }
        return n;
      }, 0);
      const countX = (li) => {
        const box = li.querySelector('[data-text="x"]'), out = li.querySelector("[data-count]");
        const n = xLength(box.value);
        out.textContent = `${n} of 280 characters (a link counts as 23)${n > 280 ? `: ${n - 280} over, shorten it` : ""}`;
        out.classList.toggle("bad", n > 280);
      };
      async function copy(text) {
        try { await navigator.clipboard.writeText(text); return true; } catch {}
        const ta = document.createElement("textarea");
        ta.value = text; ta.setAttribute("readonly", ""); ta.style.position = "fixed"; ta.style.opacity = "0";
        document.body.appendChild(ta); ta.select();
        let ok = false; try { ok = document.execCommand("copy"); } catch {}
        ta.remove();
        return ok;
      }
      // Admin pages only open by the page's number: the public name (digestai-news) gives an error there.
      const LINKEDIN_PAGE_COMPOSER = "https://www.linkedin.com/company/111764730/admin/page-posts/published/?share=true";
      const storyLink = (text, fallback) => (text.match(/https?:\/\/\S+/g) || []).find((u) => u.includes("/story/")) || fallback;
      const intentUrl = (net, text, item) => {
        // The company page's own post box: whoever administers the page posts as Digest AI, not as themselves.
        if (net === "linkedin") return LINKEDIN_PAGE_COMPOSER;
        const link = storyLink(text, item.links.x);
        const body = text.replace(link, "").replace(/[ \t]+$/gm, "").replace(/\n{3,}/g, "\n\n").trim();
        return `https://x.com/intent/post?text=${encodeURIComponent(body)}&url=${encodeURIComponent(link)}`;
      };
      window.__shareIntentUrl = intentUrl; // for checking the built links from the console
      // Your own profile: LinkedIn fills the post box from shareActive + text (a company page has no such link).
      const personalLinkedIn = (text) => `https://www.linkedin.com/feed/?shareActive=true&text=${encodeURIComponent(text)}`;

      root.querySelectorAll(".share-item").forEach((li) => {
        const item = items[li.dataset.shareId];
        li.querySelectorAll("[data-tab-net]").forEach((tab) => tab.addEventListener("click", () => {
          li.querySelectorAll("[data-tab-net]").forEach((t) => t.setAttribute("aria-selected", t === tab ? "true" : "false"));
          li.querySelectorAll("[data-pane]").forEach((p) => (p.hidden = p.dataset.pane !== tab.dataset.tabNet));
        }));
        li.querySelector('[data-text="x"]').addEventListener("input", () => countX(li));
        countX(li);
        li.querySelectorAll("[data-copy]").forEach((b) => b.addEventListener("click", async () => {
          const ok = await copy(li.querySelector(`[data-text="${b.dataset.copy}"]`).value);
          say(li, ok ? "Copied." : "Could not copy: select the text and copy it by hand.", !ok);
        }));
        li.querySelectorAll("[data-open]").forEach((b) => b.addEventListener("click", () => {
          const net = b.dataset.open, text = li.querySelector(`[data-text="${net}"]`).value;
          // Start the copy inside the click (browsers only allow it there), then open the network.
          const copied = net === "linkedin" ? copy(text) : null;
          window.open(intentUrl(net, text, item), "_blank", "noopener");
          if (copied) copied.then((ok) => say(li, ok ? "Copied. LinkedIn cannot fill in a page post from another site: in the page's post box (Start a post if it is not open) press Ctrl+V (phone: long-press, Paste), then post and tick Mark done." : "Could not copy the text: use Copy text, then paste it into LinkedIn.", !ok));
          else say(li, "X opened with the text and link filled in. Tick Mark done once it is live.");
        }));
        li.querySelector("[data-share-fold]").addEventListener("click", () => { li.classList.toggle("is-open"); render(); });
        li.querySelector("[data-open-personal]")?.addEventListener("click", () => {
          const copied = copy(li.querySelector('[data-text="linkedin"]').value);
          window.open(personalLinkedIn(li.querySelector('[data-text="linkedin"]').value), "_blank", "noopener");
          copied.then((ok) => say(li, ok ? "LinkedIn opens with the post filled in. If the box is empty, press Ctrl+V (on a phone: long-press, Paste)." : "LinkedIn opens with the post filled in; if it is empty, use Copy text.", false));
        });
        li.querySelectorAll("[data-done]").forEach((b) => b.addEventListener("click", () => {
          const net = b.dataset.done, id = li.dataset.shareId, done = stories[id]?.[net];
          if (done) { if (confirm(`Mark "${item.slug}" as not shared on ${NAME[net]}?`)) save(li, net, null); return; }
          const url = li.querySelector(`[data-post-url="${net}"]`).value.trim();
          save(li, net, { at: nowIso(), url: /^https:\/\//.test(url) ? url : "" });
        }));
        li.querySelectorAll("[data-post-url]").forEach((input) => input.addEventListener("change", () => {
          const net = input.dataset.postUrl, done = stories[li.dataset.shareId]?.[net], url = input.value.trim();
          if (url && !/^https:\/\//.test(url)) { say(li, "The link should start with https://", true); return; }
          if (done && url !== (done.url || "")) save(li, net, { ...done, url });
        }));
      });

      // ---- where ticks live: the repo with a token, else this browser
      const local = readLocal();
      stories = { ...stories, ...local };
      if (!token()) {
        storeNote = 'No GitHub token in this browser, so ticks are kept here only and tomorrow\'s list will not know about them. <a href="#settings">Add the token in Settings</a>.';
        render();
        return;
      }
      storeNote = "Reading your ticks from the repo…";
      render();
      readFile().then((f) => {
        mode = "repo";
        const repoStories = f.json.stories && typeof f.json.stories === "object" ? f.json.stories : {};
        const onlyHere = Object.keys(local).filter((k) => items[k] && !repoStories[k]);
        stories = { ...local, ...repoStories };
        storeNote = `Ticks are saved to the repo (${FILE}), so every device sees them.${onlyHere.length ? ` ${onlyHere.length} tick${onlyHere.length > 1 ? "s were" : " was"} made in this browser without the token; tick again to save ${onlyHere.length > 1 ? "them" : "it"} to the repo.` : ""}`;
        render();
      }).catch((e) => {
        storeNote = `Could not read ${FILE} from GitHub (${e.message}), so ticks are kept in this browser for now.`;
        render();
      });
    })();
  </script>
<script is:inline>
  // "Request indexing" and other links that carry a page address: copy it on the way out, so it can
  // be pasted into Search Console's inspect bar.
  document.addEventListener("click", (e) => {
    const a = e.target.closest?.("a[data-copy-url]");
    if (!a || !navigator.clipboard) return;
    navigator.clipboard.writeText(a.dataset.copyUrl).then(() => {
      a.dataset.label = a.dataset.label || a.textContent;
      a.textContent = "Address copied ↗";
      setTimeout(() => { a.textContent = a.dataset.label; }, 4000);
    }).catch(() => {});
  });
</script>
<script is:inline>
  // Share tab, "Source image": the picture's real size once it loads, and a Download that works where
  // the publisher allows it. A cross-origin <a download> is ignored by browsers, so the click first tries
  // to fetch the picture (only possible when the site sends CORS headers) and saves it from a blob;
  // otherwise the picture opens in a new tab, with a hint to save it from there.
  document.querySelectorAll(".share-src-item").forEach((fig) => {
    const img = fig.querySelector("[data-src-img]"), size = fig.querySelector("[data-src-size]");
    const show = () => { size.textContent = img.naturalWidth ? `Size: ${img.naturalWidth} × ${img.naturalHeight} px${img.naturalWidth >= 1200 ? "" : " (small for a post)"}` : "Size: unknown"; };
    img.addEventListener("load", show);
    img.addEventListener("error", () => { size.textContent = "Could not load the picture: it may have moved."; });
    if (img.complete && img.naturalWidth) show();
    const dl = fig.querySelector("[data-src-dl]"), hint = fig.querySelector("[data-src-hint]");
    dl.addEventListener("click", async (e) => {
      if (dl.dataset.fallback) return; // already known: let the link open the picture in a new tab
      e.preventDefault();
      const ext = (dl.href.split("?")[0].match(/\.(jpe?g|png|webp|gif|avif)$/i) || [, "jpg"])[1].toLowerCase();
      try {
        const ctl = new AbortController();
        const timer = setTimeout(() => ctl.abort(), 4000); // stay inside the click's window for window.open
        const r = await fetch(dl.href, { mode: "cors", credentials: "omit", referrerPolicy: "no-referrer", signal: ctl.signal });
        clearTimeout(timer);
        if (!r.ok) throw new Error(`HTTP ${r.status}`);
        const blob = await r.blob();
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = `${dl.getAttribute("download") || "source-image"}.${ext}`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(a.href), 10000);
      } catch {
        dl.dataset.fallback = "1";
        hint.hidden = false;
        window.open(dl.href, "_blank", "noopener,noreferrer");
      }
    });
  });
</script>
