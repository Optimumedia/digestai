                <div class="tile"><span class="label">Read by the latest run</span><span class="value">{kb(dbReads.latestRunKB)}</span><span class="sub">{dbReads.runsAveraged ? `average ${kb(dbReads.avgRunKB)} over ${dbReads.runsAveraged} run${dbReads.runsAveraged === 1 ? "" : "s"}` : "no run measured yet"}</span></div>
