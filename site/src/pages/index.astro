---
import Base from "../layouts/Base.astro";
import StoryRow from "../components/StoryRow.astro";
import Coverage from "../components/Coverage.astro";
import Rail from "../components/Rail.astro";
import ListenPlayer from "../components/ListenPlayer.astro";
import { briefing, briefingStories, storiesByDay, storiesInCategory, plain, firstSentence, categories, meta, formatDate, dateTime, shortDate, episodes } from "../lib/data";

const lead = briefingStories[0];
const rest = briefingStories.slice(1);
const briefingIds = new Set(briefingStories.map((s) => s.id));
// Marketing & Small Business is a top focus: its latest week of stories get their own block under the
// briefing, and are not repeated in the day lists below.
const weekAgo = Date.parse(meta.generatedAt) - 7 * 24 * 3600 * 1000;
const focusStories = storiesInCategory("marketing")
  .filter((s) => !briefingIds.has(s.id) && Date.parse(s.firstPublishedAt || s.updatedAt || "0") >= weekAgo)
  .slice(0, 5);
const shownIds = new Set([...briefingIds, ...focusStories.map((s) => s.id)]);
const episode = episodes[0];
const episodeIsToday = episode?.date === briefing.date;
const days = [...storiesByDay().entries()].slice(0, 4);
const today = new Date().toISOString().slice(0, 10);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Digest AI",
  url: meta.siteUrl,
  potentialAction: { "@type": "SearchAction", target: `${meta.siteUrl}/search?q={search_term_string}`, "query-input": "required name=search_term_string" },
};
---

<Base title="Digest AI" jsonLd={jsonLd}>
  <div class="grid">
    <div>
      {lead && (
        <section class="briefing" aria-labelledby="briefing-h">
          <div class="briefing-head">
            <div class="briefing-title">
              <span class="eyebrow briefing-date">{formatDate(briefing.date + "T12:00:00Z", { weekday: "long", day: "numeric", month: "long" })} · updated <time datetime={briefing.generatedAt}>{dateTime(briefing.generatedAt)}</time></span>
              <h2 id="briefing-h">Today's briefing</h2>
              <span class="eyebrow briefing-stats">{briefing.stats.stories} stories · {briefing.stats.articles} articles · {briefing.stats.minutes} min read <span class="new-count" id="new-count" hidden></span></span>
            </div>
            <div class="briefing-actions">
              <a class="eyebrow more" href="/today">Read the briefing →</a>
            </div>
          </div>
          {episode && (
            <ListenPlayer
              episode={episode}
              heading={episodeIsToday ? "Listen to today's briefing" : "Listen to the latest briefing"}
              note={episodeIsToday ? `The top ${episode.stories.length} stories, read aloud in ${Math.max(1, Math.round(episode.seconds / 60))} minutes. Press play and keep browsing.` : undefined}
            />
          )}
          <article class="hero" data-published={lead.updatedAt}>
            <div>
              <div class="meta-row">
                <a class:list={["chip", { hot: lead.importance >= 8 }]} href={`/category/${lead.category}`}>{categories[lead.category || ""] || "AI"}</a>
                <time datetime={lead.firstPublishedAt || lead.updatedAt || undefined}>{shortDate(lead.firstPublishedAt || lead.updatedAt)}</time>
                <span class="new-badge">new</span>
              </div>
              <h1><a href={`/story/${lead.slug}`}>{lead.headline}</a></h1>
              <p>{plain(lead.summaryMd, 320)}</p>
              <Coverage story={lead} />
            </div>
            {lead.imageUrl && (
              <a class="thumb" href={`/story/${lead.slug}`} tabindex="-1" aria-hidden="true">
                <img src={lead.imageUrl} alt="" loading="eager" fetchpriority="high" referrerpolicy="no-referrer" onerror="this.parentElement.style.display='none'" />
              </a>
            )}
          </article>
          <ol class="briefing-list" start="2">
            {rest.map((s) => (
              <li data-published={s.updatedAt}>
                <div class="meta-row">
                  <a class="chip" href={`/category/${s.category}`}>{categories[s.category || ""] || "AI"}</a>
                  <time datetime={s.firstPublishedAt || s.updatedAt || undefined}>{shortDate(s.firstPublishedAt || s.updatedAt)}</time>
                  <span class="new-badge">new</span>
                </div>
                <h3><a href={`/story/${s.slug}`}>{s.headline}</a></h3>
                <p>{firstSentence(s.summaryMd || s.keyPoints[0], 170)}</p>
                <Coverage story={s} compact={true} />
              </li>
            ))}
          </ol>
        </section>
      )}

      {focusStories.length > 0 && (
        <section class="focus" aria-labelledby="focus-h">
          <div class="dayhead">
            <h2 id="focus-h">For marketers &amp; small businesses</h2>
            <a class="eyebrow" href="/category/marketing">Practical AI →</a>
          </div>
          <ol class="river">
            {focusStories.map((s) => <StoryRow story={s} />)}
          </ol>
        </section>
      )}

      <section id="your-topics" class="your-topics" hidden>
        <div class="dayhead">
          <h2>Your topics</h2>
          <span class="eyebrow topic-names"></span>
        </div>
        <ol class="river"></ol>
      </section>

      {days.length === 0 && <p class="muted" style="padding: 40px 0">No stories yet. The pipeline publishes its first run within 30 minutes.</p>}

      {days.map(([day, list], i) => (
        <section>
          <div class="dayhead">
            <h2>{day === today ? "More today" : formatDate(day + "T00:00:00Z", { weekday: "long", day: "numeric", month: "long" })}</h2>
            <a class="eyebrow" href={`/daily/${day}`}>{list.length} stories →</a>
          </div>
          <ol class="river">
            {list.filter((s) => !shownIds.has(s.id)).slice(0, i === 0 ? 14 : 8).map((s) => <StoryRow story={s} />)}
          </ol>
        </section>
      ))}
    </div>
    <Rail exclude={lead?.id} />
  </div>
</Base>
