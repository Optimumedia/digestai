---
import Base from "../../layouts/Base.astro";
import StoryRow from "../../components/StoryRow.astro";
import Rail from "../../components/Rail.astro";
import { topicPages, storiesForEntity } from "../../lib/data";

export function getStaticPaths() {
  return topicPages().map(({ slug, entity }) => ({ params: { slug }, props: { entity } }));
}

const { slug } = Astro.params;
const { entity } = Astro.props;
const list = storiesForEntity(entity);
const kindLabel = { companies: "Company", models: "Model", people: "Person" }[entity.kind] || "Topic";
const follow = JSON.stringify({ kind: "topic", slug, name: entity.name });
const latestHeads = list.slice(0, 3).map((s) => s.headline).join("; ");
const description = `${entity.name} in the AI news, ${list.length} ${list.length === 1 ? "story" : "stories"} with sources and discussion. Latest: ${latestHeads}`.slice(0, 300);
const ogImage = list.length >= 3 ? `/og/topic-${slug}.png` : "/og-default.png";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${entity.name} news`,
  description,
  about: { "@type": entity.kind === "people" ? "Person" : entity.kind === "companies" ? "Organization" : "Thing", name: entity.name },
  hasPart: list.slice(0, 20).map((s) => ({ "@type": "NewsArticle", headline: s.headline, url: `https://digestai.news/story/${s.slug}`, datePublished: s.firstPublishedAt })),
};
---

<Base title={`${entity.name} news`} description={description} image={`https://digestai.news${ogImage}`} jsonLd={jsonLd}>
  <div class="grid">
    <div>
      <header class="page-head">
        <div class="eyebrow">{kindLabel}</div>
        <div class="head-row">
          <h1>{entity.name}</h1>
          <button class="follow" data-follow={follow} aria-pressed="false">Follow</button>
        </div>
        <p>{list.length} {list.length === 1 ? "story" : "stories"} mentioning {entity.name}, newest first. Follow to see new ones on your front page.</p>
      </header>
      <ol class="river">{list.map((s) => <StoryRow story={s} />)}</ol>
    </div>
    <Rail />
  </div>
</Base>
