---
import Base from "../../layouts/Base.astro";
import StoryRow from "../../components/StoryRow.astro";
import Rail from "../../components/Rail.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { categories, storiesInCategory, storyModified, meta } from "../../lib/data";
import { categoryCopy, categoryWeek, weekSummary, keyTopics, byImportance, clip, newsLabel, plural } from "../../lib/category";

export function getStaticPaths() {
  return Object.entries(categories).map(([category, name]) => ({ params: { category }, props: { name } }));
}

const { category } = Astro.params;
const { name } = Astro.props;
const copy = categoryCopy(category!, name);
const list = storiesInCategory(category!);
// The page's own text, all from the export (lib/category.ts): a fixed introduction, then this week's
// biggest stories in plain sentences, the names they mention most, the most important stories, and
// the full list under them.
const week = categoryWeek(category!);
const summary = weekSummary(week);
const top = (week.length >= 3 ? week : [...list.slice(0, 30)].sort(byImportance)).slice(0, 5);
const topIds = new Set(top.map((s) => s.id));
const rest = list.filter((s) => !topIds.has(s.id));
const topics = keyTopics(week.length >= 3 ? week : list.slice(0, 30));
// Unique per category, and it names this week's lead story: "<category> AI news this week: <headline>".
const title = summary ? `${newsLabel(copy)} this week: ${clip(summary.lead.headline, 56)}` : `${newsLabel(copy)}: the latest stories`;
const description = summary
  ? `${copy.blurb} This week: ${plural(summary.count, "story", "stories")}, led by ${clip(summary.lead.headline, 90)}.`
  : `${copy.blurb} ${list.length} stories with their sources.`;
const modified = list.map((s) => storyModified(s)).filter(Boolean).sort().pop();
const follow = JSON.stringify({ kind: "category", slug: category, name });
const site = meta.siteUrl;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: copy.h1,
  headline: title,
  description: copy.intro || copy.blurb,
  url: `${site}/category/${category}`,
  inLanguage: "en",
  ...(modified ? { dateModified: modified } : {}),
  isPartOf: { "@type": "WebSite", name: "Digest AI", url: site },
  about: topics.map((t) => ({ "@type": "Thing", name: t.name })),
  mainEntity: {
    "@type": "ItemList",
    name: `${copy.h1}: the most important stories, then the latest`,
    itemListOrder: "https://schema.org/ItemListUnordered",
    numberOfItems: Math.min(20, top.length + rest.length),
    itemListElement: [...top, ...rest].slice(0, 20).map((s, i) => ({ "@type": "ListItem", position: i + 1, url: `${site}/story/${s.slug}`, name: s.headline })),
  },
};
---

<Base title={title} description={description} currentCategory={category} jsonLd={jsonLd} modifiedAt={modified}>
  <link slot="head" rel="alternate" type="application/rss+xml" title={`Digest AI: ${name}`} href={`${site}/feeds/category/${category}.xml`} />
  <div class="grid">
    <div>
      <Breadcrumbs items={[{ name }]} />
      <header class="page-head">
        <div class="eyebrow">Category · {name}</div>
        <div class="head-row">
          <h1>{copy.h1}</h1>
          <button class="follow" data-follow={follow} aria-pressed="false">Follow</button>
        </div>
        {copy.intro ? <p class="intro">{copy.intro}</p> : <p>{copy.blurb}</p>}
      </header>

      {summary && (
        <section class="cat-week" aria-labelledby="week-h">
          <div class="dayhead"><h2 id="week-h">This week in {name}</h2><span class="eyebrow">seven days to {summary.until}</span></div>
          <p>
            {summary.count === 1
              ? `One ${name} story this week. `
              : `${plural(summary.count, "story", "stories").replace(/ /, ` ${name} `)} this week, from ${plural(summary.publishers, "publisher", "publishers")}. `}
            {summary.count === 1 ? "It is " : "The biggest: "}<a href={`/story/${summary.lead.slug}`}>{summary.lead.headline}</a>.
            {summary.leadPoint && ` ${summary.leadPoint}`}
            {summary.leadWhy && ` ${summary.leadWhy}`}
            {summary.also.length > 0 && " Also this week: "}
            {summary.also.map((s, i) => (
              <>{i > 0 && (i === summary.also.length - 1 ? " and " : "; ")}<a href={`/story/${s.slug}`}>{s.headline}</a>{i === summary.also.length - 1 && "."}</>
            ))}
          </p>
        </section>
      )}

      {topics.length > 0 && (
        <section class="cat-topics" aria-labelledby="topics-h">
          <div class="dayhead"><h2 id="topics-h">Key topics</h2><span class="eyebrow">{week.length >= 3 ? "most mentioned this week" : "most mentioned lately"}</span></div>
          <div class="taglist">
            {topics.map((t) => (t.href ? <a href={t.href}>{t.name} <span class="mono muted">{t.count}</span></a> : <span>{t.name} {t.count}</span>))}
          </div>
        </section>
      )}

      {top.length > 0 && (
        <section aria-labelledby="top-h">
          <div class="dayhead"><h2 id="top-h">Most important</h2><span class="eyebrow">{week.length >= 3 ? "this week, by importance" : "recent, by importance"}</span></div>
          <ol class="river">{top.map((s) => <StoryRow story={s} />)}</ol>
        </section>
      )}

      {list.length === 0 && <p class="muted" style="padding: 24px 0">Nothing here yet.</p>}
      {rest.length > 0 && (
        <section aria-labelledby="all-h">
          <div class="dayhead"><h2 id="all-h">All {name} stories</h2><span class="eyebrow">newest first</span></div>
          <ol class="river">{rest.slice(0, 55).map((s) => <StoryRow story={s} />)}</ol>
        </section>
      )}
    </div>
    <Rail />
  </div>
</Base>
