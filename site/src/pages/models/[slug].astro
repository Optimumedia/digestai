---
/* One page per tracked model (/models/<slug>): what it is, who makes it, how you get it, the licence
   and context window when the coverage stated them, and every story about it. This is the model's
   only indexable address: the topic hub under the same slug redirects here (topic/[slug].astro).
   A model with nothing but its launch story and no spec is built but noindex (indexing.mjs).
   The facts are a question-and-answer block (data.ts modelQuickFacts), repeated as FAQPage data: a
   question is there only when the tracker holds its answer. The page lists the newest 60 stories;
   older ones are on numbered pages (models/[slug]/[page].astro), noindex and out of the sitemap. */
import Base from "../../layouts/Base.astro";
import StoryRow from "../../components/StoryRow.astro";
import Rail from "../../components/Rail.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Pager from "../../components/Pager.astro";
import { modelPageList, modelPageIndexable, modelsByLab, modelStories, modelQuickFacts, topicInfo, hubHref, formatDate, dateTime, meta, type ModelPage } from "../../lib/data";
import { pageSlice } from "../../lib/paging";

export function getStaticPaths() {
  return modelPageList.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: ModelPage };
const { slug, name, rows } = page;
const fact = rows[0];
const list = modelStories(page);
const shown = pageSlice(list, 1);
const base = `/models/${slug}`;
const firstSeen = rows.map((r) => r.date).filter(Boolean).sort()[0] || list[list.length - 1]?.firstPublishedAt || null;
// Specs can come from any of the model's rows: the newest row wins, older ones fill the gaps.
const pick = <K extends "license" | "context" | "link" | "lab">(k: K) => rows.find((r) => r[k])?.[k] || null;
const lab = pick("lab");
const license = pick("license");
const context = pick("context");
const link = pick("link");
const availabilityKey = rows.find((r) => r.availability && r.availability !== "unknown")?.availability || null;
const updated = [...list.map((s) => s.updatedAt), ...rows.map((r) => r.date)].filter(Boolean).sort().pop() || meta.generatedAt;
const siblings = modelsByLab(lab, name).filter((m) => m.name !== name);

const kinds: Record<string, string> = { llm: "language model", multimodal: "multimodal model", image: "image model", video: "video model", audio: "audio model", code: "coding model", embedding: "embedding model", robotics: "robotics model", other: "AI model" };
const availability: Record<string, string> = { api: "through an API", open_weights: "as open weights you can download and run", consumer: "in a consumer app", research: "as a research release" };
const kind = kinds[fact.kind] || "AI model";
const intro = topicInfo[slug]?.description || "";
const templated = /^\d+ stor(y|ies) since /.test(intro);
const plural = (n: number, w: string, ws = `${w}s`) => `${n} ${n === 1 ? w : ws}`;

// The plain-English summary is built from the tracker's own fields, so it only says what is known.
const lede = [
  `${name} is ${/^[aeiou]/i.test(kind) ? "an" : "a"} ${kind}${lab ? ` from ${lab}` : ""}${firstSeen ? `, first covered on ${formatDate(firstSeen)}` : ""}.`,
  availabilityKey && availability[availabilityKey] ? `It is available ${availability[availabilityKey]}${license ? ` (licence: ${license})` : ""}.` : license ? `Licence: ${license}.` : "",
  context ? `Its context window is ${context}.` : "",
].filter(Boolean).join(" ");
const facts = modelQuickFacts(page);
const specWords = [context && "context window", license && "licence"].filter(Boolean) as string[];
const title = `${name}: release${specWords.length ? `, ${specWords.join(", ")}` : ""} and news`;
const description = `${lede} ${plural(list.length, "story", "stories")} with sources on Digest AI.`.slice(0, 300);
const ogImage = page.hubStories >= 3 ? `${meta.siteUrl}/og/topic-${slug}.png` : undefined;
const follow = JSON.stringify({ kind: "topic", slug, name });
const url = `${meta.siteUrl}${base}`;

const jsonLd: Record<string, unknown>[] = [{
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url,
  dateModified: updated,
  isPartOf: { "@type": "WebSite", name: "Digest AI", url: meta.siteUrl },
  about: { "@type": "Thing", name, ...(link ? { sameAs: link } : {}) },
  mainEntity: {
    "@type": "ItemList",
    name: `News about ${name}`,
    numberOfItems: list.length,
    itemListElement: shown.items.slice(0, 50).map((s, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "NewsArticle",
        headline: s.headline,
        url: `${meta.siteUrl}/story/${s.slug}`,
        datePublished: s.firstPublishedAt,
        dateModified: s.updatedAt,
      },
    })),
  },
}];
if (facts.length) {
  jsonLd.push({ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: facts.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) });
}
---

<Base title={title} description={description} image={ogImage} jsonLd={jsonLd} thin={!modelPageIndexable(page)}>
  <div class="grid">
    <div>
      <Breadcrumbs items={[{ name: "Models", href: "/models" }, { name }]} />
      <header class="page-head">
        <div class="eyebrow">Model · {kind}</div>
        <div class="head-row">
          <h1>{name}</h1>
          <button class="follow" data-follow={follow} aria-pressed="false">Follow</button>
        </div>
        {intro && !templated && <p class="intro">{intro}</p>}
        <p>{lede}</p>
        <p class="mono muted">Last updated <time datetime={updated} data-static>{dateTime(updated)}</time></p>
      </header>

      {facts.length > 0 && (
        <section class="factbox quickfacts" aria-labelledby="facts-h">
          <h2 id="facts-h">Quick facts</h2>
          <dl>
            {facts.map((f) => (
              <div>
                <dt>{f.q}</dt>
                <dd>
                  {f.a}
                  {f.href && f.linkText && (
                    f.external
                      ? <> <a href={f.href} rel="noopener nofollow" target="_blank">{f.linkText} ↗</a></>
                      : <> <a href={f.href}>{f.linkText} →</a></>
                  )}
                </dd>
              </div>
            ))}
          </dl>
          <p class="muted">
            Taken from the coverage, not from our own testing. A question is left out when none of the reports we read gave the answer.
            {rows.length > 1 && ` Tracked ${rows.length} times (new versions or re-launches).`}
            {" "}<a href="/models">All tracked models →</a>
          </p>
        </section>
      )}

      <div class="dayhead"><h2>{plural(list.length, "story", "stories")} about {name}</h2>{shown.pages > 1 && <span class="eyebrow">newest {shown.items.length}</span>}</div>
      <ol class="river">{shown.items.map((s) => <StoryRow story={s} />)}</ol>
      <Pager base={base} page={1} pages={shown.pages} />

      {siblings.length > 0 && (
        <section style="margin-top: 28px">
          <div class="eyebrow" style="margin-bottom: 8px">Other models from {lab}</div>
          <div class="taglist">{siblings.map((m) => { const href = hubHref(m.name); return href ? <a href={href}>{m.name}</a> : <span>{m.name}</span>; })}</div>
        </section>
      )}
    </div>
    <Rail />
  </div>
</Base>
