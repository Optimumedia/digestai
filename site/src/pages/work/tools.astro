---
import Work from "../../layouts/Work.astro";
import { WORK_MIN_ITEMS, formatDate, meta, topicInfo } from "../../lib/data";
import { COST_LABELS, JOBS, JOB_LABELS, toolSlug, whoLine, work } from "../../lib/work";

const rows = work.tools;
const intro = topicInfo["page-work-directory"]?.description || "";
const jobs = JOBS.map((j) => ({ ...j, count: rows.filter((r) => r.jobs.includes(j.key)).length })).filter((j) => j.count > 0);
const free = rows.filter((r) => ["free", "free tier", "included"].includes(r.costKind || "")).length;
const description = `${rows.length} AI tools for marketing, sales, support and running a small business, with what each one does, who it is for, what it costs and what changed last.`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "AI tools for marketing and small business",
  description,
  numberOfItems: rows.length,
  itemListElement: rows.slice(0, 100).map((r, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "SoftwareApplication",
      name: r.tool,
      applicationCategory: "BusinessApplication",
      description: r.whatItDoes,
      url: r.link || `${meta.siteUrl}/work/tools#${toolSlug(r)}`,
      ...(r.maker ? { author: { "@type": "Organization", name: r.maker } } : {}),
    },
  })),
};
---

<Work title="AI tools for marketing and small business" description={description} current="tools" jsonLd={jsonLd} thin={rows.length < WORK_MIN_ITEMS}>
  <header class="page-head work-head">
    <div class="eyebrow">Directory · {rows.length} tools</div>
    <h1>AI tools for marketing and small business</h1>
    {intro && <p class="intro">{intro}</p>}
    <p>
      Every tool the desk has covered that a marketer, a small-business owner or a small team can use, newest change
      first. The entries are built from the news, so this is a record of what changed and when, not a review:
      nothing here has been tested by us, the prices are the ones the coverage stated, and the caveat on each row is
      the one the reporting gave. Check the price on the maker's own page before you commit.
    </p>
  </header>

  {rows.length === 0 && (
    <p class="muted" style="padding: 32px 0">
      No tools recorded yet. Rows appear as the desk covers tools a small team can use.
    </p>
  )}

  {rows.length > 0 && (
    <>
      <p class="mono muted work-note">
        {free} of {rows.length} can be started without paying{jobs.length > 0 && <> · {jobs.map((j, i) => <>{i > 0 && " · "}<a href={`/work/${j.slug}`}>{j.count} {j.label.toLowerCase()}</a></>)}</>}
      </p>
      <p class="workjob-pages">
        By job: {JOBS.map((j, i) => <>{i > 0 && " · "}<a href={`/work/${j.slug}`}>AI tools {j.task}</a></>)}
      </p>
      <div class="tablewrap">
        <table class="tracker">
          <thead>
            <tr><th>Tool</th><th>Maker</th><th>What it does</th><th>Who for</th><th>Cost</th><th>Effort</th><th>Last change</th><th>Official</th></tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td><b><a href={`#${toolSlug(r)}`}>{r.tool}</a></b></td>
                <td>{r.maker || ""}</td>
                <td>{r.whatItDoes}</td>
                <td>{whoLine(r.whoFor)}</td>
                <td>{r.cost && r.cost !== "unknown" && r.costKind !== "unknown" ? r.cost : COST_LABELS[r.costKind || "unknown"]}</td>
                <td>{r.effort || ""}</td>
                <td class="num">{formatDate(r.lastChange, { day: "numeric", month: "short", year: "numeric" })}</td>
                <td>{r.link ? <a href={r.link} rel="noopener nofollow" target="_blank" data-source-link data-work-try={r.tool}>Site ↗</a> : r.changes[0] ? <a class="muted" href={`/story/${r.changes[0].slug}`} title="The coverage names no official page">Coverage</a> : ""}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="dayhead"><h2>Every tool in full</h2></div>
      <div class="worktools">
        {rows.map((r) => (
          <section class="worktool" id={toolSlug(r)}>
            <h3>{r.tool} <span class="muted">{r.maker ? `by ${r.maker}` : ""}</span></h3>
            <p>{r.whatItDoes}</p>
            <dl class="workfacts">
              <div><dt>Who for</dt><dd>{whoLine(r.whoFor)}</dd></div>
              <div><dt>Cost</dt><dd>{r.cost && r.cost !== "unknown" && r.costKind !== "unknown" ? r.cost : COST_LABELS[r.costKind || "unknown"]}</dd></div>
              {r.effort && <div><dt>Effort</dt><dd>{r.effort}</dd></div>}
              <div><dt>Jobs</dt><dd>{r.jobs.length ? r.jobs.map((j, i) => { const job = JOBS.find((x) => x.key === j); return <>{i > 0 && ", "}{job ? <a href={`/work/${job.slug}`}>{job.label}</a> : JOB_LABELS[j] || j}</>; }) : "not classified"}</dd></div>
            </dl>
            {r.watchOut && <p class="workwatch"><b>Watch out</b> {r.watchOut}</p>}
            <p class="mono muted">
              {r.changeCount} {r.changeCount === 1 ? "change" : "changes"} covered
              {r.firstSeen && r.firstSeen !== r.lastChange && <> · first seen {formatDate(r.firstSeen, { day: "numeric", month: "short", year: "numeric" })}</>}
            </p>
            <ul class="coverage">
              {r.changes.map((c) => (
                <li>
                  <a class="t" href={`/story/${c.slug}`}>{c.headline}</a>
                  <span class="mono muted"><time datetime={c.date || undefined} data-static>{formatDate(c.date, { day: "numeric", month: "short" })}</time></span>
                </li>
              ))}
            </ul>
            {r.link && <a class="work-btn" href={r.link} rel="noopener nofollow" target="_blank" data-source-link data-work-try={r.tool}>Open {r.tool} ↗</a>}
          </section>
        ))}
      </div>
    </>
  )}
</Work>
