---
import Work from "../../layouts/Work.astro";
import WorkChips from "../../components/WorkChips.astro";
import WorkNext from "../../components/WorkNext.astro";
import { WORK_MIN_ITEMS, formatDate, meta, topicInfo } from "../../lib/data";
import {
  COST_LABELS, JOBS, JOB_LABELS, priceHistoryForKey, priceText, priceWas, toolSlug, whoLine, work, workPrices, workWeeks,
} from "../../lib/work";

const rows = work.tools;
// What each tool costs now, and what it cost before (pipeline/digest/prices.py). A row without a
// history shows the cost the coverage stated, exactly as it did before.
const history = (key: string) => priceHistoryForKey(key);
const priceNow = (key: string) => priceText(priceHistoryForKey(key)?.current);
const pricedTools = rows.filter((r) => priceNow(r.key)).length;
const intro = topicInfo["page-work-directory"]?.description || "";
const jobs = JOBS.map((j) => ({ ...j, count: rows.filter((r) => r.jobs.includes(j.key)).length })).filter((j) => j.count > 0);
const free = rows.filter((r) => ["free", "free tier", "included"].includes(r.costKind || "")).length;
const description = `${rows.length} AI tools for marketing, sales, support and running a small business, with what each one does, who it is for, what it costs and what changed last.`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "AI tools for marketing and small business",
  description,
  numberOfItems: rows.length,
  itemListElement: rows.slice(0, 100).map((r, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "SoftwareApplication",
      name: r.tool,
      applicationCategory: "BusinessApplication",
      description: r.whatItDoes,
      url: r.link || `${meta.siteUrl}/work/tools#${toolSlug(r)}`,
      ...(r.maker ? { author: { "@type": "Organization", name: r.maker } } : {}),
    },
  })),
};
---

<Work title="AI tools for marketing and small business" description={description} current="tools" jsonLd={jsonLd} thin={rows.length < WORK_MIN_ITEMS}>
  <header class="wk-head">
    <p class="wk-eyebrow">Directory · {rows.length} tools</p>
    <h1>AI tools for marketing and small business</h1>
    {intro && <p class="wk-intro">{intro}</p>}
    <p>Every tool we have covered, newest change first. Built from the news, not tested by us: check the price on the maker's page before you pay.</p>
  </header>

  {rows.length === 0 && (
    <p class="wk-empty">
      No tools recorded yet. Rows appear as the desk covers tools a small team can use.
    </p>
  )}

  {rows.length > 0 && (
    <>
      <section class="wk-sec" aria-labelledby="table-h">
        <div class="wk-h2row">
          <h2 id="table-h">At a glance</h2>
          <span class="wk-h2-side">
            {free} of {rows.length} can be started without paying
            {workPrices.changes.length > 0 && <> · <a href="/work/prices">{pricedTools} with a tracked price</a></>}
          </span>
        </div>
        {jobs.length > 0 && (
          <p class="wk-alljobs">
            By job: {jobs.map((j, i) => <>{i > 0 && " · "}<a href={`/work/${j.slug}`}>AI tools {j.task}</a> <span class="mono">{j.count} {j.count === 1 ? "tool" : "tools"}</span></>)}
          </p>
        )}
        <div class="tablewrap">
          <table class="tracker">
            <thead>
              <tr><th>Tool</th><th>Maker</th><th>What it does</th><th>Who for</th><th>Cost</th><th>Effort</th><th>Last change</th><th>Official</th></tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr>
                  <td><b><a href={`#${toolSlug(r)}`}>{r.tool}</a></b></td>
                  <td>{r.maker || ""}</td>
                  <td>{r.whatItDoes}</td>
                  <td>{whoLine(r.whoFor)}</td>
                  <td>
                    {priceNow(r.key) || (r.cost && r.cost !== "unknown" && r.costKind !== "unknown" ? r.cost : COST_LABELS[r.costKind || "unknown"])}
                    {priceWas(history(r.key)) && <span class="wk-was">{priceWas(history(r.key))}</span>}
                  </td>
                  <td>{r.effort || ""}</td>
                  <td class="num">{formatDate(r.lastChange, { day: "numeric", month: "short", year: "numeric" })}</td>
                  <td>{r.link ? <a href={r.link} rel="noopener nofollow" target="_blank" data-source-link data-work-try={r.tool}>Site ↗</a> : r.changes[0] ? <a class="muted" href={`/story/${r.changes[0].slug}`} title="The coverage names no official page">Coverage</a> : ""}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="wk-sec" aria-labelledby="full-h">
        <div class="wk-h2row"><h2 id="full-h">Every tool in full</h2></div>
        {/* One sheet per tool, each at its own anchor: the shape a per-tool page can take later. */}
        <div class="wk-sheets">
          {rows.map((r) => (
            <section class="wk-sheet" id={toolSlug(r)} aria-labelledby={`${toolSlug(r)}-h`}>
              <div class="wk-sheet-id">
                <h3 id={`${toolSlug(r)}-h`}><span class="wk-tape">{r.tool}</span></h3>
                {r.maker && <p class="wk-maker">by {r.maker}</p>}
                <p class="wk-sheet-count mono">
                  {r.changeCount} {r.changeCount === 1 ? "change" : "changes"} covered
                  {r.firstSeen && r.firstSeen !== r.lastChange && <> · first seen {formatDate(r.firstSeen, { day: "numeric", month: "short", year: "numeric" })}</>}
                </p>
                {r.link && <a class="wk-btn" href={r.link} rel="noopener nofollow" target="_blank" data-source-link data-work-try={r.tool}>Open {r.tool}<span aria-hidden="true"> ↗</span></a>}
              </div>
              <div class="wk-sheet-body">
                <p class="wk-sheet-what">{r.whatItDoes}</p>
                <WorkChips cost={r.cost} costKind={r.costKind} effort={r.effort} whoFor={r.whoFor} checkedAt={history(r.key)?.checkedAt} />
                {priceNow(r.key) && (
                  <p class="wk-price">
                    <b>Price</b> <span class="wk-price-now">{priceNow(r.key)}</span>
                    {history(r.key)?.current?.plan && <span class="wk-price-plan"> on {history(r.key)!.current.plan}</span>}
                    {history(r.key)?.current?.freeLimit && <span class="wk-price-free"> · free: {history(r.key)!.current.freeLimit}</span>}
                    {priceWas(history(r.key)) && <span class="wk-was"> · {priceWas(history(r.key))}</span>}
                    {" "}<a class="wk-thread" href="/work/prices">Price history →</a>
                  </p>
                )}
                <p class="wk-sheet-jobs">
                  <b>Jobs</b> {r.jobs.length ? r.jobs.map((j, i) => { const job = JOBS.find((x) => x.key === j); return <>{i > 0 && ", "}{job ? <a href={`/work/${job.slug}`}>{job.label}</a> : JOB_LABELS[j] || j}</>; }) : "not classified"}
                </p>
                {r.watchOut && <p class="wk-watch"><b>Watch out</b> <span>{r.watchOut}</span></p>}
                <ul class="wk-changes" role="list">
                  {r.changes.map((c) => (
                    <li>
                      <a class="wk-thread" href={`/story/${c.slug}`}>{c.headline}</a>
                      <time class="mono" datetime={c.date || undefined} data-static>{formatDate(c.date, { day: "numeric", month: "short" })}</time>
                    </li>
                  ))}
                </ul>
              </div>
            </section>
          ))}
        </div>
      </section>
    </>
  )}

  {workWeeks[0] ? (
    <WorkNext href={`/work/week/${workWeeks[0]}`} label="This week's playbook" why="What changed across these tools this week, and which ones are worth an hour now." track="playbook" />
  ) : (
    <WorkNext href="/work" label="AI at Work" why="The one thing to try this week, and everything that changed." track="hub" />
  )}
</Work>
