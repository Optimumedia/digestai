---
/* Archive pages: stories older than the export window (pipeline/digest/archive.py) keep their address
   with a small page (headline, summary, key points, sources), so indexed links never turn into 404s.
   story/[slug].astro builds the live stories; this route only builds slugs that have no live page.
   Deliberately light (no ticker, rail or full text; a few KB each) because they accumulate for years
   on a host with a 1 GB site limit. */
import Analytics from "../../components/Analytics.astro";
import "../../styles/global.css";
import { archived, stories, meta, formatDate, categories } from "../../lib/data";

export function getStaticPaths() {
  const live = new Set(stories.map((s) => s.slug));
  return archived.filter((a) => a.slug && !live.has(a.slug)).map((story) => ({ params: { archived: story.slug }, props: { story } }));
}

const { story } = Astro.props;
const site = meta.siteUrl.replace(/\/$/, "");
const url = `${site}/story/${story.slug}`;
const description = (story.summary || story.keyPoints.join(" ")).slice(0, 160);
const category = categories[story.category || ""] || story.categoryName || "AI";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: story.headline,
  description,
  image: [`${site}/og-default.png`],
  datePublished: story.firstPublishedAt,
  dateModified: story.updatedAt,
  author: { "@type": "Organization", name: "Digest AI", url: site },
  publisher: { "@type": "Organization", name: "Digest AI", url: site, logo: { "@type": "ImageObject", url: `${site}/logo-512.png` } },
  mainEntityOfPage: url,
  isBasedOn: story.sources.map((s) => s.url),
  articleSection: category,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${story.headline} — Digest AI`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="robots" content="index, follow, max-snippet:-1" />
    <meta name="theme-color" content="#0e1116" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content="Digest AI" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={story.headline} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={`${site}/og-default.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    {story.firstPublishedAt && <meta property="article:published_time" content={story.firstPublishedAt} />}
    <script is:inline>
      try { const t = JSON.parse(localStorage.getItem("theme")); if (t === "dark" || t === "light") document.documentElement.dataset.theme = t; } catch {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header class="masthead">
      <div class="wrap">
        <a class="brand" href="/" aria-label="Digest AI home">Digest<b>AI</b> <small>news desk</small></a>
      </div>
    </header>
    <main class="wrap">
      <article class="archived" style="padding-bottom: 48px">
        <header class="story-head">
          <div class="meta-row">
            <a class="chip" href={`/category/${story.category}`}>{category}</a>
            {story.firstPublishedAt && <span>{formatDate(story.firstPublishedAt)}</span>}
            <span>from the archive</span>
          </div>
          <h1>{story.headline}</h1>
          {story.summary && <p class="standfirst">{story.summary}</p>}
        </header>
        {story.keyPoints.length > 0 && (
          <section class="keypoints">
            <h2>Key points</h2>
            <ul>{story.keyPoints.map((k) => <li>{k}</li>)}</ul>
          </section>
        )}
        {story.sources.length > 0 && (
          <section style="max-width: 68ch">
            <h2 style="font-size: 20px; margin: 8px 0 10px">Sources</h2>
            <ul class="coverage">
              {story.sources.map((s) => (
                <li><a class="t" href={s.url} target="_blank" rel="noopener nofollow">{s.title}</a> <span class="mono muted">{s.source}</span></li>
              ))}
            </ul>
          </section>
        )}
        <p class="ai-note">
          This story is more than {Math.round((Date.parse(meta.generatedAt) - Date.parse(story.firstPublishedAt || meta.generatedAt)) / 864e5 / 30) || 1} months old and kept in the archive in short form. The summary and key points were generated by Digest AI's editorial model from the linked sources, which are the record.
          For today's news, see <a href="/today">the briefing</a> or the <a href={`/category/${story.category}`}>{category}</a> section.
        </p>
      </article>
    </main>
    <footer class="footer">
      <div class="wrap" style="padding: 20px 20px">
        <p class="footer-copy"><a href="/">Digest AI</a> · <a href="/about">About</a> · <a href="/about#corrections">Corrections</a> · <a href="/daily">Archive</a> · <a href="/rss.xml">RSS</a></p>
      </div>
    </footer>
    <Analytics />
  </body>
</html>
