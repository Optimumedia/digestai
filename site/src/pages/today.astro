---
import Base from "../layouts/Base.astro";
import Coverage from "../components/Coverage.astro";
import Rail from "../components/Rail.astro";
import ListenPlayer from "../components/ListenPlayer.astro";
import { briefing, briefingStories, briefingAlso, newsletters, renderMarkdown, categories, formatDate, shortDate, sourceNames, meta, episodes } from "../lib/data";

const episode = episodes.find((e) => e.date === briefing.date) || episodes[0];
const pretty = formatDate(briefing.date + "T00:00:00Z", { weekday: "long", day: "numeric", month: "long", year: "numeric" });
// /today owns the search "AI news today" (the home page's title carries the brand instead). The URL
// never changes; the title, H1 and description carry the phrase and the day.
const count = briefingStories.length;
const words = ["", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"];
const dayMonth = formatDate(briefing.date + "T00:00:00Z", { day: "numeric", month: "long" });
const title = count
  ? `AI news today: the ${words[count] || count} ${count === 1 ? "story" : "stories"} that matter, ${dayMonth}`
  : `AI news today, ${dayMonth}`;
const heads = briefingStories.map((s) => s.headline).slice(0, 3).join("; ");
const description = `AI news today, ${dayMonth}: ${briefing.stats.stories} stories from ${briefing.stats.articles} articles in a ${briefing.stats.minutes} minute read${heads ? `. ${heads}` : "."}`.slice(0, 300);
const updated = briefing.generatedAt || meta.generatedAt;
const updatedTime = new Date(updated).toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit", timeZone: "UTC" });
const archive = Object.entries(newsletters).filter(([, n]) => n.publicUrl).sort((a, b) => (a[0] < b[0] ? 1 : -1)).slice(0, 7);
const kitForm = import.meta.env.PUBLIC_KIT_FORM_URL || "";
const url = `${meta.siteUrl}/today`;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url,
    dateModified: updated,
    isPartOf: { "@type": "WebSite", name: "Digest AI", url: meta.siteUrl },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: `AI news today, ${pretty}`,
    numberOfItems: briefingStories.length + briefingAlso.length,
    itemListElement: [...briefingStories, ...briefingAlso].map((s, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "NewsArticle",
        headline: s.headline,
        url: `${meta.siteUrl}/story/${s.slug}`,
        datePublished: s.firstPublishedAt,
        dateModified: s.updatedAt,
        publisher: { "@type": "Organization", name: "Digest AI", url: meta.siteUrl },
      },
    })),
  },
];
---

<Base title={title} description={description} canonical={url} jsonLd={jsonLd}>
  <div class="grid">
    <div>
      <header class="page-head">
        <div class="eyebrow">Daily briefing · {pretty}</div>
        <h1>AI news today</h1>
        <p>
          {count > 0 ? <>The {words[count] || count} AI {count === 1 ? "story" : "stories"} that matter today, </> : <>Today's AI news, </>}
          picked from {briefing.stats.stories} stories and {briefing.stats.articles} articles; about {briefing.stats.minutes} minutes to read. Same as the email, on the web.
        </p>
        <p class="updated-line">Updated <time datetime={updated} data-static>{updatedTime} UTC</time>, {formatDate(updated, { day: "numeric", month: "long" })}</p>
      </header>

      {episode && (
        <ListenPlayer
          episode={episode}
          heading={episode.date === briefing.date ? "Listen to today's briefing" : "Listen to the latest briefing"}
          note="Every story on this page, read aloud. Also in your podcast app."
        />
      )}

      <ol class="today-list">
        {briefingStories.map((s) => {
          const { names, more } = sourceNames(s, 5);
          return (
            <li data-published={s.updatedAt}>
              <div class="meta-row">
                <a class="chip" href={`/category/${s.category}`}>{categories[s.category || ""] || "AI"}</a>
                <time datetime={s.firstPublishedAt || s.updatedAt || undefined}>{shortDate(s.firstPublishedAt || s.updatedAt)}</time>
                <span class="new-badge">new</span>
              </div>
              <h2><a href={`/story/${s.slug}`}>{s.headline}</a></h2>
              {s.keyPoints.length > 0 && <ul class="kp">{s.keyPoints.map((k) => <li>{k}</li>)}</ul>}
              <div class="article" set:html={renderMarkdown(s.summaryMd)} />
              {s.whyItMatters && <aside class="why"><b>Why it matters</b>{s.whyItMatters}</aside>}
              <div class="row-foot">
                <Coverage story={s} compact={true} />
                <div class="sources-line">{names.map((n) => <b>{n}</b>)}{more > 0 && <span>+{more}</span>}</div>
              </div>
              <a class="more-link" href={`/story/${s.slug}`}>Full story, sources and discussion →</a>
            </li>
          );
        })}
      </ol>

      {briefingAlso.length > 0 && (
        <section>
          <div class="dayhead"><h2>Also today</h2></div>
          <ul class="coverage">
            {briefingAlso.map((s) => (
              <li data-published={s.updatedAt}>
                <a class="t" href={`/story/${s.slug}`}>{s.headline}</a>
                <span class="mono muted">{categories[s.category || ""] || "AI"} · {s.articleCount} {s.articleCount === 1 ? "source" : "sources"}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="newsletter" style="margin-top: 32px">
        <h3>Get this briefing by email</h3>
        <p>Every morning at 07:00. One click to leave.</p>
        {kitForm ? (
          <form action={kitForm} method="post"><input type="email" name="email_address" placeholder="you@example.com" required aria-label="Email address" /><button type="submit">Subscribe</button></form>
        ) : (
          <p class="muted">Sign-up opens shortly. The <a href="/rss.xml">RSS feed</a> carries every story meanwhile.</p>
        )}
        {archive.length > 0 && (
          <p class="muted" style="margin-top: 10px">Past briefings: {archive.map(([d, n]) => <a href={n.publicUrl!} rel="noopener">{d}</a>).reduce((acc: any[], el, i) => (i ? [...acc, " · ", el] : [el]), [])}</p>
        )}
      </section>
    </div>
    <Rail />
  </div>
</Base>
