---
/* One item as a single line in AI at Work's lists, to scan in a second: the headline (linked to the
   story, where the whole card is), the labels (cost and time, lib/work.ts cardLabels) and a Try link
   to the maker when the card has one. Nothing else: the tool's name, what you get and the catch are
   one click away. `note` replaces the labels with a reason (the playbook's "what to leave" says what
   is in the way). */
import type { Story } from "../lib/data";
import { cardLabels, cardTitle, type WorkCard } from "../lib/work";
import WorkChips from "./WorkChips.astro";

interface Props {
  story: Story;
  card: WorkCard;
  note?: string | null;
  /** Recorded as a next_click event's detail when the line is clicked (public/app.js,
      data-work-next); the home page's lines use it, the section's own pages do not. */
  track?: string;
}
const { story, card, note, track } = Astro.props;
const { title } = cardTitle(card);
// Cost and time only on a line; the third label waits on the card.
const labels = cardLabels(card).filter((l) => l.kind !== "ease");
---

<li class:list={["wk-row", { "is-skip": Boolean(card.skip) }]} data-jobs={card.jobs.join(" ")} data-work-tool={card.tool} data-work-card>
  <a class="wk-row-what" href={`/story/${story.slug}`} data-work-next={track}>{title}<span class="sr-only"> ({card.tool})</span></a>
  {note ? <span class="wk-row-note">{note}</span> : <WorkChips labels={labels} effort={card.effort} costKind={card.costKind} compact />}
  {card.link && !note
    ? <a class="wk-row-try" href={card.link} rel="noopener nofollow" target="_blank" data-source-link data-work-try={card.tool}>Try<span aria-hidden="true"> ↗</span><span class="sr-only"> {card.tool} (opens the maker's site)</span></a>
    : <span class="wk-row-try is-empty" aria-hidden="true"></span>}
</li>
