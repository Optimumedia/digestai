---
/* One practical item in AI at Work: what you get, what it does, who it is for, what to use it for,
   how to set it up (when the article or the maker's own page says how), what it costs, how much work
   it is, and the catch. The catch is not optional — the pipeline drops a card that
   has none (pipeline/digest/work.py), so it is always here to show. */
import type { Story } from "../lib/data";
import { shortDate, sourceNames } from "../lib/data";
import { COST_LABELS, JOB_LABELS, cardTitle, stepsSourceLabel, whoLine, youGetLine, type WorkCard } from "../lib/work";

interface Props {
  story: Story;
  card: WorkCard;
  /** "h2" in a list of cards, "h3" inside a page that already has one, "p" on the story page itself. */
  level?: "h2" | "h3" | "p";
  /** The story page shows the card without a link back to itself. */
  linkStory?: boolean;
  compact?: boolean;
}
const { story, card, level = "h3", linkStory = true, compact = false } = Astro.props;
const Heading = level === "p" ? "p" : level;
const { names } = sourceNames(story, 2);
const cost = COST_LABELS[card.costKind] || COST_LABELS.unknown;
// Who cannot use it (a region, a plan), from the caveat (pipeline/digest/work.py, limits).
const limits = card.limits || [];
// The outcome headline when the pipeline wrote one, with what it does under it (lib/work.ts).
const { title, sub } = cardTitle(card);
const plan = (card.includedIn || "").trim();
// What you get in plain words, unless it only repeats the heading (lib/work.ts, youGetLine).
const get = youGetLine(card, title);
// How to set it up, only when the article or the maker's own page says how (pipeline/digest/howto.py),
// labelled with where the steps came from.
const steps = card.steps?.filter(Boolean) || [];
const stepsId = `worksteps-${story.id}`;
---

<article class:list={["workcard", { compact, "is-skip": Boolean(card.skip) }]} data-jobs={card.jobs.join(" ")} data-cost={card.costKind}>
  <div class="workcard-top">
    <span class="work-chip">{card.tool}</span>
    {card.maker && <span class="mono muted">by {card.maker}</span>}
    <time class="mono muted" datetime={story.firstPublishedAt || story.updatedAt || undefined} data-static>{shortDate(story.firstPublishedAt || story.updatedAt)}</time>
  </div>

  <Heading class="workcard-title">
    {linkStory ? <a href={`/story/${story.slug}`}>{title}</a> : title}
  </Heading>
  {get && <p class="workget"><b>What you get</b> <span>{get}</span></p>}
  {sub && <p class="workcard-what">{sub}</p>}

  <dl class="workfacts">
    <div><dt>Who for</dt><dd>{whoLine(card.whoFor)}</dd></div>
    <div><dt>Cost</dt><dd>{card.cost && card.cost !== "unknown" && card.costKind !== "unknown" ? card.cost : cost}</dd></div>
    {card.effort && <div><dt>Effort</dt><dd>{card.effort}</dd></div>}
    {plan && <div><dt>Already included in</dt><dd>{plan}</dd></div>}
  </dl>

  {card.useFor.length > 0 && !compact && (
    <>
      <p class="workcard-label">Use it for</p>
      <ul class="workuses">{card.useFor.map((u) => <li>{u}</li>)}</ul>
    </>
  )}

  {steps.length > 0 && !compact && (
    <div class="worksteps-wrap">
      <p class="workcard-label" id={stepsId}>How to set it up <span class="worksteps-src">· {stepsSourceLabel(card)}</span></p>
      <ol class="worksteps" aria-labelledby={stepsId}>{steps.map((s) => <li>{s}</li>)}</ol>
    </div>
  )}

  <p class="workwatch"><b>Watch out</b> {card.watchOut}</p>
  {limits.length > 0 && <p class="worklimits"><b>Not for everyone</b> {limits.join(" · ")}</p>}

  <div class="workcard-foot">
    {card.link && <a class="work-btn" href={card.link} rel="noopener nofollow" target="_blank" data-source-link data-work-try={card.tool}>Try it ↗</a>}
    <a class="work-link" href={`/story/${story.slug}`}>What happened{names.length > 0 && <span class="muted"> · {names.join(", ")}</span>}</a>
    {card.jobs.length > 0 && (
      <span class="worktags">{card.jobs.map((j) => <span class="worktag">{JOB_LABELS[j] || j}</span>)}</span>
    )}
    {card.skip && <span class="worktag skip">{card.skip}</span>}
  </div>
</article>
