---
/* AI at Work on the home page, right after the briefing: a band in the section's own materials
   (sage paper, label tape, cost and time chips; site/docs/work-design.md) so it reads as a
   different publication without shouting over the news.

   1. The head: the "AI at Work" wordmark, what the section is, and the way in.
   2. The week's one thing to try (lib/work.ts, homeWork): the outcome headline, the tool on its
      tape, the chips, the catch, one action ("See how" on /work, where the same card is open), and
      the prompt to copy when the card has one (else what to use it for).
   3. Two more things to try, one line each; three when there is no featured pick.
   4. Shortcuts to the job pages that have something on them.

   The page only renders this when homeWork() found something good (a featured pick, or three
   cards). Every way into the section records a next_click (public/app.js, data-work-next):
   "home-band" (the pick), "home-band-prompt" (the link under its prompt), "home-band-item" (a
   line), "home-band-job" (a job), "home-band-all" (the head's link). WorkTeaser.astro records
   "home-teaser". */
import type { HomeWork } from "../lib/work";
import { cardTitle } from "../lib/work";
import WorkChips from "./WorkChips.astro";
import WorkRow from "./WorkRow.astro";

interface Props { home: HomeWork }
const { home } = Astro.props;
const { featured, also, jobs } = home;
const card = featured?.workCard;
const head = card ? cardTitle(card) : null;
const steps = card?.steps?.filter(Boolean) || [];
const example = Boolean(card?.example?.before && card?.example?.after);
// What is waiting on /work, so "See how" says why to click.
const waiting = [
  steps.length ? `${steps.length} steps` : "",
  card?.prompt ? "a prompt to copy" : "",
  example ? "a before and after" : "",
].filter(Boolean);
const why = waiting.length > 1
  ? `${waiting.slice(0, -1).join(", ")} and ${waiting[waiting.length - 1]}`
  : waiting[0] || "What it does, what it costs and the catch";
---

<section class="wk-home work-theme wk-hband" aria-labelledby="wk-home-h">
  <div class="wk-hband-head">
    <h2 id="wk-home-h" class="wk-hband-mark">AI at <u>Work</u></h2>
    <p class="wk-hband-tag">Practical AI for marketers and small businesses: what it does, what it costs, how long it takes, and the catch.</p>
    <a class="wk-hband-all" href="/work" data-work-next="home-band-all">All of AI at Work<span aria-hidden="true"> →</span></a>
  </div>

  {featured && card && head && (
    <article class:list={["wk-hfeat", { "has-side": Boolean(card.prompt) || card.useFor.length > 0 }]} data-work-tool={card.tool} aria-labelledby="wk-hfeat-h">
      <div class="wk-hfeat-main">
        <p class="wk-hfeat-k">This week's one thing to try</p>
        <p class="wk-card-tool">
          <span class="wk-tape">{card.tool}</span>
          {card.maker && <span class="wk-maker">by {card.maker}</span>}
        </p>
        <h3 id="wk-hfeat-h" class="wk-hfeat-title"><a href="/work" data-work-next="home-band">{head.title}</a></h3>
        {head.sub && <p class="wk-card-what">{head.sub}</p>}
        <WorkChips cost={card.cost} costKind={card.costKind} effort={card.effort} includedIn={card.includedIn} />
        <p class="wk-watch"><b>Watch out</b> <span>{card.watchOut}</span></p>
        <p class="wk-hfeat-foot">
          <a class="wk-btn" href="/work" data-work-next="home-band">See how<span aria-hidden="true"> →</span></a>
          <span class="wk-hfeat-why">{why}</span>
        </p>
      </div>
      {card.prompt ? (
        <figure class="wk-hfeat-side wk-hprompt">
          <figcaption class="wk-block-h">Prompt to copy</figcaption>
          <pre><code>{card.prompt}</code></pre>
          <p class="wk-hprompt-note">{steps.length > 0 ? "Copy it, with the steps, on" : "Copy it on"}{" "}<a href="/work" data-work-next="home-band-prompt">AI at Work</a>.</p>
        </figure>
      ) : card.useFor.length > 0 && (
        <div class="wk-hfeat-side">
          <p class="wk-block-h">Use it for</p>
          <ul class="wk-check" role="list">{card.useFor.slice(0, 4).map((u) => <li>{u}</li>)}</ul>
        </div>
      )}
    </article>
  )}

  {also.length > 0 && (
    <div class="wk-halso">
      <h3 class="wk-halso-h">{featured ? "Also worth trying" : `${also.length} things to try this week`}</h3>
      <ul class="wk-rows" role="list">
        {also.map((s) => <WorkRow story={s} card={s.workCard} track="home-band-item" />)}
      </ul>
    </div>
  )}

  {jobs.length > 0 && (
    <nav class="wk-hjobs" aria-label="AI at Work by job">
      <span class="wk-hjobs-k">Find it by job</span>
      <ul role="list">
        {jobs.map(({ job, count }) => (
          <li><a href={`/work/${job.slug}`} data-work-next="home-band-job">{job.label} <span class="mono">{count}<span class="sr-only"> {count === 1 ? "item" : "items"}</span></span></a></li>
        ))}
      </ul>
    </nav>
  )}
</section>
