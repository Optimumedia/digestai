---
/* The one next step at the end of every AI at Work page: a single prominent link with the reason
   to take it, instead of a grid of related links. `track` is what a click records as the
   next_click event's detail (public/app.js, data-work-next); it defaults to the label. */
interface Props {
  href: string;
  label: string;
  why?: string;
  track?: string;
}
const { href, label, why, track } = Astro.props;
---

<nav class="wk-next" aria-label="Next">
  <a href={href} data-work-next={track || label}>
    <span class="wk-next-k">Next</span>
    <span class="wk-next-label">{label}<span class="wk-next-arrow" aria-hidden="true">→</span></span>
    {why && <span class="wk-next-why">{why}</span>}
  </a>
</nav>
