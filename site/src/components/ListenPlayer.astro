---
/* The audio briefing player: a signature element in the brand colours (accent blue play button,
   the logo's orange dot as the "on air" light). Behaviour lives in public/app.js ([data-listen]). */
import { formatDate, type Episode } from "../lib/data";

interface Props {
  episode: Episode;
  heading?: string;
  note?: string;
  variant?: "panel" | "hero";
  link?: boolean;
}

const { episode, heading = "Listen to today's briefing", note, variant = "panel", link = true } = Astro.props;
const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, "0")}`;
const today = new Date().toISOString().slice(0, 10);
const edition = episode.date === today ? "Today's edition" : `${formatDate(episode.date + "T12:00:00Z", { weekday: "short", day: "numeric", month: "short" })} edition`;
const minutes = Math.max(1, Math.round(episode.seconds / 60));
---

<div class={`listen listen-${variant}`} data-listen data-title={episode.title} data-duration={episode.seconds}>
  <button class="listen-play" type="button" aria-label="Play the audio briefing" aria-pressed="false">
    <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.6v12.8a1 1 0 0 0 1.52.85l10.4-6.4a1 1 0 0 0 0-1.7L9.52 4.75A1 1 0 0 0 8 5.6z" fill="currentColor" /></svg>
    <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6.5" y="5" width="4" height="14" rx="1.2" fill="currentColor" /><rect x="13.5" y="5" width="4" height="14" rx="1.2" fill="currentColor" /></svg>
  </button>
  <div class="listen-body">
    <div class="listen-kicker">
      <span class="listen-dot" aria-hidden="true"></span>
      <span>Audio · {edition} · {minutes} min</span>
      {link && <a class="listen-more" href="/listen">Podcast &amp; all episodes →</a>}
    </div>
    <div class="listen-title">{heading}</div>
    {note && <div class="listen-note">{note}</div>}
    <div class="listen-track">
      <span class="listen-time" data-current>0:00</span>
      <div class="listen-bar" role="slider" tabindex="0" aria-label="Position in the briefing" aria-valuemin="0" aria-valuemax={episode.seconds} aria-valuenow="0"><span class="listen-fill"></span></div>
      <span class="listen-time">{clock(episode.seconds)}</span>
      <button class="listen-speed" type="button" aria-label="Playback speed">1×</button>
    </div>
  </div>
  <audio preload="none" src={episode.url || `/audio/${episode.file}`} data-episode={episode.date}></audio>
</div>
