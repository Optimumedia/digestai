---
/* Official Digest AI profiles (and, in the footer, our own feeds) as brand-tile icon links.
   Brand glyphs: Simple Icons 16.31 (CC0), unmodified. Each tile carries data-net; global.css maps it
   to the network's official colour, revealed on hover and focus. */
interface Props {
  variant?: "footer" | "rail";
  /** Also show the owned channels (RSS feed, podcast). Defaults to on in the footer. */
  channels?: boolean;
}

const { variant = "footer", channels = variant === "footer" } = Astro.props;

const fill = (d: string) => `<path fill="currentColor" d="${d}"/>`;
const socials = [
  {
    net: "linkedin",
    name: "LinkedIn",
    handle: "digestai-news",
    href: "https://www.linkedin.com/company/digestai-news/",
    svg: fill("M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"),
  },
  {
    net: "bluesky",
    name: "Bluesky",
    handle: "@digestai.bsky.social",
    href: "https://bsky.app/profile/digestai.bsky.social",
    svg: fill("M5.202 2.857C7.954 4.922 10.913 9.11 12 11.358c1.087-2.247 4.046-6.436 6.798-8.501C20.783 1.366 24 .213 24 3.883c0 .732-.42 6.156-.667 7.037-.856 3.061-3.978 3.842-6.755 3.37 4.854.826 6.089 3.562 3.422 6.299-5.065 5.196-7.28-1.304-7.847-2.97-.104-.305-.152-.448-.153-.327 0-.121-.05.022-.153.327-.568 1.666-2.782 8.166-7.847 2.97-2.667-2.737-1.432-5.473 3.422-6.3-2.777.473-5.899-.308-6.755-3.369C.42 10.04 0 4.615 0 3.883c0-3.67 3.217-2.517 5.202-1.026"),
  },
  {
    net: "x",
    name: "X",
    handle: "@DigestAINews",
    href: "https://x.com/DigestAINews",
    svg: fill("M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z"),
  },
];
const owned = [
  {
    net: "rss",
    name: "RSS",
    label: "Digest AI RSS feed",
    href: "/rss.xml",
    svg: fill("M19.199 24C19.199 13.467 10.533 4.8 0 4.8V0c13.165 0 24 10.835 24 24h-4.801zM3.291 17.415c1.814 0 3.293 1.479 3.293 3.295 0 1.813-1.485 3.29-3.301 3.29C1.47 24 0 22.526 0 20.71s1.475-3.294 3.291-3.295zM15.909 24h-4.665c0-6.169-5.075-11.245-11.244-11.245V8.09c8.727 0 15.909 7.184 15.909 15.91z"),
  },
  {
    net: "podcast",
    name: "Podcast",
    label: "Digest AI audio briefing and podcast",
    href: "/listen",
    // Microphone head with two broadcast arcs, drawn to sit with the brand glyphs.
    svg: '<circle cx="12" cy="10" r="2.7" fill="currentColor"/><path d="M8.04 13.96a5.6 5.6 0 1 1 7.92 0M5.64 16.36a9 9 0 1 1 12.72 0" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"/><path fill="currentColor" d="M10.55 15h2.9l-.62 6.9a.83.83 0 0 1-1.66 0z"/>',
  },
];
---

<div class={`social social-${variant}`}>
  <ul class="social-list" role="list">
    {socials.map((l) => (
      <li>
        <a class="social-link" data-net={l.net} href={l.href} rel="me noopener" target="_blank" aria-label={`Digest AI on ${l.name} (opens in a new tab)`} title={`${l.name} · ${l.handle}`}>
          <svg class="social-glyph" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" set:html={l.svg} />
          {variant === "rail" && <span class="social-name">{l.name}</span>}
        </a>
      </li>
    ))}
    {channels && owned.map((l, i) => (
      <li class:list={[{ "social-sep": i === 0 }]}>
        <a class="social-link" data-net={l.net} href={l.href} aria-label={l.label} title={l.label}>
          <svg class="social-glyph" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" set:html={l.svg} />
          {variant === "rail" && <span class="social-name">{l.name}</span>}
        </a>
      </li>
    ))}
  </ul>
</div>
